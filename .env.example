# Copy to .env for local dev. Astro inlines PUBLIC_* into the client bundle
# at BUILD time, so these must be present when `npm run build` runs (in CI they
# come from repo secrets — see .github/workflows/ci.yml).

# PostHog project API key (phc_...). Public-by-design; safe in the bundle.
# When empty, src/scripts/analytics.ts early-returns and the site ships GA4
# only — no heatmaps, no session recordings.
PUBLIC_POSTHOG_KEY=

# PostHog ingestion host. Defaults to https://us.i.posthog.com when unset.
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
