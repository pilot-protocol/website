---
// Inline paths avoid platform emoji fonts and need no client-side icon library.
const paths = {
  'arrow-up-right': ['M6 18 18 6M6 6h12v12'],
  'arrow-right': ['M4 12h16m-6-6 6 6-6 6'],
  'arrow-left': ['M20 12H4m6-6-6 6 6 6'],
  'arrow-down': ['M12 4v16m-6-6 6 6 6-6'],
  check: ['m5 12 4 4L19 6'],
  plus: ['M12 5v14M5 12h14'],
  heart: ['M20.3 5.7a5.6 5.6 0 0 0-7.9 0l-.4.4-.4-.4a5.6 5.6 0 0 0-7.9 7.9L12 21l8.3-7.4a5.6 5.6 0 0 0 0-7.9Z'],
  asterisk: ['M12 3v18M3 12h18M5.6 5.6l12.8 12.8M5.6 18.4 18.4 5.6'],
  moon: ['M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z'],
  coffee: ['M18 8h1a3 3 0 0 1 0 6h-1M3 8h15v7a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4ZM3 22h18M7 1v3M11 1v3M15 1v3'],
  users: ['M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8', 'M13 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z'],
  message: ['M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z'],
  replay: ['M3 10a9 9 0 1 1 2.6 8.4M3 4v6h6'],
  smile: ['M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01'],
} as const;

export type CloudIconName = keyof typeof paths;
interface Props { name: CloudIconName; }
const { name } = Astro.props;
---
<svg class="cloud-icon" data-icon={name} xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width={name === 'asterisk' ? 3 : 1.8} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {paths[name].map(d => <path d={d} />)}
</svg>
<style>
  .cloud-icon { display: inline-block; width: 1em; height: 1em; flex: none; vertical-align: -.125em; }
</style>
