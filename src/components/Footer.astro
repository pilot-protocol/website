---
// Full site footer - large display text + 4-column nav + fine print

// Social links — add new entries here to extend the row.
const socials = [
  {
    name: 'X',
    href: 'https://x.com/pilotprotocol_',
    icon: '<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>',
  },
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/company/112569955/',
    icon: '<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>',
  },
];
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot-big">
      The internet<br/>
      for <span class="a">agents.</span>
    </div>
    <div class="foot-cta">
      <a href="/docs/getting-started" class="btn primary">Install Pilot <span class="arr">→</span></a>
      <a href="/docs/research" class="btn">Read the spec</a>
    </div>

    <div class="foot-grid">
      <div class="foot-about">
        <div class="foot-brand">
          <img src="/img/pilot.png" alt="" class="foot-logo" width="28" height="28" />
          <h4>Pilot / Protocol</h4>
        </div>
        <p>Pilot. Where agents go.</p>
        <div class="foot-social">
          {socials.map((s) => (
            <a href={s.href} class="foot-social-link" target="_blank" rel="noopener"
               aria-label={`Pilot Protocol on ${s.name}`}
               data-track="social_click" data-track-target={s.name.toLowerCase()}>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" set:html={s.icon}></svg>
            </a>
          ))}
        </div>
      </div>
      <div>
        <h4>Protocol</h4>
        <a href="/blog/ietf-internet-draft-pilot-protocol">Spec (IETF draft)</a>
        <a href="https://github.com/pilot-protocol/pilotprotocol">GitHub</a>
        <a href="/docs/">Documentation</a>
        <a href="/docs/research">Research</a>
      </div>
      <div>
        <h4>Network</h4>
        <a href="/docs/networks">Backbone</a>
        <a href="/docs/service-agents">Service agents</a>
        <a href="/app-store">App Store</a>
      </div>
      <div>
        <h4>Company</h4>
        <a href="/plans">Plans</a>
        <a href="/blog/">Blog</a>
        <a href="mailto:founders@pilotprotocol.network">Contact</a>
      </div>
      <div>
        <h4>Legal</h4>
        <a href="/privacy">Privacy Policy</a>
        <a href="/cookies">Cookie Policy</a>
        <a href="/terms">Terms of Service</a>
        <a href="/aup">Acceptable Use</a>
        <a href="/publisher-agreement">Publisher Agreement</a>
        <a href="javascript:void(0)" id="cookie-preferences-link">Cookie Preferences</a>
        <a href="/press">Press Kit</a>
      </div>
    </div>

    <a class="foot-plain-band" href="/plain/" aria-label="Plain-text variant for AI agents">
      <span class="fp-label">Plain text for agents</span>
      <span class="fp-path">/plain</span>
      <span class="fp-arrow">→</span>
    </a>

    <div class="foot-bottom">
      <div>© {new Date().getFullYear()} Pilot Protocol · Built for agents</div>
      <div class="foot-bottom-right">
        <span class="foot-status">pilot://0x00000000 · backbone · up</span>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var link = document.getElementById('cookie-preferences-link');
    if (link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        if (typeof window.__showConsentBanner === 'function') {
          window.__showConsentBanner();
        }
      });
    }
  });
</script>

<style>
  .site-footer {
    padding: 80px 0 40px;
    border-top: 1px solid var(--line);
    background: var(--bg-deep);
  }

  .foot-big {
    font-family: var(--sans);
    font-size: clamp(48px, 10vw, 180px);
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-weight: 500;
    margin: 0 0 24px;
    color: var(--ink);
  }
  .foot-big .a { color: var(--accent); }

  .foot-sub {
    color: var(--ink-dim);
    font-size: 14px;
    max-width: 40ch;
    line-height: 1.5;
    margin: 0 0 28px;
  }

  .foot-cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 48px;
  }

  .foot-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 64px;
  }

  .foot-grid h4 {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-dim);
    margin: 0 0 16px;
    font-weight: 500;
  }
  .foot-grid a {
    display: block;
    padding: 6px 0;
    color: var(--ink);
    font-size: 15px;
  }
  .foot-grid a:hover { color: var(--accent); }
  .foot-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }
  .foot-brand .foot-logo {
    width: 28px;
    height: 28px;
    display: block;
    object-fit: contain;
  }
  .foot-brand h4 { margin: 0; }

  .foot-about p {
    color: var(--ink-dim);
    font-size: 14px;
    line-height: 1.55;
    max-width: 34ch;
  }
  .foot-about > h4 { margin: 0 0 16px; }

  .foot-social {
    display: flex;
    gap: 12px;
    margin-top: 20px;
  }
  /* Scoped under .foot-social so these outrank the broad `.foot-grid a` rule
     (which otherwise forces display:block + padding and breaks centering). */
  .foot-social .foot-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 12px;
    color: var(--ink-dim);
    transition: color 0.15s, border-color 0.15s, transform 0.15s;
  }
  .foot-social .foot-social-link svg {
    display: block;
    width: 24px;
    height: 24px;
  }
  .foot-social .foot-social-link:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .foot-plain-band {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 28px 0;
    margin-top: 24px;
    margin-bottom: 24px;
    border-top: 1px dashed var(--line);
    border-bottom: 1px dashed var(--line);
    text-decoration: none;
    color: var(--ink-dim);
    font-family: var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    transition: color 0.15s, border-color 0.15s;
  }
  .foot-plain-band .fp-label { font-size: 14px; color: var(--ink); font-weight: 500; }
  .foot-plain-band .fp-path { font-size: 12px; }
  .foot-plain-band .fp-arrow { margin-left: auto; font-size: 18px; color: var(--accent); transition: transform 0.15s; }
  .foot-plain-band:hover { color: var(--ink); border-color: var(--accent); }
  .foot-plain-band:hover .fp-arrow { transform: translateX(4px); }

  .foot-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 32px;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-dim);
    flex-wrap: wrap;
    gap: 16px;
  }
  .foot-status {
    color: var(--ink-dim);
    text-decoration: none;
    transition: color 0.15s;
  }
  .foot-status:hover { color: var(--accent); }
  .foot-bottom-right {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }
  .foot-plain {
    color: var(--ink-dim);
    text-decoration: none;
    transition: color 0.15s;
  }
  .foot-plain:hover { color: var(--accent); }

  @media (max-width: 1080px) {
    .foot-grid { grid-template-columns: 1fr 1fr 1fr; gap: 32px; }
  }
  @media (max-width: 700px) {
    .foot-grid { grid-template-columns: 1fr 1fr; gap: 24px; }
  }
  @media (max-width: 480px) {
    .foot-grid { grid-template-columns: 1fr 1fr; gap: 24px; }
    .site-footer { padding: 56px 0 32px; }
  }
</style>
