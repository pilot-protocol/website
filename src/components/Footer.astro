---
// Full site footer - large display text + 4-column nav + fine print

import { solutionGroups } from '../data/solutions';

const enterpriseLinks = [
  { href: '/enterprise/autonomous-ai-agents', label: 'Autonomous agent control' },
  { href: '/enterprise/claude-code-management', label: 'Claude Code management' },
];

// Social links — add new entries here to extend the row.
const socials = [
  {
    name: 'X',
    href: 'https://x.com/pilotprotocol_',
    icon: '<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>',
  },
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/company/112569955/',
    icon: '<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>',
  },
];
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot-big">
      The internet<br/>
      for <span class="a">agents.</span>
    </div>
    <div class="foot-cta">
      <a href="/docs/getting-started" class="btn primary">Get started <span class="arr">→</span></a>
      <a href="/contact" class="btn">Contact sales</a>
    </div>

    <div class="foot-grid">
      <div class="foot-about">
        <div class="foot-brand">
          <img src="/img/pilot-48.webp" alt="" class="foot-logo" width="28" height="28" loading="lazy" decoding="async" />
          <p class="foot-heading">Pilot Protocol</p>
        </div>
        <p>Pilot. Where agents go.</p>
        <div class="foot-social">
          {socials.map((s) => (
            <a href={s.href} class="foot-social-link" target="_blank" rel="noopener"
               aria-label={`Pilot Protocol on ${s.name}`}
               data-track="social_click" data-track-target={s.name.toLowerCase()}>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" set:html={s.icon}></svg>
            </a>
          ))}
        </div>
      </div>
      <div>
        <p class="foot-heading">Product</p>
        <a href="/learn/what-is-pilot-protocol">Network OS</a>
        <a href="/trust">Trust Center</a>
        <a href="/governance">Governance</a>
        <a href="/app-store">App Store</a>
        <a href="/plans">Plans</a>
        <a href="/docs/enterprise">Enterprise controls</a>
      </div>
      <div>
        <p class="foot-heading">Developers</p>
        <a href="/docs/">Documentation</a>
        <a href="/docs/getting-started">Quickstart</a>
        <a href="/docs/integration">SDKs &amp; integration</a>
        <a href="/research/WHITEPAPER.pdf">Wire specification</a>
        <a href="/pilot-native-use-cases.pdf">Use-case brochure</a>
        <a href="https://github.com/pilot-protocol/pilotprotocol">GitHub</a>
        <a href="/docs/research">Research</a>
      </div>
      <div>
        <p class="foot-heading">Company</p>
        <a href="/about">About</a>
        <a href="/learn/">Learning center</a>
        <a href="/roadmap">Roadmap</a>
        <a href="/news/">Company news</a>
        <a href="/blog/">Blog</a>
        <a href="/press">Press</a>
        <a href="/enterprise-readiness-report.pdf">Readiness report</a>
        <a href="/contact">Contact</a>
      </div>
      <div>
        <p class="foot-heading">Legal</p>
        <a href="/privacy">Privacy Policy</a>
        <a href="/cookies">Cookie Policy</a>
        <a href="/terms">Terms of Service</a>
        <a href="/aup">Acceptable Use</a>
        <a href="/publisher-agreement">Publisher Agreement</a>
        <a href="/security/disclosure">Security disclosure</a>
        <button type="button" id="cookie-preferences-link">Cookie Preferences</button>
      </div>
    </div>

    <a class="foot-plain-band" href="/plain/">
      <span class="fp-label">Plain text for agents</span>
      <span class="fp-path">/plain</span>
      <span class="fp-arrow">→</span>
    </a>

    <div class="foot-bottom">
      <div>© {new Date().getFullYear()} Pilot Protocol · Built for agents</div>
      <div class="foot-bottom-right">
        <span class="foot-status">pilot://0x00000000 · backbone · up</span>
      </div>
    </div>

    <nav class="foot-solutions" aria-label="Explore Pilot solutions">
      <div class="foot-solutions-intro">
        <span>Explore Pilot</span>
        <span>Capabilities by workflow</span>
      </div>
      <div class="foot-solutions-grid">
        {solutionGroups.map((group) => (
          <div class="foot-solutions-group">
            <p>{group.name}</p>
            <div>
              {group.solutions.map((solution) => (
                <a
                  href={`/solutions/${solution.slug}`}
                  data-track="footer_solution_click"
                  data-track-target={solution.slug}
                  data-track-location="footer_directory"
                >{solution.footerLabel}</a>
              ))}
            </div>
          </div>
        ))}
        <div class="foot-solutions-group">
          <p>Enterprise</p>
          <div>
            {enterpriseLinks.map((link) => (
              <a
                href={link.href}
                data-track="footer_enterprise_click"
                data-track-target={link.href.split('/').at(-1)}
                data-track-location="footer_directory"
              >{link.label}</a>
            ))}
          </div>
        </div>
      </div>
    </nav>
  </div>
</footer>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var link = document.getElementById('cookie-preferences-link');
    if (link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        if (typeof window.__showConsentBanner === 'function') {
          window.__showConsentBanner();
        }
      });
    }
  });
</script>

<style>
  .site-footer {
    padding: 80px 0 40px;
    border-top: 1px solid var(--line);
    background: var(--bg-deep);
  }

  .foot-big {
    font-family: var(--sans);
    font-size: clamp(48px, 10vw, 180px);
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-weight: 500;
    margin: 0 0 24px;
    color: var(--ink);
  }
  .foot-big .a { color: var(--accent-text); }

  .foot-sub {
    color: var(--ink-dim);
    font-size: 14px;
    max-width: 40ch;
    line-height: 1.5;
    margin: 0 0 28px;
  }

  .foot-cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 48px;
  }

  .foot-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 64px;
  }

  .foot-grid .foot-heading {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-dim);
    margin: 0 0 16px;
    font-weight: 500;
  }
  .foot-grid a,
  .foot-grid button {
    display: block;
    width: 100%;
    padding: 6px 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font-family: inherit;
    font-size: 15px;
    line-height: inherit;
    text-align: left;
    cursor: pointer;
  }
  .foot-grid a:hover,
  .foot-grid button:hover { color: var(--accent-text); }
  .foot-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }
  .foot-brand .foot-logo {
    width: 28px;
    height: 28px;
    display: block;
    object-fit: contain;
  }
  .foot-brand .foot-heading { margin: 0; }

  .foot-about p {
    color: var(--ink-dim);
    font-size: 14px;
    line-height: 1.55;
    max-width: 34ch;
  }
  .foot-about > .foot-heading { margin: 0 0 16px; }

  .foot-social {
    display: flex;
    gap: 12px;
    margin-top: 20px;
  }
  /* Scoped under .foot-social so these outrank the broad `.foot-grid a` rule
     (which otherwise forces display:block + padding and breaks centering). */
  .foot-social .foot-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 12px;
    color: var(--ink-dim);
    transition: color 0.15s, border-color 0.15s, transform 0.15s;
  }
  .foot-social .foot-social-link svg {
    display: block;
    width: 24px;
    height: 24px;
  }
  .foot-social .foot-social-link:hover {
    color: var(--accent-text);
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .foot-plain-band {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 28px 0;
    margin-top: 24px;
    margin-bottom: 24px;
    border-top: 1px dashed var(--line);
    border-bottom: 1px dashed var(--line);
    text-decoration: none;
    color: var(--ink-dim);
    font-family: var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    transition: color 0.15s, border-color 0.15s;
  }
  .foot-plain-band .fp-label { font-size: 14px; color: var(--ink); font-weight: 500; }
  .foot-plain-band .fp-path { font-size: 12px; }
  .foot-plain-band .fp-arrow { margin-left: auto; font-size: 18px; color: var(--accent-text); transition: transform 0.15s; }
  .foot-plain-band:hover { color: var(--ink); border-color: var(--accent); }
  .foot-plain-band:hover .fp-arrow { transform: translateX(4px); }

  .foot-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 32px;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-dim);
    flex-wrap: wrap;
    gap: 16px;
  }
  .foot-status {
    color: var(--ink-dim);
    text-decoration: none;
    transition: color 0.15s;
  }
  .foot-status:hover { color: var(--accent-text); }
  .foot-bottom-right {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }

  /* A dense, low-emphasis capability directory at the absolute bottom of the
     footer. It follows the large-company footer pattern without competing with
     the primary navigation or the main footer calls to action. */
  .foot-solutions {
    margin-top: 34px;
    padding-top: 24px;
    border-top: 1px solid color-mix(in srgb, var(--line) 72%, transparent);
  }
  .foot-solutions-intro {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
    color: var(--ink-dim);
    font-family: var(--mono);
    font-size: 9px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .foot-solutions-intro span:last-child { opacity: .85; }
  .foot-solutions-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
  }
  .foot-solutions-group p {
    margin: 0 0 9px;
    color: var(--ink-dim);
    font-family: var(--mono);
    font-size: 9px;
    line-height: 1.2;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .foot-solutions-group > div {
    display: flex;
    flex-wrap: wrap;
    gap: 3px 0;
  }
  .foot-solutions-group a {
    display: inline-flex;
    align-items: center;
    color: var(--ink-dim);
    font-size: 11px;
    line-height: 1.45;
    text-decoration: none;
    transition: color .15s ease;
  }
  .foot-solutions-group a:not(:last-child)::after {
    content: '·';
    margin: 0 8px;
    color: color-mix(in srgb, var(--ink-faint) 68%, transparent);
  }
  .foot-solutions-group a:hover { color: var(--ink); }
  .foot-plain {
    color: var(--ink-dim);
    text-decoration: none;
    transition: color 0.15s;
  }
  .foot-plain:hover { color: var(--accent-text); }

  @media (max-width: 1080px) {
    .foot-grid { grid-template-columns: 1fr 1fr 1fr; gap: 32px; }
  }
  @media (max-width: 700px) {
    .foot-grid { grid-template-columns: 1fr 1fr; gap: 24px; }
    .foot-solutions-grid { grid-template-columns: 1fr 1fr; gap: 22px 28px; }
  }
  @media (max-width: 480px) {
    .foot-grid { grid-template-columns: 1fr 1fr; gap: 24px; }
    .site-footer { padding: 56px 0 32px; }
    .foot-solutions-intro span:last-child { display: none; }
    .foot-solutions-grid { grid-template-columns: 1fr; gap: 18px; }
    .foot-solutions-group > div {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 14px;
    }
    .foot-solutions-group a {
      min-height: 30px;
      padding: 6px 0;
      font-size: 10.5px;
      line-height: 1.65;
    }
    .foot-solutions-group a:not(:last-child)::after { display: none; }
  }
</style>
