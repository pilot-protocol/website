---
import type { SolutionProfile } from '../data/solutions';

interface Props { solution: SolutionProfile }
const { solution } = Astro.props;
---

<section class="solution-proof-section" aria-labelledby={`${solution.slug}-proof-title`}>
  <div class="wrap">
    <div class="solution-proof-head">
      <div>
        <div class="eyebrow">Technical basis</div>
        <h2 id={`${solution.slug}-proof-title`}>Specific product surfaces.<br/><em>Inspectable in the docs.</em></h2>
      </div>
      <div class="solution-proof-meta">
        <span>Product review</span>
        <strong>Pilot release 1.13.9</strong>
        <time datetime="2026-08-05">Reviewed 5 August 2026</time>
        <a href="/docs/" data-track="solution_cta_click" data-track-target={`${solution.slug}:documentation`}>Inspect documentation <span>→</span></a>
      </div>
    </div>
    <ul class="solution-proof-list">
      {solution.proof.map((item, index) => (
        <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{item}</strong></li>
      ))}
    </ul>
  </div>
</section>
