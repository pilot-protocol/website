---
import type { App } from '../data/apps';
interface Props { app: App; size?: 56 | 64 | 88 | 120; }
const { app, size = 64 } = Astro.props;
const isImg = app.icon.mode === 'image';
const pad = isImg && app.icon.fit === 'contain';
const mask = app.icon.file ? `-webkit-mask-image:url(${app.icon.file});mask-image:url(${app.icon.file})` : '';
---
<div class={`app-icon sz-${size}${isImg ? ' is-image' : ''}${pad ? ' pad' : ''}`} style={`--c:${app.icon.color}`} data-ink={app.icon.ink} data-app={app.id} aria-hidden="true">
  {isImg
    ? <img class="logo-img" src={app.icon.img} alt="" loading="lazy" style={`object-fit:${app.icon.fit};object-position:${app.icon.pos}`} />
    : <span class="logo" style={mask}></span>}
</div>
