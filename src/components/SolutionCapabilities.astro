---
import type { SolutionProfile } from '../data/solutions';
import type { SolutionStory } from '../data/solutionStories';

interface Props { solution: SolutionProfile; story: SolutionStory }
const { solution, story } = Astro.props;
---

<section class="solution-section solution-capability-section" aria-labelledby={`${solution.slug}-capabilities-title`}>
  <div class="wrap">
    <div class="solution-section-head">
      <div class="eyebrow">What Pilot contributes</div>
      <h2 id={`${solution.slug}-capabilities-title`}>{story.capabilityHeading.lead}<br/><em>{story.capabilityHeading.emphasis}</em></h2>
    </div>
    <div class="solution-capabilities">
      {solution.capabilities.map((capability, index) => (
        <article>
          <div class="solution-card-top">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <span>{capability.label}</span>
          </div>
          <h3>{capability.title}</h3>
          <p>{capability.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
