---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: string;
}

const {
  title,
  description,
  canonicalUrl,
  ogImage = 'https://pilotprotocol.network/img/pilot.png',
  ogType = 'website',
} = Astro.props;
---
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="robots" content="index,follow">
{canonicalUrl && <link rel="canonical" href={canonicalUrl}>}
<meta property="og:type" content={ogType}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
{canonicalUrl && <meta property="og:url" content={canonicalUrl}>}
<meta property="og:image" content={ogImage}>
<meta property="og:site_name" content="Pilot Protocol">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
<meta name="theme-color" content="#0b0b0a" media="(prefers-color-scheme: dark)">
<meta name="theme-color" content="#fafaf7" media="(prefers-color-scheme: light)">

<!-- PILOT-175: fonts self-hosted under /fonts/*. Removed the Google Fonts
     preconnect + stylesheet links so the browser never contacts
     fonts.googleapis.com / fonts.gstatic.com (GDPR: avoids passing
     visitor IPs to Google). The self-hosted bundle covers the same
     three families (Inter Tight, JetBrains Mono, Instrument Serif)
     with identical subsets + unicode-range gating, so per-page font
     bytes are unchanged. -->
<link rel="stylesheet" href="/fonts/fonts.css">

<link rel="icon" href="/img/pilot.png" type="image/png">
<link rel="alternate" type="application/rss+xml" title="Pilot Protocol Journal" href="/blog/feed.xml">

<script is:inline>
  (function () {
    try {
      var stored = localStorage.getItem('pilot-theme');
      var prefers = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      var theme = stored || prefers;
      if (theme === 'light') document.documentElement.setAttribute('data-theme', 'light');
    } catch (e) {}
  })();
</script>

<script async src="https://www.googletagmanager.com/gtag/js?id=G-EEWEKT0GW5"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-EEWEKT0GW5');
</script>
<script>
  import '../scripts/analytics.ts';
</script>
