---
import { docsNav } from '../data/docsNav';

interface Props {
  activePage: string;
}

const { activePage } = Astro.props;
---
<aside class="sidebar" id="docs-sidebar" aria-label="Documentation">
  <div class="sidebar-head">
    <span>Documentation</span>
    <button class="sidebar-close" id="docs-sidebar-close" type="button" aria-label="Close documentation menu">×</button>
  </div>
  {docsNav.map((item) => (
    <>
      {item.section && <div class="nav-section">{item.section}</div>}
      <a class={activePage === item.slug ? 'active' : ''} href={item.href} aria-current={activePage === item.slug ? 'page' : undefined}>
        {item.icon && <Fragment set:html={item.icon.replace('<svg', '<svg class="nav-icon"')} />}
        {item.label}
      </a>
    </>
  ))}
</aside>
