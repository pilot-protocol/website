---
interface Props {
  active?: 'home' | 'docs' | 'blog' | 'plans' | 'for' | 'tech' | 'apps' | 'trust';
}
const { active } = Astro.props;

const navGroups = [
  {
    id: 'product', label: 'Product', eyebrow: 'The platform',
    title: 'One network layer for agents.',
    desc: 'Identity, encrypted connectivity, trust, and installable capabilities in one system.',
    activeFor: ['home', 'apps', 'trust', 'plans'],
    links: [
      { href: '/', kicker: 'Platform', label: 'Network OS', desc: 'The complete Pilot architecture' },
      { href: '/trust', kicker: 'Security', label: 'Trust Center', desc: 'Controls, boundaries, and evidence' },
      { href: '/app-store', kicker: 'Ecosystem', label: 'App Store', desc: 'Capabilities built for agents' },
      { href: '/plans', kicker: 'Commercial', label: 'Plans', desc: 'Open network and enterprise paths' },
    ],
    footer: { href: '/docs/getting-started', label: 'Explore the product' },
  },
  {
    id: 'solutions', label: 'Solutions', eyebrow: 'Built for real systems',
    title: 'Connect agents across every boundary.',
    desc: 'Start with one deployment pattern, then expand without replacing the underlying network.',
    activeFor: ['for'],
    links: [
      { href: '/for/p2p', kicker: 'Connectivity', label: 'Direct P2P', desc: 'Private agent-to-agent paths' },
      { href: '/for/mcp', kicker: 'Integration', label: 'MCP + Pilot', desc: 'Give MCP servers a network' },
      { href: '/for/networks', kicker: 'Organization', label: 'Managed networks', desc: 'Shared domains and membership' },
      { href: '/docs/enterprise', kicker: 'Enterprise', label: 'Enterprise controls', desc: 'Identity, policy, roles, and audit' },
    ],
    footer: { href: '/for/setups', label: 'Browse deployment setups' },
  },
  {
    id: 'developers', label: 'Developers', eyebrow: 'Build on Pilot',
    title: 'From first connection to production.',
    desc: 'Documentation and tooling for connecting, shipping, and operating agent-native software.',
    activeFor: ['docs', 'tech'],
    links: [
      { href: '/docs/getting-started', kicker: 'Start', label: 'Quickstart', desc: 'Install and connect in minutes' },
      { href: '/docs/', kicker: 'Reference', label: 'Documentation', desc: 'Concepts, CLI, SDKs, and operations' },
      { href: '/docs/integration', kicker: 'Build', label: 'SDKs & integration', desc: 'Embed Pilot in your stack' },
      { href: '/for/compatibility', kicker: 'Deploy', label: 'Compatibility', desc: 'Choose the right environment mode' },
    ],
    footer: { href: '/for/skills', label: 'Explore agent skills' },
  },
  {
    id: 'resources', label: 'Resources', eyebrow: 'Learn and evaluate',
    title: 'Technical depth without the guesswork.',
    desc: 'Architecture, field notes, evaluator material, and a machine-readable version of the site.',
    activeFor: ['blog'],
    links: [
      { href: '/blog/', kicker: 'Journal', label: 'Field notes', desc: 'Guides, launches, and architecture' },
      { href: '/docs/research', kicker: 'Research', label: 'Technical papers', desc: 'Specifications and evaluations' },
      { href: '/press', kicker: 'Media', label: 'Press kit', desc: 'Company and brand resources' },
      { href: '/plain/', kicker: 'Agents', label: 'Machine-readable site', desc: 'The plain-text agent interface' },
    ],
    footer: { href: '/enterprise-readiness-report.pdf', label: 'Read the readiness report' },
  },
  {
    id: 'company', label: 'Company', eyebrow: 'Pilot Protocol',
    title: 'Building the network for agents.',
    desc: 'Learn about the company, follow our progress, or speak directly with the team.',
    activeFor: [],
    links: [
      { href: '/learn/what-is-pilot-protocol', kicker: 'About', label: 'About Pilot', desc: 'What we are building and why' },
      { href: '/blog/pilot-raises-4-5m-seed', kicker: 'News', label: 'Company news', desc: 'Latest company announcement' },
      { href: '/press', kicker: 'Press', label: 'Media resources', desc: 'Brand assets and company facts' },
      { href: 'mailto:founders@pilotprotocol.network', kicker: 'Contact', label: 'Talk to the team', desc: 'Reach the founders directly' },
    ],
    footer: { href: 'mailto:founders@pilotprotocol.network', label: 'Contact Pilot Protocol' },
  },
];
---
<a class="skip-link" href="#page-content">Skip to content</a>
<nav class="nav-top" aria-label="Primary">
  <div class="wrap">
    <div class="nav-row">
      <a href="/" class="brand" aria-label="Pilot Protocol - home"
         data-track="nav_click" data-track-target="home">
        <span class="brand-mark"><img src="/img/pilot-96.png" alt="" class="logo" width="40" height="40" /></span>
        <span class="brand-text"><strong>Pilot</strong><span>Protocol</span></span>
      </a>

      <div class="nav-links" id="nav-links">
        {navGroups.map((group) => (
          <div class:list={['nav-dropdown', group.activeFor.includes(active || '') && 'active']} data-nav-group={group.id}>
            <button type="button" class="nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false">
              <span class="nav-trigger-label">{group.label}</span>
              <svg class="caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="nav-dropdown-menu">
              <div class="nav-menu-intro">
                <span class="nav-menu-eyebrow">{group.eyebrow}</span>
                <strong>{group.title}</strong>
                <p>{group.desc}</p>
              </div>
              <div class="nav-menu-links">
                {group.links.map((l) => (
                  <a href={l.href} data-track="nav_click" data-track-target={`${group.id}-${l.label.toLowerCase().replaceAll(' ', '-')}`}>
                    <span class="dd-kicker">{l.kicker}</span>
                    <span class="dd-label">{l.label}</span>
                    <span class="dd-desc">{l.desc}</span>
                    <span class="dd-arrow" aria-hidden="true">↗</span>
                  </a>
                ))}
              </div>
              <a class="nav-menu-footer" href={group.footer.href}>
                <span>{group.footer.label}</span><span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        ))}

        <div class="nav-mobile-actions">
          <a class="nav-sales" href="mailto:founders@pilotprotocol.network">Contact sales</a>
          <a class="nav-cta" href="/docs/getting-started">Get started</a>
        </div>
      </div>

      <div class="nav-right">
        <a class="nav-sales" href="mailto:founders@pilotprotocol.network">Contact sales</a>
        <a class="nav-cta" href="/docs/getting-started">Get started</a>
        <button id="theme-toggle" class="theme-toggle" aria-label="Toggle light/dark theme" type="button">
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4.2"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
          </svg>
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
          </svg>
        </button>
        <button id="nav-hamburger" class="nav-hamburger" aria-label="Toggle menu" aria-expanded="false" type="button">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </div>
</nav>
<span id="page-content" class="skip-target" tabindex="-1"></span>

<script is:inline>
  (function () {
    var nav = document.querySelector('.nav-top');
    var themeBtn = document.getElementById('theme-toggle');
    if (themeBtn) {
      themeBtn.addEventListener('click', function () {
        var isLight = document.documentElement.getAttribute('data-theme') === 'light';
        if (isLight) {
          document.documentElement.removeAttribute('data-theme');
          try { localStorage.setItem('pilot-theme', 'dark'); } catch (e) {}
        } else {
          document.documentElement.setAttribute('data-theme', 'light');
          try { localStorage.setItem('pilot-theme', 'light'); } catch (e) {}
        }
      });
    }

    function closeDropdowns(except) {
      document.querySelectorAll('.nav-dropdown.open').forEach(function (dd) {
        if (dd === except) return;
        dd.classList.remove('open');
        var trigger = dd.querySelector('.nav-dropdown-trigger');
        if (trigger) trigger.setAttribute('aria-expanded', 'false');
      });
    }

    function closeMobileMenu() {
      if (!links || !links.classList.contains('mobile-open')) return;
      links.classList.remove('mobile-open');
      if (hamb) {
        hamb.classList.remove('is-open');
        hamb.setAttribute('aria-expanded', 'false');
        hamb.setAttribute('aria-label', 'Open menu');
      }
      document.body.classList.remove('nav-mobile-open');
      closeDropdowns();
    }

    // Hamburger (mobile)
    var hamb = document.getElementById('nav-hamburger');
    var links = document.getElementById('nav-links');
    if (hamb && links) {
      hamb.setAttribute('aria-label', 'Open menu');
      hamb.addEventListener('click', function () {
        var open = links.classList.toggle('mobile-open');
        hamb.classList.toggle('is-open', open);
        hamb.setAttribute('aria-expanded', open ? 'true' : 'false');
        hamb.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        document.body.classList.toggle('nav-mobile-open', open);
        if (!open) closeDropdowns();
      });
      links.querySelectorAll('a').forEach(function (link) {
        link.addEventListener('click', closeMobileMenu);
      });
    }

    // Dropdown: click to toggle, click-outside to close
    document.querySelectorAll('.nav-dropdown').forEach(function (dd) {
      var trigger = dd.querySelector('.nav-dropdown-trigger');
      if (!trigger) return;
      trigger.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var wasOpen = dd.classList.contains('open');
        closeDropdowns(dd);
        dd.classList.toggle('open', !wasOpen);
        var isOpen = !wasOpen;
        trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });
    });
    document.addEventListener('click', function (e) {
      if (!e.target.closest || !e.target.closest('.nav-dropdown')) closeDropdowns();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        document.querySelectorAll('.nav-dropdown.open').forEach(function (dd) {
          dd.classList.remove('open');
          var trig = dd.querySelector('.nav-dropdown-trigger');
          if (trig) { trig.setAttribute('aria-expanded', 'false'); trig.focus(); }
        });
        closeMobileMenu();
      }
    });

    // A restrained shadow gives the persistent shell a clear edge once content scrolls beneath it.
    if (nav) {
      var syncNavEdge = function () { nav.classList.toggle('is-scrolled', window.scrollY > 8); };
      syncNavEdge();
      window.addEventListener('scroll', syncNavEdge, { passive: true });
    }
  })();
</script>
