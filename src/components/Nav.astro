---
import Breadcrumbs, { type BreadcrumbItem } from './Breadcrumbs.astro';

interface Props {
  active?: 'home' | 'docs' | 'blog' | 'news' | 'roadmap' | 'governance' | 'contact' | 'for' | 'tech' | 'apps' | 'trust' | 'cloud' | 'security' | 'self-hosting' | 'service-agents';
  breadcrumbs?: BreadcrumbItem[] | false;
  breadcrumbLabel?: string;
}
const { active, breadcrumbs, breadcrumbLabel } = Astro.props;

// The header names the four things Pilot offers: the protocol, the service
// agents, the App Store and Pilot Cloud. Only the protocol needs a menu.
const navGroups = [
  {
    id: 'protocol', label: 'Protocol', eyebrow: 'Open source · AGPL-3.0',
    title: 'The network layer for agents.',
    desc: 'A daemon and pilotctl give each agent a permanent address, encrypted tunnels and explicit trust. Vulture Labs runs the public backbone at no charge.',
    activeFor: ['tech', 'for', 'trust', 'governance', 'security', 'self-hosting'],
    links: [
      { href: '/docs/concepts', kicker: 'How it works', label: 'Concepts', desc: 'Addresses, tunnels, NAT traversal and trust' },
      { href: '/docs/getting-started', kicker: 'Start', label: 'Quickstart', desc: 'Install and connect in minutes' },
      { href: '/self-hosting', kicker: 'Self-hosting', label: 'Run your own registry', desc: 'Private networks, roles, OIDC, policy and audit' },
      { href: '/security', kicker: 'Security', label: 'Security model', desc: 'What Pilot protects and what you still own' },
      { href: '/docs/integration', kicker: 'Build', label: 'SDKs & integration', desc: 'Go, Node, Python and Swift' },
      { href: '/docs/research', kicker: 'Research', label: 'Technical papers', desc: 'Wire specification and research' },
    ],
    footer: { href: '/learn/what-is-pilot-protocol', label: 'What is Pilot Protocol?' },
  },
];

const navLinks = [
  { href: '/service-agents', label: 'Service agents', activeFor: ['service-agents'] },
  { href: '/app-store', label: 'App Store', activeFor: ['apps'] },
  { href: '/cloud', label: 'Pilot Cloud', activeFor: ['cloud'] },
  { href: '/docs/', label: 'Docs', activeFor: ['docs'] },
  { href: '/blog/', label: 'Blog', activeFor: ['blog'] },
  { href: 'https://github.com/pilot-protocol/pilotprotocol', label: 'GitHub', activeFor: [], external: true },
];
---
<a class="skip-link" href="#page-content">Skip to content</a>
<nav class="nav-top" aria-label="Primary">
  <div class="wrap">
    <div class="nav-row">
      <a href="/" class="brand"
         data-track="nav_click" data-track-target="home">
        <span class="brand-mark"><img src="/img/pilot-48.webp" alt="" class="logo" width="40" height="40" decoding="async" /></span>
        <span class="brand-text"><strong>Pilot</strong><span>Protocol</span></span><span class="sr-only"> home</span>
      </a>

      <div class="nav-links" id="nav-links">
        {navGroups.map((group) => (
          <div class:list={['nav-dropdown', group.activeFor.includes(active || '') && 'active']} data-nav-group={group.id}>
            <button type="button" class="nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false">
              <span class="nav-trigger-label">{group.label}</span>
              <svg class="caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="nav-dropdown-menu">
              <div class="nav-menu-intro">
                <span class="nav-menu-eyebrow">{group.eyebrow}</span>
                <strong>{group.title}</strong>
                <p>{group.desc}</p>
              </div>
              <div class="nav-menu-links">
                {group.links.map((l) => (
                  <a href={l.href} data-track="nav_click" data-track-target={`${group.id}-${l.label.toLowerCase().replaceAll(' ', '-')}`}>
                    <span class="dd-kicker">{l.kicker}</span>
                    <span class="dd-label">{l.label}</span>
                    <span class="dd-desc">{l.desc}</span>
                    <span class="dd-arrow" aria-hidden="true">↗</span>
                  </a>
                ))}
              </div>
              <a class="nav-menu-footer" href={group.footer.href}>
                <span>{group.footer.label}</span><span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        ))}

        {navLinks.map((l) => {
          const isActive = l.activeFor.includes(active || '');
          return (
            <a
              href={l.href}
              class:list={['nav-link', isActive && 'active']}
              data-track="nav_click"
              data-track-target={l.label.toLowerCase().replaceAll(' ', '-')}
            >
              <span class="nav-trigger-label">{l.label}</span>
              {l.external && <span class="nav-link-ext" aria-hidden="true">↗</span>}
            </a>
          );
        })}

        <div class="nav-mobile-actions">
          <a class="nav-cta" href="/docs/getting-started" data-track="nav_click" data-track-target="install">Install</a>
        </div>
      </div>

      <div class="nav-right">
        <a class="nav-cta" href="/docs/getting-started" data-track="nav_click" data-track-target="install">Install</a>
        <button id="theme-toggle" class="theme-toggle" aria-label="Toggle light/dark theme" type="button">
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4.2"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
          </svg>
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
          </svg>
        </button>
        <button id="nav-hamburger" class="nav-hamburger" aria-label="Toggle menu" aria-expanded="false" type="button">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </div>
</nav>
{Astro.url.pathname !== '/' && breadcrumbs !== false && (
  <Breadcrumbs items={Array.isArray(breadcrumbs) ? breadcrumbs : undefined} currentLabel={breadcrumbLabel} />
)}
<span id="page-content" class="skip-target" tabindex="-1"></span>

<script is:inline>
  (function () {
    var nav = document.querySelector('.nav-top');
    var themeBtn = document.getElementById('theme-toggle');
    if (themeBtn) {
      themeBtn.addEventListener('click', function () {
        var isLight = document.documentElement.getAttribute('data-theme') === 'light';
        if (isLight) {
          document.documentElement.removeAttribute('data-theme');
          try { localStorage.setItem('pilot-theme', 'dark'); } catch (e) {}
        } else {
          document.documentElement.setAttribute('data-theme', 'light');
          try { localStorage.setItem('pilot-theme', 'light'); } catch (e) {}
        }
      });
    }

    function closeDropdowns(except) {
      document.querySelectorAll('.nav-dropdown.open').forEach(function (dd) {
        if (dd === except) return;
        dd.classList.remove('open');
        var trigger = dd.querySelector('.nav-dropdown-trigger');
        if (trigger) trigger.setAttribute('aria-expanded', 'false');
      });
    }

    function closeMobileMenu() {
      if (!links || !links.classList.contains('mobile-open')) return;
      links.classList.remove('mobile-open');
      if (hamb) {
        hamb.classList.remove('is-open');
        hamb.setAttribute('aria-expanded', 'false');
        hamb.setAttribute('aria-label', 'Open menu');
      }
      document.body.classList.remove('nav-mobile-open');
      closeDropdowns();
    }

    // Hamburger (mobile)
    var hamb = document.getElementById('nav-hamburger');
    var links = document.getElementById('nav-links');
    if (hamb && links) {
      hamb.setAttribute('aria-label', 'Open menu');
      hamb.addEventListener('click', function () {
        var open = links.classList.toggle('mobile-open');
        hamb.classList.toggle('is-open', open);
        hamb.setAttribute('aria-expanded', open ? 'true' : 'false');
        hamb.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        document.body.classList.toggle('nav-mobile-open', open);
        if (!open) closeDropdowns();
      });
      links.querySelectorAll('a').forEach(function (link) {
        link.addEventListener('click', closeMobileMenu);
      });
    }

    // Dropdown: click to toggle, click-outside to close
    document.querySelectorAll('.nav-dropdown').forEach(function (dd) {
      var trigger = dd.querySelector('.nav-dropdown-trigger');
      if (!trigger) return;
      trigger.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var wasOpen = dd.classList.contains('open');
        closeDropdowns(dd);
        dd.classList.toggle('open', !wasOpen);
        var isOpen = !wasOpen;
        trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });
    });
    document.addEventListener('click', function (e) {
      if (!e.target.closest || !e.target.closest('.nav-dropdown')) closeDropdowns();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        document.querySelectorAll('.nav-dropdown.open').forEach(function (dd) {
          dd.classList.remove('open');
          var trig = dd.querySelector('.nav-dropdown-trigger');
          if (trig) { trig.setAttribute('aria-expanded', 'false'); trig.focus(); }
        });
        closeMobileMenu();
      }
    });

    // A restrained shadow gives the persistent shell a clear edge once content scrolls beneath it.
    if (nav) {
      var syncNavEdge = function () { nav.classList.toggle('is-scrolled', window.scrollY > 8); };
      syncNavEdge();
      window.addEventListener('scroll', syncNavEdge, { passive: true });
    }
  })();
</script>

<style>
  /* Top-level links sit beside the Protocol menu and borrow its trigger look
     (system.css styles the dropdowns; these rules cover the plain links). */
  .nav-top .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--ink-dim);
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 530;
    letter-spacing: -0.01em;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
  }
  .nav-top .nav-link:hover,
  .nav-top .nav-link.active { color: var(--ink); }
  .nav-top .nav-link.active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 17px;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
  }
  .nav-top .nav-link:focus-visible { outline: 0; color: var(--ink); }
  .nav-top .nav-link:focus-visible .nav-trigger-label {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 3px;
  }
  .nav-top .nav-link-ext { font-size: 11px; color: var(--ink-dim); }

  @media (max-width: 1180px) {
    .nav-top .nav-link {
      display: flex;
      justify-content: space-between;
      width: 100%;
      min-height: 58px;
      padding: 0 4px;
      border-bottom: 1px solid var(--line);
      font-size: 17px;
      font-weight: 560;
      color: var(--ink);
    }
    .nav-top .nav-link.active::after { display: none; }
    .nav-top .nav-link-ext { font-size: 14px; }
    .nav-top .nav-mobile-actions { grid-template-columns: 1fr; }
  }
</style>
