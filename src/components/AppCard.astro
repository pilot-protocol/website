---
import type { App } from '../data/apps';
import AppIcon from './AppIcon.astro';
import { osSummary } from '../data/format';
interface Props { app: App; }
const { app } = Astro.props;
const searchBlob = [app.name, app.vendor, app.tagline, ...app.keywords, ...app.categories, app.id].join(' ').toLowerCase();
---
<a
  class="app-card"
  href={`/apps/${app.id}`}
  data-app-card
  data-name={app.name.toLowerCase()}
  data-cats={app.categories.join(' ')}
  data-search={searchBlob}
>
  <div class="c-top">
    <AppIcon app={app} size={56} />
    <div>
      <div class="c-name">{app.name}</div>
      <div class="c-vendor">{app.vendor}</div>
    </div>
  </div>
  <div class="c-tag">{app.tagline}</div>
  <div class="c-foot">
    <span class="compat">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
      {osSummary(app.bundles)}
    </span>
    {app.isNew && <span class="badge new">New</span>}
    <span class="card-go" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </span>
  </div>
</a>
