---
import { solutionsBySlug, type SolutionProfile } from '../data/solutions';
import { solutionStories, type SolutionStory } from '../data/solutionStories';

interface Props { solution: SolutionProfile; story: SolutionStory }
const { solution, story } = Astro.props;
const relatedSolutions = solution.related
  .map((slug) => ({ solution: solutionsBySlug.get(slug), story: solutionStories[slug] }))
  .filter((item): item is { solution: SolutionProfile; story: SolutionStory } => Boolean(item.solution && item.story));
---

<section class="solution-related-section" aria-labelledby={`${solution.slug}-related-title`}>
  <div class="wrap">
    <div class="solution-related-head">
      <div class="eyebrow">Adjacent capabilities</div>
      <h2 id={`${solution.slug}-related-title`}>The workflow rarely ends<br/><em>at one boundary.</em></h2>
    </div>
    <div class="solution-related-grid">
      {relatedSolutions.map((related) => (
        <a
          href={`/solutions/${related.solution.slug}`}
          data-track="solution_related_click"
          data-track-target={`${solution.slug}:${related.solution.slug}`}
        >
          <span>{related.solution.eyebrow}</span>
          <strong>{related.story.heroLead} {related.story.heroEmphasis}</strong>
          <i aria-hidden="true">↗</i>
        </a>
      ))}
    </div>
  </div>
</section>
