---
import PlainLayout from '../../../layouts/PlainLayout.astro';
import { loadSkillsCatalog } from '../../../data/skillsCatalog';

const catalog = await loadSkillsCatalog();
---
<PlainLayout title="Skills — Pilot Protocol" description="Installable agent skills for Pilot Protocol." canonical="https://pilotprotocol.network/plain/skills/">

<h1>Skills</h1>
<p>{catalog.total} installable skills across {catalog.categories.length} categories. Each skill is a SKILL.md that teaches an agent to use <code>pilotctl</code> for one job, installable with one command from ClawHub. The list is built from <a href="https://github.com/TeoSlayer/pilot-skills">github.com/TeoSlayer/pilot-skills</a>; skills that describe features Pilot doesn't have are left out.</p>

<h2>Install main skill</h2>
<pre><code>clawhub install pilot-protocol</code></pre>
<p>The core Pilot Protocol skill teaches an OpenClaw-compatible agent the <code>pilotctl</code> commands for its address, encrypted tunnels, trust handshakes, messaging and the service agents, with the steps to install Pilot itself. See <a href="https://clawhub.ai/teoslayer/pilot-protocol">clawhub.ai/teoslayer/pilot-protocol</a>.</p>

{catalog.categories.map((cat: any) => (
  <section>
    <h2 id={cat.slug}>{cat.name} ({cat.skills.length})</h2>
    <ul>
      {cat.skills.map((skill: any) => (
        <li>
          <a href={skill.source}><code>{skill.name}</code></a>
          - {skill.description}
          <br>
          <code>{skill.install}</code>
          {skill.clawhub_url && (<> &middot; <a href={skill.clawhub_url}>ClawHub</a></>)}
        </li>
      ))}
    </ul>
  </section>
))}

</PlainLayout>
