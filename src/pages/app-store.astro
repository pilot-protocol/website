---
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AppIcon from '../components/AppIcon.astro';
import AppCard from '../components/AppCard.astro';
import Shelf from '../components/Shelf.astro';
import { apps, categories, featuredApps, newApps, appsByCategory } from '../data/apps';
import { osSummary } from '../data/format';
import '../styles/system.css';
import '../styles/appstore.css';

const title = 'App Store — Agent Apps on Pilot Protocol';
const description = 'Browse and install agent apps from the Pilot Protocol App Store. Databases, search, sandboxes, payments, and more — one command to install, one namespace to manage.';
const canonicalUrl = 'https://pilotprotocol.network/app-store';

const featured = featuredApps();
const hero = featured[0];
const sideFeatured = featured.slice(1, 4);
const freshPinned = ['io.pilot.agentphone', 'io.pilot.orthogonal', 'io.pilot.bowmark', 'io.pilot.miren', 'io.pilot.smolmachines', 'io.pilot.wallet', 'io.pilot.slipstream'];
const freshExclude = new Set(['io.pilot.postgres', 'io.pilot.docker']);
const fresh = [
  ...freshPinned.map((id) => apps.find((a) => a.id === id)).filter(Boolean),
  ...[...apps]
    .filter((a) => a.publishedAt && !freshPinned.includes(a.id) && !freshExclude.has(a.id))
    .sort((a, b) => (b.publishedAt || '').localeCompare(a.publishedAt || '')),
].slice(0, 10);
const liveCount = apps.filter((a) => a.real).length;

// category shelves (only categories with at least a couple of apps to fill a rail)
const shelves = categories
  .map((c) => ({ cat: c, list: appsByCategory(c.id).sort((a, b) => a.name.localeCompare(b.name)) }))
  .filter((s) => s.list.length >= 2);

// all apps for the search/filter results grid
const allSorted = [...apps].sort((a, b) => a.name.localeCompare(b.name));

const publishHref = '/publish';
---
<!DOCTYPE html>
<html lang="en">
<head>
<BaseHead title={title} description={description} canonicalUrl={canonicalUrl} ogImage="https://pilotprotocol.network/og/app-store.jpg" />
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: canonicalUrl,
  publisher: { '@type': 'Organization', name: 'Pilot Protocol', url: 'https://pilotprotocol.network' },
})}></script>
</head>
<body>
<Nav active="for" />

<main class="store">

  <!-- ================= HEAD + SEARCH ================= -->
  <section class="store-head">
    <div class="wrap">
      <div class="head-l">
        <div class="eyebrow" style="font-family:var(--mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--accent);">App Store</div>
        <h1>Agent apps.<br/><em>One command away.</em></h1>
        <p class="lede">Experiences built for agents, not browsers. Every app installs as a <b>sha256-pinned, signature-verified</b> native service — auto-spawned by the daemon, callable over typed IPC in seconds.</p>
        <div class="store-metrics">
          <div class="store-metric"><div class="v">{apps.length}</div><div class="l">Apps</div></div>
          <div class="store-metric"><div class="v">{categories.length}</div><div class="l">Categories</div></div>
          <div class="store-metric"><div class="v"><em>{liveCount}</em></div><div class="l">Live now</div></div>
        </div>
      </div>
      <div class="head-r">
        <div class="dev-cta">
          <span class="dev-label">For developers</span>
          <a class="pub-btn" href={publishHref}>Publish your app <span class="arr">→</span></a>
        </div>
        <div class="store-search" id="search">
          <div class="field">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            <input type="search" id="store-q" placeholder="Search apps, capabilities, vendors…" autocomplete="off" aria-label="Search apps" />
            <kbd id="kbd-hint">⌘K</kbd>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= STICKY CATEGORY BAR ================= -->
  <nav class="catbar" aria-label="Categories">
    <div class="wrap" id="catbar">
      <button class="chip is-active" data-cat="all" type="button">All</button>
      {categories.map((c) => <button class="chip" data-cat={c.id} type="button">{c.name}</button>)}
    </div>
  </nav>

  <!-- ================= BROWSE VIEW (featured + shelves) ================= -->
  <div id="browse-view">

    <!-- Featured hero -->
    <section class="wrap">
      <div class="featured" style={`--glow:${hero.icon.color}`}>
        <div class="featured-inner">
          <div class="f-main">
            <span class="kicker">Latest Featured App</span>
            <div class="f-top">
              <AppIcon app={hero} size={88} />
              <div>
                <h2>{hero.name}</h2>
                <div class="f-vendor">{hero.vendor} · v{hero.version}</div>
              </div>
            </div>
            <p class="f-tag">{hero.tagline}.</p>
            <div class="f-chips">
              {hero.categories.map((c) => <span class="tag-pill">{categories.find((x) => x.id === c)?.name ?? c}</span>)}
              <span class="tag-pill">{hero.protection}</span>
            </div>
            <div class="f-cta">
              <a class="get-btn" href={`/apps/${hero.id}`}>View details <span class="arr">→</span></a>
              <div class="f-meta">
                <div class="mini-stat"><div class="v">{osSummary(hero.bundles)}</div><div class="l">Platforms</div></div>
                <div class="mini-stat"><div class="v">v{hero.version}</div><div class="l">Version</div></div>
                <div class="mini-stat"><div class="v" style="text-transform:capitalize;">{hero.protection}</div><div class="l">Sandbox</div></div>
              </div>
            </div>
          </div>
          <div class="f-side">
            <span class="kicker" style="margin-bottom:14px;display:inline-flex;">Also featured</span>
            <div class="f-side-card">
              {sideFeatured.map((a) => (
                <a href={`/apps/${a.id}`}>
                  <AppIcon app={a} size={56} />
                  <div style="min-width:0;">
                    <div class="n">{a.name}</div>
                    <span class="t">{a.tagline}</span>
                  </div>
                  <span class="side-compat">{osSummary(a.bundles)}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Curated + category shelves -->
    <div class="wrap">
      <Shelf title="New &amp; <em>Updated</em>" eyebrow="Fresh" blurb="Just shipped or recently bumped on the catalogue." apps={fresh} />
      {shelves.map((s) => (
        <Shelf title={s.cat.name} eyebrow={`${s.list.length} apps`} blurb={s.cat.blurb} apps={s.list} seeAllCat={s.cat.id} />
      ))}
    </div>
  </div>

  <!-- ================= RESULTS VIEW (search / filter) ================= -->
  <section class="results wrap is-hidden" id="results-view">
    <div class="shelf-head">
      <div class="st">
        <span class="eyebrow" style="font-family:var(--mono);font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--accent);">Results</span>
        <h3 id="results-title">All apps</h3>
      </div>
      <div class="shelf-nav"><span id="results-count" style="font-family:var(--mono);font-size:12px;color:var(--ink-dim);"></span></div>
    </div>
    <div class="results-grid" id="results-grid">
      {allSorted.map((app) => <AppCard app={app} />)}
    </div>
    <div class="empty is-hidden" id="results-empty">No apps match — try another term or category.</div>
  </section>

  <!-- ================= BUILDER CTA ================= -->
  <section class="wrap">
    <div class="builder-cta">
      <div class="bc-copy">
        <div class="eyebrow" style="font-family:var(--mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--accent);">For builders</div>
        <h2>Ship an agent app.<br/><em>It’s just a manifest.</em></h2>
        <p>Sign a <code>manifest.json</code>, attach a bundle, open one PR. Once merged, <code>pilotctl appstore install &lt;id&gt;</code> works everywhere on the overlay.</p>
      </div>
      <div class="bc-actions">
        <a class="pub-btn" href={publishHref}>Publish your app <span class="arr">→</span></a>
        <a class="pub-btn ghost" href="/docs/app-store">Read the docs</a>
      </div>
    </div>
  </section>

</main>

<Footer />

<script>
  const $ = (s, r = document) => r.querySelector(s);
  const $$ = (s, r = document) => Array.from(r.querySelectorAll(s));

  // ---- shelf arrows ----
  $$('[data-shelf]').forEach((shelf) => {
    const track = $('[data-track]', shelf);
    shelf.querySelectorAll('[data-scroll]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const dir = Number(btn.getAttribute('data-scroll'));
        track.scrollBy({ left: dir * Math.round(track.clientWidth * 0.8), behavior: 'smooth' });
      });
    });
    const update = () => {
      const btns = shelf.querySelectorAll('[data-scroll]');
      const l = btns[0], r = btns[1];
      const max = track.scrollWidth - track.clientWidth - 2;
      if (l) l.disabled = track.scrollLeft <= 2;
      if (r) r.disabled = track.scrollLeft >= max;
    };
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });

  // ---- search + category filter ----
  const q = $('#store-q');
  const browseView = $('#browse-view');
  const resultsView = $('#results-view');
  const cards = $$('#results-grid [data-app-card]');
  const chips = $$('#catbar .chip');
  let activeCat = 'all';

  const catNames = {};
  chips.forEach((c) => { if (c.dataset.cat !== 'all') catNames[c.dataset.cat] = c.textContent.trim(); });

  function applyFilter() {
    const term = (q.value || '').trim().toLowerCase();
    const filtering = term.length > 0 || activeCat !== 'all';

    browseView.classList.toggle('is-hidden', filtering);
    resultsView.classList.toggle('is-hidden', !filtering);
    if (!filtering) return;

    let shown = 0;
    cards.forEach((card) => {
      const matchCat = activeCat === 'all' || card.dataset.cats.split(' ').includes(activeCat);
      const matchTerm = !term || card.dataset.search.includes(term);
      const ok = matchCat && matchTerm;
      card.classList.toggle('is-hidden', !ok);
      if (ok) shown++;
    });

    const titleEl = $('#results-title');
    if (activeCat !== 'all' && term) titleEl.textContent = `${catNames[activeCat]} · “${q.value.trim()}”`;
    else if (activeCat !== 'all') titleEl.textContent = catNames[activeCat];
    else titleEl.textContent = `“${q.value.trim()}”`;

    $('#results-count').textContent = shown + (shown === 1 ? ' app' : ' apps');
    $('#results-empty').classList.toggle('is-hidden', shown > 0);
  }

  q.addEventListener('input', applyFilter);

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      activeCat = chip.dataset.cat;
      chips.forEach((c) => c.classList.toggle('is-active', c === chip));
      applyFilter();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });

  $$('[data-see-all]').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const cat = a.getAttribute('data-see-all');
      const chip = chips.find((c) => c.dataset.cat === cat);
      if (chip) chip.click();
    });
  });

  // ---- activate category from URL hash (#cat-<id>) ----
  function activateFromHash() {
    const m = /^#cat-(.+)$/.exec(location.hash);
    if (!m) return;
    const chip = chips.find((c) => c.dataset.cat === m[1]);
    if (chip && !chip.classList.contains('is-active')) chip.click();
  }
  activateFromHash();
  window.addEventListener('hashchange', activateFromHash);

  // ---- ⌘K / focus ----
  const isMac = navigator.platform.toLowerCase().includes('mac');
  const hint = $('#kbd-hint');
  if (hint) hint.textContent = isMac ? '⌘K' : 'Ctrl K';
  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); q.focus(); q.select(); }
    if (e.key === 'Escape' && document.activeElement === q) { q.value = ''; applyFilter(); q.blur(); }
  });
</script>

</body>
</html>
