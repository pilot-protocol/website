---
import BaseHead from '../../components/BaseHead.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/system.css';
import '../../styles/enterprise-pages.css';

const title = 'Claude Code Management for Enterprise | Pilot Protocol';
const description = 'Manage work-issued Claude Code runtimes with fleet inventory, model-usage attribution, signed settings rollout, policy controls, and audited remote operations.';
const canonicalUrl = 'https://pilotprotocol.network/enterprise/claude-code-management';

const guardrails = [
  ['01', 'Native action controls', 'Map supported Claude tool events into governed process, filesystem, browser, HTTP, trust, message, and file-transfer actions.'],
  ['02', 'Approval before consequence', 'Hold an exact action for expiring human consent, then resume it once with a signed, payload-bound approval.'],
  ['03', 'Typed remote recovery', 'Refresh policy, sync state, collect diagnostics, export receipts, restart, or shut down through signed allowlisted commands.'],
  ['04', 'Evidence that joins up', 'Connect the employee runtime, called resource, policy revision, decision, approval, result, and receipt in one trace.'],
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <BaseHead title={title} description={description} canonicalUrl={canonicalUrl} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: canonicalUrl,
    dateModified: '2026-08-05',
    author: { '@id': 'https://pilotprotocol.network/#organization' },
    about: { '@type': 'SoftwareApplication', name: 'Pilot Claude Code fleet management', applicationCategory: 'BusinessApplication' },
    publisher: { '@id': 'https://pilotprotocol.network/#organization' },
  })}></script>
</head>
<body class="enterprise-page claude-page">
  <Nav
    active="for"
    breadcrumbs={[
      { name: 'Home', href: '/' },
      { name: 'Enterprise control plane', href: '/enterprise/autonomous-ai-agents' },
      { name: 'Claude Code management' },
    ]}
  />

  <main>
    <section class="claude-hero">
      <div class="wrap">
        <div class="claude-hero-intro">
          <div>
            <span class="product-kicker">Claude Code for enterprise teams · managed preview</span>
            <h1>Manage the fleet. Understand the <em>spend.</em></h1>
          </div>
          <div class="claude-hero-copy">
            <p>One operating view for work-issued Claude Code runtimes: who is connected, what policy applies, where usage accumulates, what changed, and which actions need attention.</p>
            <div class="product-actions">
              <a class="btn primary" href="/contact?topic=enterprise" data-track="enterprise_cta" data-track-target="claude-code-preview">Join the managed preview <span class="arr">→</span></a>
              <a class="btn" href="#usage">See usage controls</a>
            </div>
          </div>
        </div>

        <div class="claude-admin" role="img" aria-label="Illustrative management console for employee Claude Code runtimes, showing inventory, usage, policy, and drift">
          <div class="claude-admin-bar">
            <div class="claude-admin-brand"><i>P</i><span>Pilot for Claude Code</span></div>
            <span>Illustrative operator view · synced just now</span>
          </div>
          <div class="claude-admin-body">
            <div class="claude-admin-nav" aria-hidden="true">
              <span class="active">Team overview</span>
              <span>People &amp; devices</span>
              <span>Usage</span>
              <span>Policies</span>
              <span>Approvals</span>
              <span>Remote actions</span>
              <span>Audit</span>
            </div>
            <div class="claude-admin-main">
              <div class="claude-admin-title"><h2>Engineering workspace</h2><span>Last 7 days</span></div>
              <div class="claude-summary">
                <div><span>Managed</span><b>18</b><small>18 reporting</small></div>
                <div><span>Active now</span><b>15</b><small>3 idle</small></div>
                <div><span>Model calls</span><b>1.8k</b><small>attributed</small></div>
                <div><span>Policy drift</span><b>2</b><small>attention</small></div>
              </div>
              <div class="claude-table">
                <div class="claude-table-head"><span>Employee / runtime</span><span>Status</span><span>Usage</span><span>Policy</span><span></span></div>
                <div class="claude-user-row"><div class="claude-user"><span class="claude-avatar">AM</span><div><strong>Ana M.</strong><small>macOS · Claude Code</small></div></div><span class="claude-state">Online</span><code>4.2M tok</code><code>eng-r42</code><span class="claude-more">···</span></div>
                <div class="claude-user-row"><div class="claude-user"><span class="claude-avatar">JK</span><div><strong>Jon K.</strong><small>Linux · Claude Code</small></div></div><span class="claude-state drift">Drift</span><code>2.8M tok</code><code>eng-r41</code><span class="claude-more">···</span></div>
                <div class="claude-user-row"><div class="claude-user"><span class="claude-avatar">RS</span><div><strong>Rina S.</strong><small>macOS · Claude Code</small></div></div><span class="claude-state">Online</span><code>1.9M tok</code><code>eng-r42</code><span class="claude-more">···</span></div>
                <div class="claude-user-row"><div class="claude-user"><span class="claude-avatar">TP</span><div><strong>Teo P.</strong><small>Linux · Claude Code</small></div></div><span class="claude-state">Idle</span><code>1.1M tok</code><code>eng-r42</code><span class="claude-more">···</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="claude-story" aria-label="Claude Code fleet management outcomes">
      <div class="wrap">
        <article class="claude-story-row">
          <div class="claude-story-index" aria-hidden="true">01</div>
          <div class="claude-story-content">
            <div class="claude-story-copy">
              <span class="product-kicker">Know what is running</span>
              <h2>One inventory for every managed runtime.</h2>
              <p>See enrollment, health, uptime, runtime and policy versions, adapter capabilities, group, tags, bounded activity, and observed versus desired state.</p>
            </div>
            <div class="claude-story-visual" aria-label="Illustrative managed runtime inventory">
              <div class="inventory-line"><span>AM</span><div><b>ana-macbook-pro</b><small>Claude adapter · online 6h 14m</small></div><code>converged</code></div>
              <div class="inventory-line"><span>JK</span><div><b>jon-devbox</b><small>Claude adapter · policy update pending</small></div><code>drift</code></div>
              <div class="inventory-line"><span>RS</span><div><b>rina-laptop</b><small>Claude adapter · online 2h 08m</small></div><code>converged</code></div>
              <div class="inventory-line"><span>TP</span><div><b>teo-workstation</b><small>Claude adapter · idle 42m</small></div><code>healthy</code></div>
            </div>
          </div>
        </article>

        <article class="claude-story-row">
          <div class="claude-story-index" aria-hidden="true">02</div>
          <div class="claude-story-content">
            <div class="claude-story-copy">
              <span class="product-kicker">Manage without screen sharing</span>
              <h2>Targeted control, from a distance.</h2>
              <p>Quarantine a managed runtime, refresh policy, synchronize state, collect diagnostics, or request a graceful restart. Commands are signed, expiring, reason-bound, and returned with a bounded result.</p>
            </div>
            <div class="claude-story-visual" aria-label="Illustrative remote operation history">
              <div class="inventory-line"><span>↳</span><div><b>refresh_policy</b><small>Engineering group · issued by Ops</small></div><code>18 / 18</code></div>
              <div class="inventory-line"><span>↳</span><div><b>collect_diagnostics</b><small>jon-devbox · drift investigation</small></div><code>complete</code></div>
              <div class="inventory-line"><span>↳</span><div><b>sync_state</b><small>rina-laptop · config reconciliation</small></div><code>applied</code></div>
              <div class="inventory-line"><span>↳</span><div><b>restart_runtime</b><small>ana-macbook-pro · graceful lifecycle</small></div><code>signed</code></div>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="claude-usage" id="usage" aria-labelledby="usage-title">
      <div class="wrap usage-grid">
        <div class="usage-copy">
          <span class="product-kicker">Usage &amp; spend accountability</span>
          <h2 id="usage-title">See the usage behind <em>the bill.</em></h2>
          <p>Attribute model calls and input/output tokens to the tenant and managed runtime, so cost review can happen by team, project, policy, and operating context.</p>
          <ul>
            <li>Model-call and token attribution per managed runtime</li>
            <li>Usage delivery status and failure visibility</li>
            <li>Policy-aware context for high-consumption activity</li>
            <li>Context for finance and platform review</li>
          </ul>
        </div>
        <div class="usage-panel" aria-label="Illustrative model usage attribution view">
          <div class="usage-panel-head"><b>Model usage by team</b><span>Illustrative · 30 days</span></div>
          <div class="usage-bars">
            <div class="usage-bar"><div class="usage-bar-label"><b>Product engineering</b><span>18.4M tokens</span></div><div class="usage-bar-track"><i style="width:82%"></i></div></div>
            <div class="usage-bar"><div class="usage-bar-label"><b>Platform</b><span>11.2M tokens</span></div><div class="usage-bar-track"><i style="width:56%"></i></div></div>
            <div class="usage-bar"><div class="usage-bar-label"><b>Security</b><span>6.8M tokens</span></div><div class="usage-bar-track"><i style="width:34%"></i></div></div>
          </div>
          <div class="usage-split">
            <div><b>2,481</b><span>Model calls</span></div>
            <div><b>31.4M</b><span>Input tokens</span></div>
            <div><b>5.0M</b><span>Output tokens</span></div>
          </div>
          <p class="usage-preview-note">Current managed-preview accounting attributes model calls and tokens. Provider-price reconciliation, enforced dollar budgets, and invoice-grade reporting are being completed with design partners.</p>
        </div>
      </div>
    </section>

    <section class="claude-rollout" aria-labelledby="rollout-title">
      <div class="wrap rollout-grid">
        <div class="rollout-visual" aria-label="Illustrative signed settings rollout">
          <div class="rollout-head"><b>Engineering policy rollout</b><span>Revision 42</span></div>
          <div class="rollout-step"><span>01</span><div><b>Review the change</b><small>Exact diff and bounded simulation</small></div><code>approved</code></div>
          <div class="rollout-step"><span>02</span><div><b>Canary two runtimes</b><small>Signed desired state issued</small></div><code>2 / 2</code></div>
          <div class="rollout-step"><span>03</span><div><b>Collect acknowledgements</b><small>Applied, partial, or rejected</small></div><code>18 / 18</code></div>
          <div class="rollout-step"><span>04</span><div><b>Monitor convergence</b><small>Drift remains visible until resolved</small></div><code>healthy</code></div>
        </div>
        <div class="rollout-copy">
          <span class="product-kicker">Settings and policy rollout</span>
          <h2 id="rollout-title">Change the right settings. <em>Keep a history.</em></h2>
          <p>Use authority-signed desired state for policy revision, grouping, tags, runtime target, quarantine posture, and supported Pilot configuration. Safe state changes use optimistic revisions and record who changed what and why.</p>
          <div class="rollout-tags" aria-label="Managed settings">
            <span>policy revision</span><span>group &amp; tags</span><span>runtime target</span><span>quarantine</span><span>safe .pilot state</span>
          </div>
        </div>
      </div>
    </section>

    <section class="claude-guardrails" aria-labelledby="guardrails-title">
      <div class="wrap">
        <div class="page-section-heading">
          <div><span class="product-kicker">Control that follows the action</span><h2 id="guardrails-title">Guardrails for the work, not just <em>the login.</em></h2></div>
          <p>Claude Code becomes manageable when policy reaches the native side effect and the evidence reaches the operator.</p>
        </div>
        <div class="guardrail-grid">
          {guardrails.map(([number, name, body]) => <article><span>{number}</span><div><h3>{name}</h3><p>{body}</p></div></article>)}
        </div>
        <div class="availability-note">
          <span>Adapter boundary</span>
          <p><strong>Pilot governs actions surfaced through an installed, supported adapter.</strong> It does not provide arbitrary remote shell access, capture unrelated tools automatically, or expose local keys and secrets in the console.</p>
          <a href="/docs/enterprise">Review architecture →</a>
        </div>
      </div>
    </section>

    <section class="enterprise-final" aria-labelledby="claude-final-title">
      <div class="wrap">
        <span class="product-kicker">Built with enterprise teams</span>
        <h2 id="claude-final-title">Define how Claude Code should run across <em>your company.</em></h2>
        <p>Bring your rollout model, provider-billing context, policy requirements, remote-management needs, and evidence obligations.</p>
        <div class="product-actions">
          <a class="btn primary" href="/contact?topic=enterprise" data-track="enterprise_cta" data-track-target="claude-code-bottom">Design the pilot <span class="arr">→</span></a>
          <a class="btn" href="/enterprise/autonomous-ai-agents">Explore the control plane</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</body>
</html>
