---
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/system.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <BaseHead title="Server Error - Pilot Protocol" description="Something went wrong on our end. The page couldn't be served." robots="noindex,nofollow" />
</head>
<body>
  <Nav />

  <section class="page-head nf-head">
    <div class="wrap nf-wrap">
      <div class="eyebrow">Error · 500</div>

      <div class="nf-mark" aria-hidden="true">
        <img src="/img/sad-doodle.png" alt="" class="nf-dog" width="1306" height="1071" />
      </div>

      <h1><em>Something broke.</em></h1>
      <p class="lede">
        We hit an unexpected error on our end. Try refreshing in a moment, or head back to the
        <a href="/">home page</a> while we sort it out. The network itself is fine - this is just the website.
      </p>

      <div class="nf-cta">
        <a href="/" class="btn primary">Home <span class="arr">→</span></a>
        <a href="/docs/" class="btn">Docs</a>
        <a href="/blog/" class="btn">Blog</a>
        <a href="https://github.com/pilot-protocol/pilotprotocol/issues" class="btn">Report issue</a>
      </div>
    </div>
  </section>

  <Footer />

  <style>
    .nf-head { padding-top: 64px; padding-bottom: 96px; }
    .nf-wrap {
      max-width: 680px;
      margin: 0 auto;
      text-align: center;
    }
    .nf-wrap .eyebrow { display: inline-block; }
    .nf-wrap .eyebrow::before { display: none; }

    .nf-mark {
      display: flex;
      justify-content: center;
      margin: 32px 0 48px;
    }
    .nf-dog {
      width: clamp(220px, 30vw, 360px);
      height: auto;
      display: block;
      margin: 0 auto;
      opacity: 0.9;
    }
    :root[data-theme="light"] .nf-dog { filter: invert(1); }

    .nf-head h1 { margin-left: auto; margin-right: auto; max-width: none; }
    .nf-head .lede { margin-left: auto; margin-right: auto; }

    .nf-cta {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      justify-content: center;
      margin: 32px 0 0;
    }
  </style>
</body>
</html>
