---
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/system.css';
import '../styles/forms.css';

const title = 'Contact — Pilot Protocol';
const description = 'Contact Pilot Protocol with questions, app publishing, partnerships, press inquiries or corrections. Email founders@pilotprotocol.network or use the form.';
const canonicalUrl = 'https://pilotprotocol.network/contact';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <BaseHead title={title} description={description} canonicalUrl={canonicalUrl} />
  {turnstileSiteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</head>
<body>
  <Nav active="contact" />
  <main>
    <section class="form-hero">
      <div class="gridbg" aria-hidden="true"></div>
      <div class="wrap form-hero-grid">
        <div><span class="form-eyebrow">Contact Pilot Protocol</span><h1>Talk to the<br/><em>people behind Pilot.</em></h1></div>
        <div class="form-hero-copy">
          <p>Questions, app publishing, partnerships or press: email us or use the form below.</p>
          <div class="form-direct"><span>Prefer email?</span><a href="mailto:founders@pilotprotocol.network">founders@pilotprotocol.network <i aria-hidden="true">↗</i></a></div>
        </div>
      </div>
    </section>

    <section class="form-main">
      <div class="wrap form-main-grid">
        <aside class="form-aside">
          <span class="form-eyebrow">What happens next</span>
          <h2>Straight to<br/><em>the team.</em></h2>
          <p>We route submissions directly to the founding team, and reply by email.</p>
          <div class="form-notes">
            <div class="form-note"><span>01</span><div><h3>Questions</h3><p>About Pilot Protocol, the data service agents, the App Store or Pilot Cloud. The <a href="/docs/">documentation</a> may already have the answer.</p></div></div>
            <div class="form-note"><span>02</span><div><h3>App publishing</h3><p>Apps are submitted through the <a href="/publish">publish page</a>. Write to us if a submission is stuck or you have a question about the review.</p></div></div>
            <div class="form-note"><span>03</span><div><h3>Corrections</h3><p>If something on this site is wrong, tell us the page and what it should say.</p></div></div>
          </div>
          <div class="form-policy"><h3>Reporting a bug or vulnerability?</h3><p>Use the <a href="/security/disclosure">bug and security disclosure form</a> so the report follows the right handling path.</p></div>
        </aside>

        <form class="inquiry-form" id="contact-form" data-endpoint="/forms/contact" novalidate>
          <div class="form-heading"><h2>Send a message</h2><p>Fields marked with * are required. Please do not include passwords, keys or other secrets.</p></div>
          <div class="field-grid">
            <div class="field"><label for="contact-name">Name *</label><input id="contact-name" name="name" type="text" autocomplete="name" maxlength="120" required /></div>
            <div class="field"><label for="contact-email">Email *</label><input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required /></div>
            <div class="field"><label for="contact-organization">Organization <span>(optional)</span></label><input id="contact-organization" name="organization" type="text" autocomplete="organization" maxlength="160" /></div>
            <div class="field"><label for="contact-role">Role <span>(optional)</span></label><input id="contact-role" name="role" type="text" autocomplete="organization-title" maxlength="160" /></div>
            <div class="field field-full"><label for="contact-topic">Topic *</label><select id="contact-topic" name="topic" required><option value="">Choose a topic</option><option value="question">Question</option><option value="app-publishing">App publishing</option><option value="partnership">Partnership</option><option value="press">Press</option><option value="correction">Correction</option><option value="other">Other</option></select></div>
            <div class="field field-full"><label for="contact-message">How can we help? *</label><textarea id="contact-message" name="message" maxlength="8000" required placeholder="What would you like to ask or tell us?"></textarea></div>
            <div class="honeypot" aria-hidden="true"><label for="contact-website">Company website</label><input id="contact-website" name="company_website" type="text" tabindex="-1" autocomplete="off" /></div>
            {turnstileSiteKey && <div class="turnstile-wrap"><div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action="contact" data-theme="auto"></div></div>}
          </div>
          <div class="form-footer">
            <p class="form-privacy">By submitting, you agree that Pilot may use this information to respond to your inquiry. See our <a href="/privacy">Privacy Policy</a>.</p>
            <button class="btn primary form-submit" type="submit">Send message <span class="arr">→</span></button>
          </div>
          <p class="form-status" id="contact-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>
  <Footer />

  <script is:inline>
    (function () {
      var form = document.getElementById('contact-form');
      var status = document.getElementById('contact-status');
      if (!form || !status) return;
      // ?topic= preselects a topic. Older links used 'product' for questions.
      var topic = new URLSearchParams(window.location.search).get('topic');
      if (topic === 'product') topic = 'question';
      var topicSelect = form.querySelector('[name="topic"]');
      if (topic && topicSelect && Array.from(topicSelect.options).some(function (option) { return option.value === topic; })) topicSelect.value = topic;

      form.addEventListener('submit', async function (event) {
        event.preventDefault();
        status.className = 'form-status';
        if (!form.checkValidity()) { form.reportValidity(); return; }
        var button = form.querySelector('button[type="submit"]');
        if (button) { button.disabled = true; button.textContent = 'Sending…'; }
        var data = Object.fromEntries(new FormData(form).entries());
        data.turnstile_token = data['cf-turnstile-response'] || '';
        data.page_url = window.location.href;
        try {
          var response = await fetch(form.dataset.endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
          var result = await response.json().catch(function () { return {}; });
          if (!response.ok || !result.ok) throw new Error(result.error || 'We could not send your message.');
          status.textContent = 'Thanks, your message was sent. Reference ' + result.reference + '.';
          status.className = 'form-status is-visible is-success';
          form.reset();
          if (window.turnstile) window.turnstile.reset();
        } catch (error) {
          status.textContent = (error && error.message ? error.message : 'We could not send your message.') + ' You can also email founders@pilotprotocol.network.';
          status.className = 'form-status is-visible is-error';
          if (window.turnstile) window.turnstile.reset();
        } finally {
          if (button) { button.disabled = false; button.textContent = 'Send message →'; }
        }
      });
    })();
  </script>
</body>
</html>
