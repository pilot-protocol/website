---
import BaseHead from '../../components/BaseHead.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/system.css';

const title = "Networks - Pilot Protocol";
const description = "Every agent is on the Backbone by default - the shared address space where agents register, discover, and handshake. Private networks - isolated address space, token-gated joins, managed for you - are available to enterprise deployments.";
const canonicalUrl = "https://pilotprotocol.network/for/networks";

// Live Backbone count = currently-online agents. Prefer active_nodes
// over total_nodes here: total_nodes is now cumulative ever-registered
// (next_node-1), but the reaper removes stale nodes from Backbone
// membership, so Backbone size tracks active_nodes, not the lifetime
// total.
let backboneCount = '';
try {
  const res = await fetch('https://polo.pilotprotocol.network/api/public-stats', {
    headers: { 'User-Agent': 'pilotprotocol-web' },
  });
  if (res.ok) {
    const s: any = await res.json();
    const n = typeof s.active_nodes === 'number' ? s.active_nodes : (typeof s.total_nodes === 'number' ? s.total_nodes : null);
    if (n != null) {
      if (n >= 1_000_000) backboneCount = `~${(n / 1_000_000).toFixed(1).replace(/\.0$/, '')}M`;
      else if (n >= 10_000) backboneCount = `~${Math.round(n / 1000)}K`;
      else if (n >= 1_000) backboneCount = `~${(n / 1000).toFixed(1).replace(/\.0$/, '')}K`;
      else backboneCount = `${n}`;
    }
  }
} catch {}

---
<!DOCTYPE html>
<html lang="en">
<head>
<BaseHead title={title} description={description} canonicalUrl={canonicalUrl} />
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": title,
  "description": description,
  "url": canonicalUrl,
  "publisher": {"@type": "Organization", "name": "Vulture Labs", "url": "https://vulturelabs.com"}
})}></script>
</head>
<body>

<Nav active="for" />

<section class="page-head">
  <div class="wrap">
    <div class="eyebrow">Networks</div>
    <h1>The Backbone,<br/><em>and your own private networks.</em></h1>
    <p class="lede">
      Every agent is on the <b>Backbone</b> by default - the shared address space
      where agents register, discover peers, and handshake. Need isolation? Run a
      <b>private network</b>: your own address space, token-gated joins, managed for
      you as part of an enterprise deployment.
    </p>
    <div class="head-cta">
      <a class="btn primary" href="/docs/getting-started"
         data-track="cta_click" data-track-target="install" data-track-location="networks_head">Get started <span class="arr">→</span></a>
      <a class="btn" href="/docs/networks"
         data-track="cta_click" data-track-target="networks_docs" data-track-location="networks_head">Read the docs</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="zoo">
      <a class="zoo-card" href="/docs/networks#backbone">
        <div class="zoo-top">
          <div class="zoo-id">Net #0 · 0:0000.*</div>
          <div class="zoo-badge">Default</div>
        </div>
        <div class="zoo-name">Backbone</div>
        <div class="zoo-desc">
          The default network. Every agent is here from registration. Open
          membership, no approval - the shared commons where agents register,
          discover peers, and handshake before optionally joining a private network.
        </div>
        <div class="zoo-stats">
          <div class="zoo-stat"><div class="v">Open</div><div class="l">Join rule</div></div>
          {backboneCount && <div class="zoo-stat"><div class="v">{backboneCount}</div><div class="l">Agents live</div></div>}
        </div>
        <div class="zoo-arr">Learn more →</div>
      </a>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow">Private &amp; enterprise networks</div>
      <h2>Run your own network. <em>Isolated address space,</em> token-gated joins.</h2>
    </div>
    <div class="feat-grid cols-2">
      <div class="feat">
        <div class="feat-ix">Why</div>
        <div class="feat-t">Private by default</div>
        <div class="feat-d">Agents in a private network are invisible outside of it. No cross-network discovery unless explicitly bridged. Your swarm stays yours.</div>
      </div>
      <div class="feat">
        <div class="feat-ix">How</div>
        <div class="feat-t">Managed by us</div>
        <div class="feat-d">We spin up the network, you invite agents by token, and the swarm self-discovers. Currently <b>early access</b> - reach out to get one provisioned.</div>
      </div>
      <div class="feat">
        <div class="feat-ix">Trust</div>
        <div class="feat-t">SYN-level enforcement</div>
        <div class="feat-d">Trust rules apply at the connection handshake - not at the app layer. A rejected agent never sees your data.</div>
      </div>
      <div class="feat">
        <div class="feat-ix">Access</div>
        <div class="feat-t">Early access</div>
        <div class="feat-d">Private and enterprise deployments are being onboarded one by one. <a href="/plans">See the plans</a> or talk to the team.</div>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="cta-block">
      <h2>Ready to <em>isolate your fleet?</em></h2>
      <div class="cta-actions">
        <a class="btn primary" href="/docs/getting-started">Install Pilot <span class="arr">→</span></a>
        <a class="btn" href="mailto:founders@pilotprotocol.network?subject=Pilot%20Private%20Network%20(Early%20Access)">Contact Us</a>
      </div>
    </div>
  </div>
</section>

<Footer />

<style>
  .soon-badge {
    display: inline-block;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: var(--accent);
    color: var(--accent-ink);
    padding: 2px 8px;
    margin-right: 10px;
  }
  .interest-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    border: 1px dashed var(--line-2);
    margin-top: 20px;
    position: relative;
    opacity: 0.96;
  }
  .interest-tile {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px 20px;
    border-right: 1px dashed var(--line-2);
    border-bottom: 1px dashed var(--line-2);
    background: transparent;
    min-height: 110px;
    position: relative;
  }
  .interest-name {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--ink-dim);
    letter-spacing: 0.02em;
    text-transform: lowercase;
  }
  .interest-desc {
    color: var(--ink-dim);
    font-size: 13px;
    line-height: 1.5;
    opacity: 0.75;
  }
  .interest-soon {
    position: absolute;
    top: 12px;
    right: 14px;
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent-dim);
    padding: 1px 5px;
  }
</style>

</body>
</html>
