---
import BaseHead from '../../../components/BaseHead.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import '../../../styles/system.css';

export async function getStaticPaths() {
  let catalog: {setups: any[]; total: number} = { setups: [], total: 0 };
  try {
    const res = await fetch("https://raw.githubusercontent.com/TeoSlayer/pilot-skills/main/setups.json");
    if (res.ok) catalog = await res.json();
  } catch {}
  const setups = [...catalog.setups].sort((a: any, b: any) => a.name.localeCompare(b.name));
  const terms = (value: string) => new Set(
    value.toLowerCase().split(/[^a-z0-9]+/).filter((word) => word.length > 3),
  );

  return setups.map((setup: any, index: number) => {
    const setupSkills = new Set<string>(setup.skills_used || []);
    const setupTerms = terms(`${setup.name} ${setup.description || ''}`);
    const relatedSetups = setups
      .filter((candidate: any) => candidate.slug !== setup.slug)
      .map((candidate: any) => {
        const sharedSkills = (candidate.skills_used || []).filter((skill: string) => setupSkills.has(skill)).length;
        const sharedTerms = [...terms(`${candidate.name} ${candidate.description || ''}`)]
          .filter((word) => setupTerms.has(word)).length;
        return { ...candidate, relevance: (sharedSkills * 10) + sharedTerms };
      })
      .sort((a: any, b: any) => b.relevance - a.relevance || a.name.localeCompare(b.name))
      .slice(0, 3);

    return {
      params: { slug: setup.slug },
      props: {
        setup,
        relatedSetups,
        previousSetup: setups[(index - 1 + setups.length) % setups.length],
        nextSetup: setups[(index + 1) % setups.length],
      },
    };
  });
}

const { setup, relatedSetups, previousSetup, nextSetup } = Astro.props as {
  setup: any;
  relatedSetups: any[];
  previousSetup: any;
  nextSetup: any;
};

const title = `${setup.name} - Orgs · Pilot Protocol`;
// Meta description: clean word-boundary truncation of the full description
// (setup.tagline is a hard ~100-char cut that breaks mid-word).
const rawDesc: string = setup.description || setup.tagline || '';
const description = rawDesc.length > 155
  ? rawDesc.slice(0, 155).replace(/\s+\S*$/, '') + '…'
  : rawDesc;
const canonicalUrl = `https://pilotprotocol.network/for/setups/${setup.slug}`;
---
<!DOCTYPE html>
<html lang="en">
<head>
<BaseHead title={title} description={description} canonicalUrl={canonicalUrl} />
</head>
<body>

<Nav active="for" breadcrumbLabel={setup.name} />

<main>

<section class="page-head">
  <div class="wrap">
    <div class="eyebrow"><a href="/for/setups" style="color:inherit">Orgs</a> · {setup.difficulty}</div>
    <h1>{setup.name}</h1>
    <p class="lede">{setup.description}</p>
    <div class="head-cta">
      <a class="btn primary" href="/docs/getting-started">Getting started <span class="arr">→</span></a>
      <a class="btn" href="/for/setups">Back to orgs</a>
    </div>
  </div>
</section>

<section class="section related-setups" aria-labelledby="related-setups-title">
  <div class="wrap">
    <div class="related-heading">
      <div>
        <div class="eyebrow">Explore adjacent patterns</div>
        <h2 id="related-setups-title">Related agent organizations</h2>
      </div>
      <p>Compare setups that reuse similar skills, trust paths, and operating patterns.</p>
    </div>
    <div class="related-setup-grid">
      {relatedSetups.map((related: any) => (
        <a class="related-setup-card" href={`/for/setups/${related.slug}`}>
          <span>{related.difficulty} · {related.agent_count} agents</span>
          <h3>{related.name}</h3>
          <p>{related.description}</p>
          <i>View organization →</i>
        </a>
      ))}
    </div>
    <nav class="setup-pager" aria-label="More agent organizations">
      <a href={`/for/setups/${previousSetup.slug}`}><span>← Previous</span><strong>{previousSetup.name}</strong></a>
      <a href={`/for/setups/${nextSetup.slug}`}><span>Next →</span><strong>{nextSetup.name}</strong></a>
    </nav>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="org-meta-bar">
      <div class="mb-item"><div class="mb-label">Agents</div><div class="mb-value">{setup.agent_count}</div></div>
      <div class="mb-item"><div class="mb-label">Skills</div><div class="mb-value">{setup.skills_used.length}</div></div>
      <div class="mb-item"><div class="mb-label">Difficulty</div><div class="mb-value">{setup.difficulty}</div></div>
    </div>

    <div class="sect-title">Install</div>
    <code class="setup-install">clawhub install pilot-{setup.slug}-setup</code>

    <div class="sect-title">Skills used</div>
    <div class="setup-skills">
      {setup.skills_used.map((sk: string) => (
        <a class="skill-chip" href={`https://clawhub.ai/teoslayer/${sk}`} target="_blank" rel="noopener">{sk}</a>
      ))}
    </div>

    <div class="sect-title">Agents</div>
    <div class="agent-list">
      {setup.agents.map((agent: any) => (
        <div class="agent-row">
          <div class="agent-head">
            <span class="agent-host">{agent.hostname}</span>
            <span class="agent-role">{agent.role}</span>
          </div>
          <div class="agent-desc">{agent.description}</div>
          {agent.skills && agent.skills.length > 0 && (
            <div class="agent-skills">
              {agent.skills.map((sk: string) => (
                <span class="skill-chip-sm">{sk}</span>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>

    {setup.data_flows && setup.data_flows.length > 0 && (
      <>
        <div class="sect-title">Data flows</div>
        <div class="flow-list">
          {setup.data_flows.map((flow: any) => (
            <div class="flow-row">
              <span class="flow-from">{flow.from}</span>
              <span class="flow-arr">→</span>
              <span class="flow-to">{flow.to}</span>
              <span class="flow-port">:{flow.port}</span>
              <span class="flow-desc">{flow.description}</span>
            </div>
          ))}
        </div>
      </>
    )}

    {setup.quick_start && setup.quick_start.length > 0 && (
      <>
        <div class="sect-title">Quick start</div>
        <pre class="setup-quickstart"><code>{setup.quick_start.join('\n')}</code></pre>
      </>
    )}
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="cta-block">
      <h2>Ready to <em>deploy {setup.name}?</em></h2>
      <div class="cta-actions">
        <a class="btn primary" href="/docs/getting-started">Install Pilot <span class="arr">→</span></a>
        <a class="btn" href="/for/setups">Browse other orgs</a>
      </div>
    </div>
  </div>
</section>

</main>

<Footer />

<style>
  .org-meta-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    border: 1px solid var(--line);
    margin-bottom: 32px;
  }
  .mb-item {
    padding: 18px 20px;
    border-right: 1px solid var(--line);
  }
  .mb-item:last-child { border-right: 0; }
  .mb-label {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-dim);
    margin-bottom: 6px;
  }
  .mb-value {
    font-family: var(--mono);
    font-size: 22px;
    color: var(--ink);
    text-transform: capitalize;
  }

  .sect-title {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-dim);
    margin: 32px 0 12px;
  }

  .setup-install {
    display: block;
    font-family: var(--mono);
    font-size: 13px;
    padding: 14px 18px;
    background: var(--term-bg);
    color: var(--accent);
    border: 1px solid var(--line);
  }

  .setup-skills { display: flex; flex-wrap: wrap; gap: 6px; }
  .skill-chip {
    font-family: var(--mono);
    font-size: 11px;
    padding: 4px 8px;
    border: 1px solid var(--line-2);
    color: var(--ink-dim);
    letter-spacing: 0.04em;
    text-decoration: none;
  }
  .skill-chip:hover { color: var(--accent-text); border-color: var(--accent); }
  .skill-chip-sm {
    font-family: var(--mono);
    font-size: 10px;
    padding: 2px 6px;
    border: 1px solid var(--line-2);
    color: var(--ink-dim);
  }

  .agent-list { border-top: 1px solid var(--line); }
  .agent-row { padding: 16px 0; border-bottom: 1px solid var(--line); }
  .agent-head { display: flex; gap: 12px; align-items: center; margin-bottom: 4px; flex-wrap: wrap; }
  .agent-host { font-family: var(--mono); font-size: 13px; color: var(--ink); }
  .agent-role { font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent-text); }
  .agent-desc { color: var(--ink-dim); font-size: 13px; line-height: 1.55; margin-bottom: 8px; }
  .agent-skills { display: flex; flex-wrap: wrap; gap: 4px; }

  .flow-list { border-top: 1px solid var(--line); }
  .flow-row {
    display: grid;
    grid-template-columns: 1fr 20px 1fr auto 1.5fr;
    gap: 10px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
    font-family: var(--mono);
    font-size: 12px;
  }
  @media (max-width: 640px) { .flow-row { grid-template-columns: 1fr; gap: 2px; } }
  .flow-from, .flow-to { color: var(--ink); }
  .flow-arr { color: var(--accent); text-align: center; }
  .flow-port { color: var(--ink-dim); font-size: 11px; }
  .flow-desc { color: var(--ink-dim); font-family: var(--sans); font-size: 13px; }

  .setup-quickstart {
    font-family: var(--mono);
    font-size: 12px;
    padding: 20px;
    background: var(--term-bg);
    color: #eceae3;
    border: 1px solid var(--line);
    overflow-x: auto;
    line-height: 1.7;
  }

  .related-setups { border-top: 1px solid var(--line); background: var(--bg-2); }
  .related-heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, .7fr); gap: 48px; align-items: end; margin-bottom: 28px; }
  .related-heading h2 { margin: 0; font-size: clamp(32px, 4vw, 52px); letter-spacing: -.035em; }
  .related-heading p { margin: 0; color: var(--ink-dim); line-height: 1.6; }
  .related-setup-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .related-setup-card { display: flex; min-height: 260px; flex-direction: column; padding: 24px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); color: inherit; }
  .related-setup-card > span, .related-setup-card i, .setup-pager span { color: var(--ink-dim); font: 500 10px/1.4 var(--mono); letter-spacing: .08em; text-transform: uppercase; }
  .related-setup-card h3 { margin: 52px 0 10px; font-size: 23px; letter-spacing: -.02em; }
  .related-setup-card p { display: -webkit-box; margin: 0; overflow: hidden; color: var(--ink-dim); font-size: 13px; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
  .related-setup-card i { margin-top: auto; padding-top: 24px; color: var(--accent-text); font-style: normal; }
  .related-setup-card:hover h3 { color: var(--accent-text); }
  .setup-pager { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 24px; border: 1px solid var(--line); }
  .setup-pager a { display: grid; gap: 8px; padding: 18px 20px; color: inherit; }
  .setup-pager a + a { border-left: 1px solid var(--line); text-align: right; }
  .setup-pager strong { font-size: 14px; }

  @media (max-width: 820px) {
    .related-heading { grid-template-columns: 1fr; gap: 18px; }
    .related-setup-grid { grid-template-columns: 1fr; }
    .related-setup-card { min-height: 220px; }
  }
  @media (max-width: 560px) {
    .setup-pager { grid-template-columns: 1fr; }
    .setup-pager a + a { border-top: 1px solid var(--line); border-left: 0; text-align: left; }
  }
</style>

</body>
</html>
