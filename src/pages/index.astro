<!-- HOW IT WORKS -->
<section class="section" id="how" data-track-section="how">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow">How it works</div>
      <h2>One line of code.<br/>Then the agent takes over.</h2>
    </div>

    <div class="how-grid">
      <div class="term">
        <div class="bar">
          <div class="dots"><span></span><span></span><span></span></div>
          <div>agent@node ~ install pilot</div>
