    transition: background .2s ease, transform .2s ease;
  }
  .security-feature:hover {
    color: var(--ink);
    background: color-mix(in srgb, var(--accent) 5%, var(--bg));
    transform: translateY(-3px);
  }
  .sf-top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--ink-dim);
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .sf-state {
    padding: 3px 7px;
    border: 1px solid color-mix(in srgb, var(--accent) 42%, var(--line));
    color: var(--accent-text);
  }
  .sf-state.is-ea { color: #f2b45a; border-color: color-mix(in srgb, #f2b45a 42%, var(--line)); }
  .sf-state.is-app { color: #6ea8ff; border-color: color-mix(in srgb, #6ea8ff 42%, var(--line)); }
  :global([data-theme="light"]) .sf-state.is-ea { color: #7a4b00; border-color: #9b650e; }
  :global([data-theme="light"]) .sf-state.is-app { color: #245a9b; border-color: #4778b8; }
  .security-feature h3 {
    margin: 66px 0 12px;
    font-size: clamp(24px, 2.2vw, 31px);
    letter-spacing: -.025em;
  }
  .security-feature p { color: var(--ink-dim); font-size: 14px; line-height: 1.55; }
  .security-feature code { margin-top: auto; padding-top: 24px; color: var(--accent-text); font-size: 9px; line-height: 1.5; }
  .security-path {
    display: grid;
    grid-template-columns: 130px 1fr auto 1fr auto 1fr auto 1fr 120px;
    gap: 16px;
    align-items: center;
    margin-top: 18px;
    padding: 20px 22px;
    border: 1px solid color-mix(in srgb, var(--accent) 36%, var(--line));
    background: color-mix(in srgb, var(--accent) 5%, var(--bg));
  }
  .sp-label { color: var(--accent-text); font-family: var(--mono); font-size: 9px; letter-spacing: .1em; text-transform: uppercase; }
  .sp-step { display: flex; flex-direction: column; gap: 4px; }
  .sp-step span { color: var(--ink-dim); font-family: var(--mono); font-size: 8px; letter-spacing: .08em; text-transform: uppercase; }
  .sp-step b { font-size: 12px; font-weight: 550; }
  .sp-step.is-accent b { color: var(--accent-text); }
  .security-path i { color: var(--ink-dim); font-style: normal; }
  .security-path > a { color: var(--ink); font-family: var(--mono); font-size: 9px; text-transform: uppercase; }
  .stats-source {
    margin-top: 14px;
    color: var(--ink-dim);
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: .07em;
    text-align: right;
    text-transform: uppercase;
  }
  .stats-source a { color: var(--accent-text); }
  @media (max-width: 980px) {
    .security-head { grid-template-columns: 1fr; gap: 24px; }
    .security-feature-grid { grid-template-columns: 1fr 1fr; }
    .security-path { grid-template-columns: 1fr; gap: 10px; }
    .security-path i { transform: rotate(90deg); transform-origin: left; }
  }
  @media (max-width: 620px) {
    #security-foundation { padding-top: 70px; padding-bottom: 70px; }
    .security-feature-grid { grid-template-columns: 1fr; }
    .security-feature { min-height: 300px; }
    .security-feature h3 { margin-top: 46px; }
    .stats-source { text-align: left; line-height: 1.6; }
  }

  /* "What Pilot does for your agent" — compact pillars + rotating service wheel. */
  #agent-value { padding-top: 24px; }
  @media (max-width: 900px) { #agent-value { padding-top: 20px; } }
  #agent-value .section-head .eyebrow { font-size: 15px; letter-spacing: 0.1em; }
  .section-head .section-sub {
    grid-column: 2;
    max-width: 52ch;
    margin: 22px 0 0;
    font-size: clamp(19px, 2.2vw, 23px);
    line-height: 1.55;
    color: var(--ink-dim);
    text-wrap: pretty;
  }
  @media (max-width: 900px) {
    .section-head .section-sub { grid-column: 1; }
  }
  .pillars {
    margin: 40px 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .pillar {
    --c: var(--accent);
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 30px 28px;
    border-radius: 0;
    /* Frosted glass, matching the App Store callout up top. */
    border: 1px solid color-mix(in srgb, var(--c) 40%, transparent);
    background: color-mix(in srgb, var(--bg-2) 55%, transparent);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    backdrop-filter: blur(18px) saturate(1.4);
    box-shadow:
      0 8px 32px color-mix(in srgb, #000 20%, transparent),
      inset 0 1px 0 color-mix(in srgb, #fff 12%, transparent);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: border-color 0.35s ease, box-shadow 0.35s ease, transform 0.35s ease;
  }
  /* Coloured glow anchored to the top-right, like the callout's green glow. */
  .pillar::after {
    content: "";
    position: absolute;
    right: -60px;
    top: -60px;
    width: 220px;
    height: 220px;
    background: radial-gradient(circle,
      color-mix(in srgb, var(--c) 18%, transparent) 0%, transparent 68%);
    filter: blur(20px);
    opacity: 0.3;
    transition: opacity 0.4s ease;
    pointer-events: none;
    z-index: 0;
  }
  .pillar.is-active, .pillar:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--c) 70%, transparent);
    box-shadow:
      0 14px 40px color-mix(in srgb, #000 26%, transparent),
      0 0 0 1px color-mix(in srgb, var(--c) 24%, transparent),
      inset 0 1px 0 color-mix(in srgb, #fff 18%, transparent);
  }
  .pillar.is-active::after, .pillar:hover::after { opacity: 0.55; }
  .pillar > * { position: relative; z-index: 1; }
  /* Big faint outlined number watermark, anchored top-right of each card. */
  .pillar .p-ghost {
    position: absolute;
    top: 8px;
    right: 18px;
    z-index: 0;
    font-family: var(--mono);
    font-weight: 700;
    font-size: 84px;
    line-height: 1;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in srgb, var(--c) 42%, transparent);
    opacity: 0.5;
    pointer-events: none;
    transition: opacity 0.4s ease, -webkit-text-stroke-color 0.4s ease;
  }
  .pillar.is-active .p-ghost, .pillar:hover .p-ghost {
    opacity: 0.85;
    -webkit-text-stroke-color: color-mix(in srgb, var(--c) 65%, transparent);
  }
  /* Label as a green mono eyebrow. */
  .pillar .p-num {
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c);
    transition: color 0.3s;
    white-space: normal;
    overflow-wrap: anywhere;
    /* Keep the label clear of the ghost number in the corner. */
    padding-right: 64px;
  }
  :global([data-theme="light"]) .pillar:nth-child(1) { --ct: #1f6b3b; }
  :global([data-theme="light"]) .pillar:nth-child(2) { --ct: #245a9b; }
  :global([data-theme="light"]) .pillar:nth-child(3) { --ct: #704091; }
  :global([data-theme="light"]) .pillar .p-num,
  :global([data-theme="light"]) .pillar .p-sub .accent-text { color: var(--ct, var(--c)); }
  .pillar .p-lead {
    font-size: 17px;
    line-height: 1.45;
    color: var(--ink);
    margin-top: 14px;
    letter-spacing: -0.01em;
  }
  .pillar .p-lead b { font-weight: 500; }
  .pillar .p-sub { margin-top: auto; padding-top: 16px; font-size: 14px; }
  .pillar .p-sub .accent-text { color: var(--c); }
  @media (prefers-reduced-motion: reduce) {
    .pillar::before { transition: none; }
  }

  /* Rotating wheel: infinite marquee of service chips, styled as flat mono tags. */
  .svc-wheel {
    margin-top: 24px;
    position: relative;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .svc-track {
    display: flex;
    width: max-content;
    gap: 10px;
    animation: svc-scroll 42s linear infinite;
  }
  .svc-wheel:hover .svc-track { animation-play-state: paused; }
  .svc-chip {
    flex: none;
    padding: 7px 14px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    white-space: nowrap;
    color: var(--ink-dim);
    border: 1px solid var(--line);
    background: var(--bg-2);
  }
  @keyframes svc-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .svc-track { animation: none; }
    .svc-wheel { overflow-x: auto; }
  }
  @media (max-width: 900px) {
    .pillars { grid-template-columns: 1fr; gap: 16px; }
    .pillar { padding: 24px; }
  }
  /* Phones: condense the three pillars so they don't eat the screen. */
  @media (max-width: 600px) {
    .pillars { margin-top: 26px; gap: 12px; }
    .pillar { padding: 18px 18px; }
    .pillar .p-num { font-size: 12px; letter-spacing: 0.1em; padding-right: 52px; }
    .pillar .p-ghost { font-size: 60px; top: 10px; right: 14px; }
    .pillar .p-lead {
      font-size: 14.5px;
      line-height: 1.4;
      margin-top: 8px;
    }
    .pillar .p-sub { padding-top: 12px; font-size: 13px; }
  }
  @media (max-width: 900px) {
    .svc-track { animation-duration: 28s; }
  }

  /* Before / after comparison. */
  .compare {
    margin-top: 40px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    gap: 20px;
  }
  .cmp-vs {
    align-self: center;
    justify-self: center;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--line));
    background: var(--bg);
    box-shadow: 0 0 0 6px var(--bg), 0 4px 18px color-mix(in srgb, #000 24%, transparent);
    font-family: var(--mono);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--accent-text);
  }
  /* Cooler reveal: the two cards fly in from opposite sides and settle. */
  .compare.stagger-group > * {
    opacity: 0;
    transition: opacity 0.6s ease, transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .compare.stagger-group > .cmp-without { transform: translateX(-36px) scale(0.97); }
  .compare.stagger-group > .cmp-with { transform: translateX(36px) scale(0.97); }
  /* Keep the VS badge visible regardless of reveal state. */
  .compare.stagger-group > .cmp-vs { opacity: 1; }
  .compare.stagger-group.in > * { opacity: 1; transform: none; }
  .compare.stagger-group.in > .cmp-with { transition-delay: 0.12s; }
  @media (prefers-reduced-motion: reduce) {
    .compare.stagger-group > * { opacity: 1; transform: none; transition: none; }
  }
  .cmp-col {
    --c: var(--ink-dim);
    position: relative;
    padding: 28px 30px;
    border: 1px solid color-mix(in srgb, var(--c) 34%, var(--line));
    background: var(--bg-2);
    overflow: hidden;
  }
  /* Top accent bar, matching the value pillars. */
  .cmp-col::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--c);
    opacity: 0.8;
  }
  /* Soft corner wash of the card's colour. */
  .cmp-col::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 90% at 0% 0%,
      color-mix(in srgb, var(--c) 12%, transparent), transparent 55%);
    pointer-events: none;
  }
  .cmp-col > * { position: relative; z-index: 1; }
  .cmp-with {
    --c: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--accent) 14%, transparent),
      0 8px 40px color-mix(in srgb, var(--accent) 10%, transparent);
  }
  .cmp-with .cmp-tag { color: var(--accent-text); }
  .cmp-without { --c: color-mix(in srgb, var(--ink-dim) 55%, transparent); }
  .cmp-head { display: flex; flex-direction: column; gap: 4px; margin-bottom: 20px; }
  .cmp-tag {
    font-family: var(--mono);
    font-size: 22px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--c);
  }
  .cmp-tag { display: inline-flex; align-items: center; gap: 10px; }
  .cmp-logo { width: 40px; height: 40px; object-fit: contain; vertical-align: middle; }
  .cmp-without .cmp-tag { color: var(--ink-dim); }
  .cmp-col ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .cmp-col li {
    position: relative;
    padding-left: 30px;
    font-size: 17px;
    line-height: 1.5;
    color: var(--ink);
  }
  .cmp-col li::before {
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--mono);
    font-size: 16px;
  }
  .cmp-without li { color: var(--ink-dim); }
  .cmp-without li::before { content: "✕"; color: color-mix(in srgb, var(--ink-dim) 80%, transparent); }
  .cmp-with li::before { content: "✓"; color: var(--accent); }
  @media (max-width: 720px) {
    .compare { grid-template-columns: 1fr; gap: 12px; }
    .cmp-col { padding: 18px 18px; }
    .cmp-head { margin-bottom: 14px; }
    .cmp-tag { font-size: 17px; letter-spacing: 0.04em; gap: 8px; }
    .cmp-logo { width: 30px; height: 30px; }
    .cmp-col ul { gap: 9px; }
    .cmp-col li { font-size: 14px; padding-left: 24px; line-height: 1.4; }
    .cmp-col li::before { font-size: 13px; }
  }

  /* Trust line under the App Store callout: pre-empts the "is this safe?" objection. */
  .appstore-trust {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 4px 0 8px;
    font-size: 14px;
    color: var(--ink-dim);
    letter-spacing: 0.01em;
  }
  .appstore-trust .at-badge {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px;
    border: 1px solid var(--accent);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .appstore-trust .at-badge::before {
    content: "✓";
    font-size: 12px;
  }
  @media (max-width: 640px) {
    .appstore-trust { align-items: flex-start; margin-top: 4px; }
  }

  /* Terminal print-in: lines appear one after another like live output when the
     How-it-works section scrolls into view (JS toggles .printing). */
  .term-type > div { opacity: 0; transform: translateY(2px); }
  .term-type.printing > div {
    opacity: 1;
    transform: none;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  .term-type.printing > div:nth-child(1)  { transition-delay: 0.10s; }
  .term-type.printing > div:nth-child(2)  { transition-delay: 0.22s; }
  .term-type.printing > div:nth-child(3)  { transition-delay: 0.30s; }
  .term-type.printing > div:nth-child(4)  { transition-delay: 0.42s; }
  .term-type.printing > div:nth-child(5)  { transition-delay: 0.54s; }
  .term-type.printing > div:nth-child(6)  { transition-delay: 0.64s; }
  .term-type.printing > div:nth-child(7)  { transition-delay: 0.74s; }
  .term-type.printing > div:nth-child(8)  { transition-delay: 0.82s; }
  .term-type.printing > div:nth-child(9)  { transition-delay: 0.94s; }
  .term-type.printing > div:nth-child(10) { transition-delay: 1.06s; }
  .term-type.printing > div:nth-child(11) { transition-delay: 1.18s; }
  @media (prefers-reduced-motion: reduce) {
    .term-type > div { opacity: 1; transform: none; transition: none; }
  }

  /* Install card — one focused curl line with a direct copy button. */
  .install-body { padding: 28px 24px; display: flex; flex-direction: column; gap: 16px; }
  .install-caption {
    font-family: var(--sans);
    font-size: 15px;
    /* Terminal stays dark in both themes — use a light muted tone. */
    color: #b8b6ac;
    letter-spacing: -0.01em;
  }
  .install-copy {
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
    text-align: left;
    cursor: pointer;
    font-family: var(--mono);
    font-size: clamp(13px, 1.3vw, 15px);
    /* The card sits in a terminal that stays dark in both themes, so use the
       terminal's light palette (not var(--ink), which vanishes in light mode). */
    color: #eceae3;
    background: color-mix(in srgb, #fff 6%, transparent);
    border: 1px solid color-mix(in srgb, #fff 14%, transparent);
    border-radius: 0;
    padding: 14px 16px;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .install-copy:hover { border-color: color-mix(in srgb, var(--accent) 55%, transparent); }
  .install-copy .ic-cmd { flex: 1; min-width: 0; overflow-x: auto; white-space: nowrap; }
  /* Terminal syntax colours for the command (the .c/.y classes only target
     .term-body elsewhere, so re-declare them for the install card). */
  .install-copy .ic-cmd .c { color: #8a8a83; }
  .install-copy .ic-cmd .y { color: #eceae3; }
  .install-copy .ic-label {
    flex: none;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--line));
  }
  .install-copy.is-copied .ic-label {
    color: var(--accent-ink);
    background: var(--accent);
    border-color: var(--accent);
  }
  /* "or" divider between the curl install and the tell-your-agent prompt. */
  .install-or {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8a8a83;
  }
  .install-or::before, .install-or::after {
    content: "";
    flex: 1;
    height: 1px;
    background: color-mix(in srgb, #fff 14%, transparent);
  }
  .install-tell { display: flex; flex-direction: column; gap: 12px; }
  .install-tell-cap {
    font-family: var(--sans);
    font-size: 15px;
    color: #b8b6ac;
    letter-spacing: -0.01em;
  }
  /* The prompt reads as natural language, not a shell command. */
  .install-tell-btn .ic-cmd { color: var(--accent); white-space: normal; }

  /* Reusable staggered child reveal (vs columns, how-steps, economy, cards).
     The parent section's .reveal handles the rise; children add a staggered
     fade + micro-scale so groups animate in sequence, not all at once. JS
     toggles .in via the same scroll observer. */
  .stagger-group > * {
    opacity: 0;
    transform: scale(0.985);
    transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .stagger-group.in > * { opacity: 1; transform: none; }
  .stagger-group.in > *:nth-child(1) { transition-delay: 0.04s; }
  .stagger-group.in > *:nth-child(2) { transition-delay: 0.16s; }
  .stagger-group.in > *:nth-child(3) { transition-delay: 0.28s; }
  .stagger-group.in > *:nth-child(4) { transition-delay: 0.40s; }
  @media (prefers-reduced-motion: reduce) {
    .stagger-group > * { opacity: 1; transform: none; transition: none; }
  }

  /* The agent economy block. */
  .econ-intro {
    max-width: 60ch;
    margin: -24px 0 36px;
    font-size: 18px;
    line-height: 1.5;
    color: var(--ink-dim);
  }
  .econ-intro b { color: var(--ink); font-weight: 600; }
  .econ-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
    border: 1px solid var(--line);
    padding: 48px;
  }
  .econ-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .econ-lede {
    font-family: var(--sans);
    font-size: 21px;
    line-height: 1.45;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .econ-lede b { font-weight: 600; }
  .econ-link {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-text);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .econ-link:hover { text-decoration: underline; }
  .econ-figure {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-left: 48px;
    border-left: 1px solid var(--line);
  }
  .econ-big {
    font-family: var(--sans);
    font-size: clamp(44px, 5vw, 68px);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 0.95;
    color: var(--accent-text);
  }
  .econ-cap { font-size: 15px; color: var(--ink); max-width: 22ch; }
  .econ-src { font-family: var(--mono); font-size: 12px; color: var(--ink-dim); }

  /* Wallet app card (replaces the old stat figure). */
  .econ-wallet {
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease;
  }
  .econ-wallet:hover { border-left-color: var(--accent); }
  .econ-wallet-icon {
    width: 96px; height: 96px; border-radius: 20px; display: block;
    background: #fff;
    object-fit: contain;
    object-position: center;
    padding: 14px;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, #000 8%, transparent);
  }
  .econ-wallet-name {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 28px;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-top: 4px;
  }
  /* What the wallet lets agents do — in Pilot green. */
  .econ-wallet-list {
    list-style: none; margin: 4px 0 0; padding: 0;
    display: flex; flex-direction: column; gap: 10px;
  }
  .econ-wallet-list li {
    font-family: var(--sans);
    font-size: 18px;
    line-height: 1.45;
    color: var(--accent-text);
    padding-left: 22px;
    position: relative;
  }
  .econ-wallet-list li::before {
    content: "•";
    position: absolute; left: 0;
    color: var(--accent-text);
  }
  @media (max-width: 860px) {
    .econ-grid { grid-template-columns: 1fr; gap: 36px; padding: 32px 24px; }
    .econ-figure { padding-left: 0; border-left: 0; padding-top: 32px; border-top: 1px solid var(--line); }
  }

  /* Developers — "Advertise to agents" band. */
  .econ-dev {
    margin-top: 40px;
    position: relative;
    overflow: hidden;
    padding: 28px 32px;
    border-radius: 0;
    border: 1px solid color-mix(in srgb, var(--accent) 34%, transparent);
    background:
      radial-gradient(120% 140% at 100% 0%, color-mix(in srgb, var(--accent) 16%, transparent) 0%, transparent 55%),
      color-mix(in srgb, var(--bg-2) 60%, transparent);
    box-shadow:
      0 10px 40px color-mix(in srgb, #000 24%, transparent),
      inset 0 1px 0 color-mix(in srgb, #fff 10%, transparent);
  }
  /* Faint dotted grid texture behind the band — reads as "built", not templated. */
  .econ-dev::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(color-mix(in srgb, var(--accent) 22%, transparent) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: linear-gradient(105deg, #000 0%, transparent 60%);
    -webkit-mask-image: linear-gradient(105deg, #000 0%, transparent 60%);
    opacity: 0.5;
    pointer-events: none;
  }
  .econ-dev > * { position: relative; z-index: 1; }
  .econ-dev-main { display: flex; flex-direction: column; align-items: flex-start; }
  .econ-dev-kicker {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .econ-dev-title {
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(26px, 3vw, 36px);
    letter-spacing: -0.035em;
    line-height: 1;
    margin: 10px 0 0;
    color: var(--ink);
  }
  .econ-dev-lede {
    font-family: var(--sans);
    font-size: 17px;
    line-height: 1.5;
    color: var(--ink-dim);
    letter-spacing: -0.01em;
    max-width: none;
    margin: 14px 0 0;
  }
  .econ-dev-lede b { font-weight: 600; color: var(--ink); }
  /* Two CTAs side by side: filled "Publish", outlined "Contact us". */
  .econ-dev-ctas {
    margin-top: 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .econ-dev-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--sans);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.01em;
    color: var(--accent-ink);
    background: var(--accent);
    padding: 12px 22px;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 6px 20px color-mix(in srgb, var(--accent) 34%, transparent);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease, background 0.18s ease;
  }
  .econ-dev-cta .arr { transition: transform 0.18s ease; }
  .econ-dev-cta:hover { transform: translateY(-2px); box-shadow: 0 10px 28px color-mix(in srgb, var(--accent) 44%, transparent); }
  .econ-dev-cta:hover .arr { transform: translateX(4px); }
  /* Secondary "Contact us" — outlined, no fill. */
  .econ-dev-cta-alt {
    color: var(--ink);
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--accent) 55%, var(--line));
    box-shadow: none;
  }
  .econ-dev-cta-alt:hover {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    box-shadow: none;
  }
  /* Live-stat anchor on the right. */
  .econ-dev-stat {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: 26px 28px;
    border-radius: 0;
    border: 1px solid color-mix(in srgb, var(--accent) 26%, transparent);
    background: color-mix(in srgb, #000 18%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
  @media (max-width: 860px) {
    .econ-dev { padding: 30px 24px; }
  }

  /* Pull the App Store callout up nearer the section's top divider line. */
  #thesis { padding-top: 64px; padding-bottom: 32px; }
  @media (max-width: 900px) { #thesis { padding-top: 40px; padding-bottom: 24px; } }
  @media (max-width: 640px) { #thesis { padding-top: 24px; } }
  .appstore-callout {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    margin-bottom: 20px;
    border-radius: 0;
    border: 1px solid color-mix(in srgb, var(--accent) 38%, transparent);
    /* Frosted glass: translucent fill + backdrop blur so the page shows through. */
    background: color-mix(in srgb, var(--bg-2) 55%, transparent);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    backdrop-filter: blur(18px) saturate(1.4);
    /* Soft outer lift + inner top-edge sheen for the glass highlight. */
    box-shadow:
      0 8px 32px color-mix(in srgb, #000 22%, transparent),
      inset 0 1px 0 color-mix(in srgb, #fff 14%, transparent),
      inset 0 0 0 1px color-mix(in srgb, #fff 4%, transparent);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, background 0.2s, box-shadow 0.2s, transform 0.2s;
  }
  .appstore-callout > * { position: relative; z-index: 1; }

  /* ---- Mobile scroll performance ----------------------------------------
     backdrop-filter re-blurs whatever is behind these cards on every scroll
     frame, which stutters on touch GPUs. On touch devices swap the frosted
     glass for a near-solid fill and stop the expensive rotating conic blur.
     Desktop (fine pointer) keeps the live glass effect. */
  @media (hover: none) and (pointer: coarse) {
    .pillar,
    .appstore-callout {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      background: color-mix(in srgb, var(--bg-2) 94%, var(--bg));
    }
    /* The App Store callout's rotating conic-gradient "spotlight" (blur 40px)
       repaints continuously — pause it on touch devices. */
    .ac-featured::before { animation: none; }
  }
  /* MCP section — harness logo row + typewriter cursor. */
  .mcp-harnesses {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }
  .mcp-hn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 9px 14px 9px 11px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 15px;
    letter-spacing: 0.02em;
    color: var(--ink);
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  /* On hover, wash the chip in the logo's own brand colour. */
  .mcp-hn:hover {
    border-color: color-mix(in srgb, var(--logo-color, var(--accent)) 55%, var(--line));
    background: color-mix(in srgb, var(--logo-color, var(--accent)) 8%, transparent);
  }
  /* Real brand logos as masks, each tinted with its own brand colour. */
  .mcp-hn-i {
    width: 24px; height: 24px; flex: none;
    background: var(--logo-color, currentColor);
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
  }
  /* MCP section — larger, more value-oriented copy. */
  #mcp .how-lede { font-size: clamp(26px, 2.8vw, 38px); }
  #mcp .how-grid > div:last-child p { font-size: 20px; line-height: 1.5; }
  /* Director: scale the left-hand copy up so it reads proportional to the TUI,
     and centre it vertically against the taller terminal. */
  #director .how-grid { align-items: center; }
  #director .how-lede { font-size: clamp(26px, 2.8vw, 38px); margin-bottom: 22px; }
  #director .how-grid > div:first-child p { font-size: 20px; line-height: 1.55; }
  #director .how-grid > div:first-child p a { font-size: 19px; }
  /* Reserve height so the box doesn't collapse/jump while the lines type in. */
  .term-body[data-mcp-term] { min-height: 9.6em; }
  .tw-cursor {
    display: inline-block;
    width: 0.62em;
    height: 1.05em;
    margin-left: 1px;
    transform: translateY(0.16em);
    background: var(--accent);
    animation: tw-blink 1.05s steps(1) infinite;
  }
  @keyframes tw-blink { 0%, 50% { opacity: 1; } 50.01%, 100% { opacity: 0; } }

  .mom-name-hl { letter-spacing: 0.02em; }

  /* Thesis body paragraphs slide in from the right on scroll-into-view. */
  #thesis-copy .body {
    opacity: 0;
    transform: translateX(56px);
    transition: opacity 0.6s ease, transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  #thesis-copy.visible .body { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    #thesis-copy .body { opacity: 1; transform: none; transition: none; }
  }

  /* ===== Standardised vertical rhythm across all homepage sections ========
     .section#id beats the plain #id overrides scattered above, so every
     section gets the same top/bottom breathing room. Hero is excluded. */
  .section#thesis, .section#agent-value, .section#thesis-copy, .section#mcp,
  .section#numbers, .section#stack, .section#economy, .section#how,
  .section#director, .section#paths {
    padding-top: 60px;
    padding-bottom: 60px;
  }
  @media (max-width: 900px) {
    .section#thesis, .section#agent-value, .section#thesis-copy, .section#mcp,
    .section#numbers, .section#stack, .section#economy, .section#how,
    .section#director, .section#paths {
      padding-top: 44px;
      padding-bottom: 44px;
    }
  }

  #stack { padding-top: 40px; padding-bottom: 32px; }
  @media (max-width: 900px) { #stack { padding-top: 28px; padding-bottom: 24px; } }
  #economy { padding-top: 32px; padding-bottom: 32px; }
  @media (max-width: 900px) { #economy { padding-top: 24px; padding-bottom: 24px; } }
  #how { padding-top: 32px; }
  @media (max-width: 900px) { #how { padding-top: 24px; } }
  /* ===== The Stack — vertical: on-top layers → Pilot (highlighted) → base === */
  #stack .stack.stack-v {
    display: flex;
    flex-direction: column;
    gap: 16px;
    border: 0;
    grid-template-columns: none;
    max-width: 860px;
    margin: 0 auto;
  }
  /* A stronger, more defined outline colour for the tiers. */
  #stack .stack-v { --sv-edge: color-mix(in srgb, var(--ink) 28%, transparent); }
  /* Reuse the .layer scroll-in animation but slide up (not sideways). */
  #stack .stack-v .layer {
    min-height: 0;
    border: 0;
    padding: 0;
    background: none;
    transform: translateY(24px) scale(0.99);
    border-radius: 0;
  }
  #stack .stack-v.layers-in .layer { transform: none; }

  /* On-top tier: caption + a row of framed chips. */
  #stack .sv-over {
    background: var(--bg-2);
    border: 1.5px solid var(--sv-edge) !important;
    padding: 24px 26px !important;
  }
  #stack .sv-cap {
    font-family: var(--mono);
    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--ink-dim); margin-bottom: 16px;
  }
  #stack .sv-over-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  @media (max-width: 640px) { #stack .sv-over-grid { grid-template-columns: 1fr; } }
  #stack .sv-chip {
    display: flex; flex-direction: column; gap: 5px;
    background: var(--bg);
    border: 1.5px solid var(--sv-edge);
    border-radius: 12px;
    padding: 16px 18px;
    transition: border-color 0.15s ease;
  }
  #stack .sv-chip:hover { border-color: color-mix(in srgb, var(--accent) 50%, var(--sv-edge)); }
  #stack .sv-chip b { font-weight: 600; font-size: 17px; color: var(--ink); }
  #stack .sv-chip span { font-family: var(--mono); font-size: 11.5px; color: var(--ink-dim); }

  /* Connector cue between the tiers. */
  #stack .sv-connector {
    text-align: center;
    font-family: var(--mono);
    font-size: 12px; letter-spacing: 0.08em;
    color: var(--accent-text);
    padding: 0;
  }

  /* Pilot tier — the emphasized green band with a defined bright edge. */
  #stack .sv-pilot {
    position: relative;
    background: linear-gradient(180deg, var(--accent), color-mix(in srgb, var(--accent) 84%, #000)) !important;
    color: var(--accent-ink);
    padding: 30px 30px !important;
    border: 1.5px solid color-mix(in srgb, var(--accent) 70%, #fff) !important;
    box-shadow: 0 12px 46px color-mix(in srgb, var(--accent) 32%, transparent);
  }
  #stack .sv-badge {
    position: absolute; top: 20px; right: 24px;
    font-family: var(--mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase;
    background: var(--accent-ink); color: var(--accent);
    padding: 5px 12px; border-radius: 999px;
  }
  #stack .sv-pilot .sv-l { font-family: var(--mono); font-size: 12px; letter-spacing: 0.06em; opacity: 0.85; }
  #stack .sv-pilot .sv-n { font-family: var(--sans); font-weight: 600; font-size: clamp(28px, 3.6vw, 38px); letter-spacing: -0.02em; margin-top: 8px; }
  #stack .sv-pilot .sv-d { font-size: 16.5px; line-height: 1.5; opacity: 0.94; margin-top: 10px; max-width: 60ch; }
  /* Mobile: the "You are here" badge is absolutely positioned and overlaps the
     title on narrow screens — let it flow inline above the content instead. */
  @media (max-width: 600px) {
    #stack .sv-badge {
      position: static;
      display: inline-block;
      margin-bottom: 12px;
    }
  }

  /* Foundation tier — muted base. */
  /* Shared-transport tier — matches the blue "shared transport" legend swatch. */
  #stack .sv-base {
    background: color-mix(in srgb, #6ea8ff 6%, var(--bg-2));
    border: 1.5px solid color-mix(in srgb, #6ea8ff 55%, transparent) !important;
    padding: 22px 26px !important;
  }
  #stack .sv-base .sv-l { font-family: var(--mono); font-size: 12px; color: #6ea8ff; }
  :global([data-theme="light"]) #stack .sv-base .sv-l { color: #245a9b; }
  #stack .sv-base .sv-n { font-weight: 600; font-size: 19px; color: var(--ink); margin-top: 5px; }
  #stack .sv-base .sv-d { font-size: 14px; color: var(--ink-dim); margin-top: 5px; }

  /* ===== Network stats — tighter, grouped, less negative space ============ */
  #numbers .stats {
    gap: 0;
    border-radius: 0;
    overflow: hidden;
  }
  #numbers .stat {
    min-height: 0;
    justify-content: flex-start;
    gap: 10px;
    padding: 40px 40px 38px;
  }
  /* Small green header row (dot + label) sits above the big number. */
  #numbers .stat-top {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  #numbers .stat-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
    animation: mom-pulse 1.6s ease-in-out infinite;
  }
  #numbers .stat .big {
    font-size: clamp(52px, 6.4vw, 92px);
    line-height: 0.92;
    margin-top: 4px;
  }
  /* Tint the number with a subtle vertical accent gradient for depth. */
  #numbers .stat .big {
    background: linear-gradient(180deg, var(--ink) 0%, color-mix(in srgb, var(--ink) 78%, var(--accent)) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  #numbers .stat .lbl {
    font-size: 16px;
    color: var(--ink-dim);
    letter-spacing: -0.005em;
  }

  /* ===== MOM terminal — animated planning demo ============================ */
  /* Green outline + glow around the whole shell. */
  /* .mom-shell inherits the shared green rounded .term styling (system.css). */
  .mom-clock {
    color: var(--accent);
    font-weight: 600;
    display: inline-flex; align-items: center; gap: 6px;
  }
  .mom-clock::before {
    content: ""; width: 7px; height: 7px; border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    animation: mom-pulse 1.4s ease-in-out infinite;
  }
  @keyframes mom-pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }

  .term-body.mom-term {
    min-height: 13.5em;
    font-size: clamp(12.5px, 1.1vw, 15px);
    line-height: 1.55;
    padding: 22px 20px;
  }
  /* Emitted rows fade + slide + un-blur in. JS adds .in on the next frame. */
  .mom-term .mom-row {
    opacity: 0;
    transform: translateY(9px) scale(0.99);
    filter: blur(3px);
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.22, 0.61, 0.36, 1), filter 0.4s ease;
  }
  .mom-term .mom-row.in { opacity: 1; transform: none; filter: none; }
  .mom-term .mom-spacer { height: 0.5em; }

  /* Query line. */
  .mom-term .mom-prompt { color: var(--accent); font-weight: 700; }
  .mom-term .mom-cmd { color: #f2b45a; font-weight: 700; }
  .mom-term .mom-query { color: #f4f2ec; }
  /* Rest of the real CLI: subcommand/agent dim-white, --wait flag muted. */
  .mom-term .mom-flag { color: #cfcdc4; }
  .mom-term .mom-wait { color: #7d7d76; }

  /* Thinking + plan header. Give the plan header room before the steps. */
  .mom-term .mom-think { color: #cfcdc4; }
  .mom-term .mom-think.is-plan { margin-bottom: 10px; }
  .mom-term .mom-ok { color: var(--accent); font-weight: 700; }
  .mom-term .mom-ach { color: var(--accent); font-weight: 600; }
  .mom-term .mom-spin { display: inline-block; width: 1.1em; color: var(--accent); }

  /* A plan step: badge/logo on the left (flex); to its right a column with the
     name+pill row on top and the description beneath. Flex + a wrapper make the
     spacing structural, so it can never render glued together. */
  .mom-term .mom-step {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 6px 0;
  }
  .mom-term .mom-main { flex: 1; min-width: 0; }
  .mom-term .mom-head {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  /* Explicit margin as a fallback in case flex `gap` doesn't apply, so the
     name and pill are never glued together. */
  .mom-term .mom-head > * + * { margin-left: 10px; }
  /* Steps are spaced by padding; no divider line needed between them. */
  .mom-term .mom-step + .mom-step {
    padding-top: 8px;
  }
  .mom-term .mom-n {
    display: inline-flex; align-items: center; justify-content: center;
    width: 1.9em; height: 1.9em;
    border-radius: 50%;
    color: #0b0b0a; font-weight: 800; font-size: 0.82em;
    flex: none;
    background: var(--sc, var(--accent));
    box-shadow: 0 0 14px color-mix(in srgb, var(--sc, var(--accent)) 55%, transparent);
  }
  .mom-term .mom-ico {
    width: 1.9em; height: 1.9em;
    border-radius: 7px;
    object-fit: cover; flex: none;
    box-shadow: 0 0 14px color-mix(in srgb, var(--sc, var(--accent)) 45%, transparent);
  }
  .mom-term .mom-name {
    color: var(--sc, #f4f2ec);
    font-weight: 600;
  }
  /* Highlighted tool names get a tinted pill in the step's own colour. */
  .mom-term .mom-step.is-hl .mom-name {
    padding: 2px 10px;
    border-radius: 6px;
    background: color-mix(in srgb, var(--sc, var(--accent)) 20%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--sc, var(--accent)) 55%, transparent);
  }
  .mom-term .mom-pill {
    font-size: 0.66em;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    padding: 3px 11px;
    border-radius: 999px;
    font-weight: 700;
    flex: none;
    white-space: nowrap;
    color: var(--sc, var(--accent));
    background: color-mix(in srgb, var(--sc, var(--accent)) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--sc, var(--accent)) 55%, transparent);
  }
  .mom-term .mom-desc {
    margin-top: 4px;
    color: #9a9a92;
    font-size: 0.92em;
    line-height: 1.4;
  }
  /* Plan-key labels ("calls" / "handoff") that head each group of steps. */
  .mom-term .mom-section {
    color: #7d7d76;
    font-size: 0.78em;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    margin: 10px 0 2px;
  }
  /* Step descriptions that are literal pilotctl commands. */
  .mom-term .mom-code {
    font-family: var(--mono);
    font-size: 0.85em;
    color: #8f8f88;
    word-break: break-word;
  }
  /* Success banner — the task is done, so make it clearly stand out. */
  .mom-term .mom-done {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 1.1em;
    padding: 12px 16px;
    border-radius: 10px;
    color: var(--accent);
    font-weight: 700;
    font-size: 1.02em;
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 55%, transparent);
    box-shadow: 0 0 26px color-mix(in srgb, var(--accent) 24%, transparent);
  }
  /* Circular check chip at the start of the banner. */
  .mom-term .mom-done::before {
    content: "✓";
    display: inline-flex; align-items: center; justify-content: center;
    width: 1.5em; height: 1.5em;
    flex: none;
