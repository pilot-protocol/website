    text-decoration: none;
    transition: filter 0.15s ease;
  }
  .ac-devstrip:hover { filter: brightness(1.05); }
  .ads-copy { font-size: 18px; letter-spacing: -0.01em; }
  .ads-copy b { font-weight: 600; }
  .ads-btn {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #0b0b0a;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 500;
    padding: 10px 18px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .ac-devstrip:hover .ads-btn .arr { transform: translateX(3px); }
  .ads-btn .arr { transition: transform 0.15s ease; }
  /* Left column: eyebrow → heading → sub → floating icon rail, stacked and
     left-aligned. Takes the room the featured panel doesn't. */
  .ac-top {
    flex: 1 1 auto;
    min-width: 0;
    /* Stretch to the full height of the callout and centre content, so the whole
       left side is clickable — not just the text box. */
    align-self: stretch;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 18px;
    text-decoration: none;
    color: inherit;
