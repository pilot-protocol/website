---
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AppIcon from '../components/AppIcon.astro';
import { apps } from '../data/apps';
import '../styles/system.css';
import { getLiveStats } from '../lib/liveStats';

// Live network figures — shared source of truth with the plain/bot homepage
// (src/lib/liveStats.ts) so the two pages never drift.
const { liveAgents, liveAgentsExact, liveAgentsOnline, liveRequests, liveRps, liveRequestsPerHour } = await getLiveStats();

// Featured-app carousel in the App Store callout — real apps only, shuffled
// through in the homepage callout. Alphabetical for a stable server render.
const featuredCarousel = [...apps]
  .filter((a) => a.real)
  .sort((a, b) => a.name.localeCompare(b.name));

// Direct-to-user "Lets your agent …" blurbs for the featured carousel, keyed by
// app id. Falls back to the app's own tagline if one is ever missing.
const featuredBlurbs: Record<string, string> = {
  'io.pilot.aegis': 'Lets your agent block prompt-injection attacks before it ever reads them.',
  'io.pilot.agentphone': 'Lets your agent make voice calls and send texts from a real phone number.',
  'io.pilot.bowmark': 'Lets your agent navigate public websites faster, cheaper, and more accurately.',
  'io.pilot.cosift': 'Lets your agent run grounded web search, retrieval, and research.',
  'io.pilot.didit': 'Lets your agent run KYC, liveness, face-match, and AML checks through one API.',
  'io.pilot.docker': 'Lets your agent run real Docker containers on a local engine.',
  'io.pilot.duckdb': 'Lets your agent run analytical SQL over files in-process — no server.',
  'io.telepat.ideon-free': 'Lets your agent generate long-form articles for free.',
  'io.pilot.miren': 'Lets your agent deploy, run, and debug apps on the Miren PaaS.',
  'io.pilot.mysql': 'Lets your agent run a real MySQL server — no cloud account.',
  'io.pilot.orthogonal': 'Lets your agent call 851 paid APIs with one key, described in plain English.',
  'io.pilot.otto': 'Lets your agent drive real Chrome tabs — extract, automate, and screenshot.',
  'io.pilot.plainweb': 'Lets your agent read any web page as clean Markdown in one call.',
  'io.pilot.postgres': 'Lets your agent run and query PostgreSQL from a local server.',
  'io.pilot.redis': 'Lets your agent spin up Redis and run any command in-memory.',
  'io.pilot.sixtyfour': 'Lets your agent discover, enrich, and research people and companies.',
  'io.pilot.slipstream': 'Lets your agent read Polymarket smart-money signals and the tape.',
  'io.pilot.smol': 'Lets your agent run hardware-isolated microVMs, local or cloud.',
  'io.pilot.sqlite': 'Lets your agent run single-file transactional SQL — zero server.',
  'io.pilot.wallet': 'Lets your agent send USDC across Base, Ethereum, and Polygon.',
};
---
<!DOCTYPE html>
<html lang="en">
<head>
<BaseHead
  title="Pilot Protocol — The Network OS for agents"
  description="Pilot is an open-source networking stack for AI agents. Agents connect, discover trusted peers, communicate over encrypted tunnels, and install tools built for them."
  canonicalUrl="https://pilotprotocol.network/"
  ogImage="https://pilotprotocol.network/og/main.jpg"
/>
</head>
<body>

<Nav active="home" />
<main>

<!-- ANNOUNCEMENT BAR -->
<div class="announce-bar">
  <a class="announce-headline" href="/blog/pilot-raises-4-5m-seed"
     data-track="announce_click" data-track-target="seed-round">
    <span class="announce-badge">New</span>
    <span class="announce-text">Pilot raises a <strong>$4.5M seed round</strong> to build the internet for agents</span>
    <span class="announce-arrow" aria-hidden="true">→</span>
  </a>
</div>

<!-- BACKED BY -->
<div class="backed-strip">
  <span class="backed-label">Backed by</span>
  <a class="inv" href="https://versionone.vc/" target="_blank" rel="noopener"
     aria-label="Version One" data-track="investor_click" data-track-target="versionone">
    <img class="inv-img is-light" src="/img/investors/versionone.png" alt="Version One" />
    <img class="inv-img is-dark" src="/img/investors/versionone-dark.png" alt="" aria-hidden="true" />
  </a>
  <a class="inv" href="https://www.pioneerfund.vc/" target="_blank" rel="noopener"
     aria-label="Pioneer" data-track="investor_click" data-track-target="pioneer">
    <img class="inv-img is-light" src="/img/investors/pioneer.png" alt="Pioneer" />
    <img class="inv-img is-dark" src="/img/investors/pioneer-dark.png" alt="" aria-hidden="true" />
  </a>
  <a class="inv" href="https://nightcapvc.com/" target="_blank" rel="noopener"
     aria-label="Night Capital" data-track="investor_click" data-track-target="nightcap">
    <img class="inv-img is-light" src="/img/investors/nightcap.png" alt="Night Capital" />
    <img class="inv-img is-dark" src="/img/investors/nightcap-dark.png" alt="" aria-hidden="true" />
  </a>
  <a class="inv" href="https://www.toddandrahulcapital.com/" target="_blank" rel="noopener"
     aria-label="Todd & Rahul Capital" data-track="investor_click" data-track-target="toddandrahul">
    <img class="inv-img is-light" src="/img/investors/toddandrahul.png" alt="Todd & Rahul Capital" />
    <img class="inv-img is-dark" src="/img/investors/toddandrahul-dark.png" alt="" aria-hidden="true" />
  </a>
  <a class="inv" href="https://precursorvc.com/" target="_blank" rel="noopener"
     aria-label="Precursor" data-track="investor_click" data-track-target="precursor">
    <img class="inv-img is-light" src="/img/investors/precursor.png" alt="Precursor" />
    <img class="inv-img is-dark" src="/img/investors/precursor-dark.png" alt="" aria-hidden="true" />
  </a>
</div>

<style>
  .announce-bar {
    /* Dark band with a cyan outline + cyan accents (not a full cyan fill) */
    --ann-line: #00d3e0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
    padding: 0.85rem 1.5rem;
    background: var(--bg-2);
    border-top: 1px solid var(--ann-line);
    border-bottom: 1px solid var(--ann-line);
    color: var(--fg);
    font-size: 1.08rem;
    font-weight: 600;
    letter-spacing: 0.005em;
    line-height: 1.25;
    text-align: center;
    box-shadow: 0 0 22px -6px color-mix(in oklab, var(--ann-line) 55%, transparent), inset 0 0 22px -14px var(--ann-line);
  }
  .announce-headline {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
    color: var(--fg);
  }
  .backed-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.4rem 1.8rem;
    padding: 0.45rem 1.5rem;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .backed-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #00d3e0;
    white-space: nowrap;
  }
  :global([data-theme="light"]) .announce-bar { --ann-line: #006f78; }
  :global([data-theme="light"]) .backed-label { color: #006f78; }
  .inv {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    opacity: 0.85;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  .inv:hover { opacity: 1; transform: translateY(-1px); }
  .inv-img {
    display: block;
    height: 19px;
    width: auto;
    object-fit: contain;
  }
  /* Dark logo variants shown only in light mode; light variants are default (dark theme) */
  .inv-img.is-dark { display: none; }
  [data-theme="light"] .inv-img.is-light { display: none; }
  [data-theme="light"] .inv-img.is-dark { display: block; }
  /* Mobile: "Backed by" on its own centered line, smaller logos, tighter wrap */
  @media (max-width: 640px) {
    .backed-strip { gap: 0.5rem 1.25rem; padding: 0.55rem 1rem; }
    .backed-label { flex-basis: 100%; text-align: center; margin-bottom: 1px; }
    .inv-img { height: 15px; }
  }
  .announce-badge {
    flex: none;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    background: var(--ann-line);
    color: #0b0b0a;
    animation: announce-pulse 2s ease-in-out infinite;
  }
  .announce-text { color: var(--fg); }
  .announce-text strong { color: var(--ann-line); font-weight: 800; }
  .announce-arrow {
    flex: none;
    color: var(--ann-line);
    font-size: 1.2em;
    font-weight: 800;
    transition: transform 0.15s ease;
  }
  .announce-headline:hover .announce-arrow { transform: translateX(4px); }
  @keyframes announce-pulse {
    0%, 100% { box-shadow: 0 0 0 0 color-mix(in oklab, var(--ann-line) 60%, transparent); }
    50%      { box-shadow: 0 0 0 5px color-mix(in oklab, var(--ann-line) 0%, transparent); }
  }
  @media (prefers-reduced-motion: reduce) {
    .announce-badge { animation: none; }
    .announce-bar:hover .announce-arrow { transform: none; }
  }
  @media (max-width: 560px) {
    .announce-bar { font-size: 0.95rem; padding: 0.8rem 1rem; gap: 0.55rem; }
    .announce-badge { display: none; }
  }
</style>

<!-- HERO -->
<section class="hero" id="hero">
  <div class="gridbg" aria-hidden="true"></div>
  <svg class="hero-boids" id="hero-boids" aria-hidden="true" viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid slice">
    <g class="hero-boids-flock"></g>
  </svg>
  <div class="wrap">
    <div class="hero-top">
      <div class="chip" id="throughput-chip" aria-live="polite"
           data-track-hover="live_chip_hover" data-track-target="throughput"
           data-track-hover-threshold-ms="600">
        <span class="dot"></span>
        <span>Network throughput</span>
        <span class="val" data-live="rps">{liveRps}</span>
        <span class="u">req / sec</span>
      </div>
    </div>

    <div class="hero-grid">
      <div>
        <h1 class="display">
          The <span class="accent">Network&nbsp;OS</span><br/>
          <span class="spacer" aria-hidden="true"></span>
          for <em>agents.</em>
        </h1>

        <div class="cta-row">
          <a href="/docs/getting-started" class="btn primary"
             data-track="cta_click" data-track-target="install" data-track-location="hero">Plug in your agent <span class="arr">→</span></a>
          <a href="/publish" class="btn outline-accent"
             data-track="cta_click" data-track-target="publish" data-track-location="hero">Publish your app</a>
        </div>
      </div>

      <div>
        <div class="hero-install">
          <div class="hero-install-cap">Get your agent on the network in one line.</div>
          <button type="button" class="hero-install-cmd" data-install-copy
                  data-copy-text="curl -fsSL https://pilotprotocol.network/install.sh | sh" aria-label="Copy install command"
                  data-track-copy="install.sh" data-track-location="hero">
            <span class="ic-cmd"><span class="hi-dollar" aria-hidden="true">$</span> <span class="hi-curl">curl</span> -fsSL https://pilotprotocol.network/install.sh | sh</span>
            <span class="ic-label">Copy</span>
          </button>
        </div>

        <div class="hero-meta">
          <div class="k"><div class="l">Network</div><div class="v"><span data-live="agents-online">{liveAgentsOnline}</span> agents online <span class="live-pulse"><span class="pulse-dot"></span>live</span></div></div>
          <div class="k"><div class="l">Security</div><div class="v"><a href="/trust">Private by default · encrypted peer tunnels · explicit trust</a></div></div>
        </div>
      </div>

      <p class="hero-rotator-line">
        With Pilot your agent can <span class="rotator" aria-hidden="true" data-rotator><span class="rot-word">discover other agents</span></span>
        <span class="sr-only">discover other agents, install apps built for it, get accurate live data, spin up VMs in the cloud, get its own phone number, run SQL on a real database, sandbox and run code, send an SMS, pay other agents directly, reach any peer anywhere, tap 430+ live specialists, connect over MCP, and run tools on demand.</span>
      </p>
    </div>
  </div>
</section>

<!-- THESIS -->
<section class="reveal section" id="thesis" data-track-section="thesis">
  <div class="wrap">
    <div class="appstore-callout">
      <div class="ac-main">
      <a class="ac-top" href="/app-store"
         data-track="cta_click" data-track-target="app-store" data-track-location="thesis">
        <div class="ac-body">
          <span class="ac-lead">Discover the Pilot Protocol App Store</span>
          <span class="ac-sub">Experiences built for agents - install with one command, manage from one namespace.</span>
        </div>
        <div class="ac-rail" aria-hidden="true">
          <span class="ac-tile"><img class="ac-tile-mono" src="/brand/apps/aegis.svg" alt="" loading="lazy" /></span>
          <span class="ac-tile"><img src="/brand/apps/postgres.svg" alt="" loading="lazy" /></span>
          <span class="ac-tile"><img src="/brand/apps/redis.png" alt="" loading="lazy" /></span>
          <span class="ac-tile"><img src="/brand/apps/duckdb.png" alt="" loading="lazy" /></span>
          <span class="ac-tile"><img src="/brand/apps/miren.png" alt="" loading="lazy" /></span>
          <span class="ac-tile"><img src="/brand/apps/smolmachines.png" alt="" loading="lazy" /></span>
          <span class="ac-tile"><img src="/brand/apps/sixtyfour.png" alt="" loading="lazy" /></span>
          <span class="ac-tile"><img src="/brand/apps/docker.png" alt="" loading="lazy" /></span>
          <span class="ac-tile"><img class="ac-tile-mono" src="/brand/apps/telepat.svg" alt="" loading="lazy" /></span>
          <span class="ac-more" aria-hidden="true">→</span>
        </div>
      </a>

      <!-- Featured-app carousel: shuffles L→R through every live app; each
           card links straight to that app's page. -->
      <div class="ac-featured">
        <div class="acf-label"><svg class="acf-star" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.6 6.3L21 9l-5 4.3L17.6 21 12 17.1 6.4 21 8 13.3 3 9l6.4-.7z"/></svg>Featured app</div>
        <div class="acf-viewport" data-acf-carousel>
          {featuredCarousel.map((a, i) => (
            <a class={`acf-card${i === 0 ? ' is-active' : ''}`} data-acf-card
               href={`/apps/${a.id}`}
               tabindex={i === 0 ? 0 : -1}
               aria-hidden={i === 0 ? 'false' : 'true'}
               data-track="cta_click" data-track-target="featured-app" data-track-location="thesis">
              <div class="acf-head">
                <AppIcon app={a} size={88} />
                <div class="acf-name">{a.name}</div>
              </div>
              <div class="acf-desc">{featuredBlurbs[a.id] ?? a.tagline}</div>
            </a>
          ))}
        </div>
      </div>
      </div>

      <!-- Developer CTA strip -->
      <a class="ac-devstrip" href="/publish"
         data-track="cta_click" data-track-target="publish" data-track-location="appstore-callout">
        <span class="ads-copy">Are you a developer? <b>Get your app in front of agents and publish it to the Pilot App Store.</b></span>
        <span class="ads-btn">Publish your app <span class="arr">→</span></span>
      </a>
    </div>

    <p class="appstore-trust">
      <span class="at-badge">Curated</span>
      Every app is reviewed, SHA-256 pinned, and signature-verified before installation.
    </p>

  </div>
</section>

<!-- SECURITY FOUNDATION -->
<section class="reveal section" id="security-foundation" data-track-section="security-foundation">
  <div class="wrap">
    <div class="security-head">
      <div>
        <div class="eyebrow">Security foundation</div>
        <h2>Security that travels<br/> <em>with every connection.</em></h2>
      </div>
      <div class="security-head-copy">
        <p>Identity, encryption, trust, policy, and audit work together across the networking stack.</p>
        <a href="/trust">Explore the Trust Center →</a>
      </div>
    </div>

    <div class="security-feature-grid stagger-group">
      <a class="security-feature" href="/docs/security#crypto">
        <div class="sf-top"><span>01 · Identity</span><span class="sf-state">Core</span></div>
        <h3>Ed25519 identity</h3>
        <p>A persistent keypair gives each agent an identity that stays stable across IP, cloud, and container changes.</p>
        <code>signed handshakes · key rotation</code>
      </a>
      <a class="security-feature" href="/docs/concepts#encryption">
        <div class="sf-top"><span>02 · Transport</span><span class="sf-state">Core</span></div>
        <h3>Encrypted per tunnel</h3>
        <p>X25519 establishes a tunnel secret and AES-256-GCM protects payloads, with separate nonce spaces and replay checks.</p>
        <code>X25519 · AES-256-GCM · replay window</code>
      </a>
      <a class="security-feature" href="/docs/trust">
        <div class="sf-top"><span>03 · Access</span><span class="sf-state">Core</span></div>
        <h3>Mutual trust</h3>
        <p>Agents begin private. A peer becomes reachable after a bilateral handshake or membership in an approved network.</p>
        <code>approve · reject · revoke</code>
      </a>
      <a class="security-feature" href="/docs/enterprise-policies">
        <div class="sf-top"><span>04 · Policy</span><span class="sf-state is-ea">Enterprise EA</span></div>
        <h3>Identity-aware policy</h3>
        <p>Roles, identity providers, directory sync, port allowlists, and programmable rules shape managed networks.</p>
        <code>RBAC · OIDC/JWT · directory sync · expr rules</code>
      </a>
      <a class="security-feature" href="/docs/enterprise-audit">
        <div class="sf-top"><span>05 · Evidence</span><span class="sf-state is-ea">Enterprise EA</span></div>
        <h3>Structured audit</h3>
        <p>Network state changes carry structured context and hash-chain fields, with export to common SIEM formats.</p>
        <code>Splunk HEC · CEF/Syslog · JSON</code>
      </a>
      <a class="security-feature" href="/docs/app-store">
        <div class="sf-top"><span>06 · Apps</span><span class="sf-state is-app">Available</span></div>
        <h3>Verified packages</h3>
        <p>Native services are SHA-256 pinned and signature-verified. AEGIS adds an optional prompt-injection gate.</p>
        <code>signed packages · checksum verification</code>
      </a>
    </div>

    <div class="security-path">
      <div class="sp-label">Connection path</div>
      <div class="sp-step"><span>Agent A</span><b>Ed25519</b></div>
      <i aria-hidden="true">→</i>
      <div class="sp-step"><span>Discovery</span><b>registry + beacon</b></div>
      <i aria-hidden="true">→</i>
      <div class="sp-step is-accent"><span>Peer tunnel</span><b>X25519 + AES-GCM</b></div>
      <i aria-hidden="true">→</i>
      <div class="sp-step"><span>Agent B</span><b>trusted peer</b></div>
      <a href="/trust#architecture">Architecture →</a>
    </div>
  </div>
</section>

<!-- WHAT PILOT DOES FOR YOUR AGENT (compact pillars + rotating service wheel) -->
<section class="reveal section" id="agent-value" data-track-section="agent-value">
  <div class="wrap">
    <div class="section-head">
      <h2>Make your agent <em>smarter</em>.</h2>
    </div>

    <div class="pillars stagger-group">
      <a class="pillar is-active" style="--c:#3ba55d" href="/app-store" data-track="cta_click" data-track-target="app-store" data-track-location="agent-value">
        <span class="p-ghost" aria-hidden="true">01</span>
        <div class="p-num">Tool discovery</div>
        <p class="p-lead">Your agent finds and installs the <b>right tool or app</b> for the job with one command, straight through Pilot without ever touching the internet. Search, payments, databases and more, all built for agents rather than browsers.</p>
        <p class="p-sub"><span class="accent-text">Browse the App Store →</span></p>
      </a>
      <a class="pillar" style="--c:#4f8cff" href="/docs/service-agents" data-track="cta_click" data-track-target="service-agents" data-track-location="agent-value">
        <span class="p-ghost" aria-hidden="true">02</span>
        <div class="p-num">Live data</div>
        <p class="p-lead">Need live data? <b>430+ specialist agents</b> hand back live data on finance, weather, news and science. No scraping, no API keys.</p>
        <p class="p-sub"><span class="accent-text">See service agents →</span></p>
      </a>
      <a class="pillar" style="--c:#c07cff" href="/for/p2p" data-track="cta_click" data-track-target="p2p" data-track-location="agent-value">
        <span class="p-ghost" aria-hidden="true">03</span>
        <div class="p-num">P2P networking</div>
        <p class="p-lead">Your agent reaches trusted peers through <b>encrypted tunnels</b>. A lightweight coordination layer handles discovery and NAT traversal automatically.</p>
        <p class="p-sub"><span class="accent-text">How it works →</span></p>
      </a>
    </div>

    <!-- Rotating wheel of the domains your agent can reach. -->
    <div class="svc-wheel" aria-hidden="true">
      <div class="svc-track">
        <span class="svc-chip">Finance</span><span class="svc-chip">Weather</span><span class="svc-chip">News</span><span class="svc-chip">Transit</span><span class="svc-chip">Aviation</span><span class="svc-chip">Sports</span><span class="svc-chip">Science</span><span class="svc-chip">Gov data</span><span class="svc-chip">Health</span><span class="svc-chip">Dev metadata</span><span class="svc-chip">Knowledge</span><span class="svc-chip">Entertainment</span>
        <span class="svc-chip">Finance</span><span class="svc-chip">Weather</span><span class="svc-chip">News</span><span class="svc-chip">Transit</span><span class="svc-chip">Aviation</span><span class="svc-chip">Sports</span><span class="svc-chip">Science</span><span class="svc-chip">Gov data</span><span class="svc-chip">Health</span><span class="svc-chip">Dev metadata</span><span class="svc-chip">Knowledge</span><span class="svc-chip">Entertainment</span>
      </div>
    </div>

  </div>
</section>

<!-- THESIS (what Pilot is) -->
<section class="reveal section" id="thesis-copy" data-track-section="thesis">
  <div class="wrap">
    <div class="thesis">
      <div class="lede">
        <b>AI agents are the biggest shift in computing in years.</b>
        But they've been working alone, <span class="accent">on tools built for people</span>.
      </div>
      <div class="body">
        <p>Pilot is a <b>UDP-level networking stack for autonomous agents</b>.
        A low-level substrate that lets agents find each other, connect directly,
        and exchange data without the human web sitting in between.</p>
        <p>Every agent gets its own <a href="/docs/concepts"><b>Pilot address</b></a>.</p>
        <p>One line of code gets an agent online. No SDK. No API key.</p>
      </div>
    </div>
  </div>
</section>

<!-- MCP -->
<section class="section" id="mcp" data-track-section="mcp">
  <div class="wrap">
    <div class="section-head">
      <h2>Already on MCP? Pilot <em>plugs right in</em>.</h2>
    </div>
    <div class="how-grid">
      <div class="term">
        <div class="bar">
          <div class="dots"><span></span><span></span><span></span></div>
          <div>agent@node ~ add pilot to your harness</div>
          <div>~1m</div>
        </div>
        <div class="term-body" data-mcp-term>
          <div><span class="c">$</span> <span class="y">npx</span> -y pilotprotocol-mcp setup</div>
          <div><span class="c"># pulls the Go daemon, starts it, and writes the</span></div>
          <div><span class="c"># server entry into every MCP harness config</span></div>
