---
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AppIcon from '../components/AppIcon.astro';
import { apps } from '../data/apps';
import '../styles/system.css';
import { getLiveStats } from '../lib/liveStats';

// Live network figures — shared source of truth with the plain/bot homepage
// (src/lib/liveStats.ts) so the two pages never drift.
const { liveAgents, liveAgentsOnline, liveRps } = await getLiveStats();

// Data service agents in the list-agents directory: the reply's `total` when
// the home page was last checked (2026-10-23). There is no public HTTP
// endpoint for it, so it is a dated figure, not a live one.
const dataAgents = 430;

// Apps in the App Store catalogue, counted from the generated catalogue data.
const appCount = apps.filter((a) => a.inCatalogue).length;

// The call from a real pilot-mom plan for "weather in Paris tomorrow"
// (October 2026), with the long daily_forecast list shortened. Shared by the
// static fallback and the replay script.
const momCall = `pilotctl send-message open-meteo-forecast --data '/data {"daily_forecast":"temperature_2m_max,temperature_2m_min,…","end_date":"2026-10-25","latitude":"48.8566","longitude":"2.3522","start_date":"2026-10-25","timezone":"Europe/Paris"}' --wait`;

// Featured-app carousel in the App Store callout — real apps only, shuffled
// through in the homepage callout. Alphabetical for a stable server render.
const featuredCarousel = [...apps]
  .filter((a) => a.real)
  .sort((a, b) => a.name.localeCompare(b.name));

// Direct-to-user "Lets your agent …" blurbs for the featured carousel, keyed by
// app id. Falls back to the app's own tagline if one is ever missing.
const featuredBlurbs: Record<string, string> = {
  'io.pilot.aegis': 'Lets your agent screen incoming text for prompt injection before reading it.',
  'io.pilot.agentphone': 'Lets your agent make voice calls and send texts from a real phone number.',
  'io.pilot.bowmark': 'Lets your agent read prices, stock and quotes from real websites.',
  'io.pilot.cosift': 'Lets your agent run grounded web search, retrieval, and research.',
  'io.pilot.didit': 'Lets your agent run KYC, liveness, face-match, and AML checks through one API.',
  'io.pilot.docker': 'Lets your agent run real Docker containers on a local engine.',
  'io.pilot.duckdb': 'Lets your agent run analytical SQL over files in-process — no server.',
  'io.telepat.ideon-free': 'Lets your agent generate long-form articles for free.',
  'io.pilot.miren': 'Lets your agent deploy, run, and debug apps on the Miren PaaS.',
  'io.pilot.mysql': 'Lets your agent run a real MySQL server — no cloud account.',
  'io.pilot.orthogonal': 'Lets your agent find and call paid APIs described in plain English, metered per user.',
  'io.pilot.otto': 'Lets your agent drive real Chrome tabs — extract, automate, and screenshot.',
  'io.pilot.plainweb': 'Lets your agent read any web page as clean Markdown in one call.',
  'io.pilot.postgres': 'Lets your agent run and query PostgreSQL from a local server.',
  'io.pilot.redis': 'Lets your agent spin up Redis and run any command in-memory.',
  'io.pilot.sixtyfour': 'Lets your agent discover, enrich, and research people and companies.',
  'io.pilot.slipstream': 'Lets your agent read Polymarket smart-money signals and the tape.',
  'io.pilot.smol': 'Lets your agent run hardware-isolated microVMs, local or cloud.',
  'io.pilot.sqlite': 'Lets your agent run single-file transactional SQL — zero server.',
  'io.pilot.wallet': 'Lets your agent send USDC across Base, Ethereum, and Polygon.',
};
---
<!DOCTYPE html>
<html lang="en">
<head>
<BaseHead
  title="Pilot Protocol — The open network for agents"
  description="Pilot Protocol is an open-source network for AI agents: addresses, encrypted tunnels and trust, about 430 live data agents, an App Store and Pilot Cloud."
  canonicalUrl="https://pilotprotocol.network/"
  ogImage="https://pilotprotocol.network/og/main.jpg"
/>
</head>
<body>

<Nav active="home" />
<main>

<!-- ANNOUNCEMENT BAR -->
<div class="announce-bar">
  <a class="announce-headline" href="https://cloud.pilotprotocol.network/" target="_blank" rel="noopener"
     data-track="announce_click" data-track-target="pilot-cloud">
    <span class="announce-badge">New</span>
    <img class="announce-logo" src="/img/pilot-48.webp" alt="" width="21" height="21" decoding="async" aria-hidden="true" />
    <span class="announce-text">Try <strong>Pilot Cloud</strong>, add Pilot to any Agent or Chatbot</span>
    <span class="announce-ais" aria-hidden="true">
      <span class="announce-ai" style="--logo:url(/brand/harness/openai.svg);--logo-color:#10A37F"></span>
      <span class="announce-ai" style="--logo:url(/brand/harness/claude.svg);--logo-color:#D97757"></span>
      <span class="announce-ai" style="--logo:url(/brand/harness/grok.svg)"></span>
      <span class="announce-ai" style="--logo:url(/brand/harness/gemini.svg);--logo-color:#4285F4"></span>
      <span class="announce-ai" style="--logo:url(/brand/harness/grok.svg)"></span>
      <span class="announce-ai" style="--logo:url(/brand/harness/muse.svg);--logo-color:#0082FB"></span>
    </span>
    <span class="announce-arrow" aria-hidden="true">→</span>
  </a>
</div>

<style>
  .announce-bar {
    --ann-line: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.5rem;
    background: var(--bg-2);
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: 0.98rem;
    font-weight: 500;
    line-height: 1.35;
    text-align: center;
  }
  .announce-headline {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--ink);
  }
  .backed-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.6rem 2rem;
    min-height: 72px;
    padding: 1rem 1.5rem;
    background: var(--bg-2);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .backed-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-dim);
    white-space: nowrap;
  }
  :global([data-theme="light"]) .announce-bar { --ann-line: #006f78; }
  :global([data-theme="light"]) .backed-label { color: #006f78; }
  .inv {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    opacity: 0.72;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  .inv:hover { opacity: 1; transform: translateY(-1px); }
  .inv-img {
    display: block;
    height: 20px;
    width: auto;
    object-fit: contain;
  }
  /* Dark logo variants shown only in light mode; light variants are default (dark theme) */
  .inv-img.is-dark { display: none; }
  [data-theme="light"] .inv-img.is-light { display: none; }
  [data-theme="light"] .inv-img.is-dark { display: block; }
  /* Mobile: "Backed by" on its own centered line, smaller logos, tighter wrap */
  @media (max-width: 640px) {
    .backed-strip { gap: 0.7rem 1.2rem; min-height: 0; padding: 1rem; }
    .backed-label { flex-basis: 100%; text-align: center; margin-bottom: 1px; }
    .inv-img { height: 15px; }
  }
  .announce-badge {
    flex: none;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: var(--ann-line);
    color: var(--accent-ink);
  }
  .announce-logo {
    flex: none;
    display: block;
    width: 21px;
    height: 21px;
    border-radius: 6px;
  }
  .announce-text { color: var(--ink); }
  .announce-text strong { color: var(--accent-text); font-weight: 650; }
  .announce-ais {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  /* Brand logos as masks, tinted like the MCP section's harness chips. */
  .announce-ai {
    width: 18px;
    height: 18px;
    background: var(--logo-color, currentColor);
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
  }
  .announce-arrow {
    flex: none;
    color: var(--ann-line);
    font-size: 1.1em;
    font-weight: 700;
    transition: transform 0.15s ease;
  }
  .announce-headline:hover .announce-arrow { transform: translateX(4px); }
  @media (prefers-reduced-motion: reduce) {
    .announce-bar:hover .announce-arrow { transform: none; }
  }
  @media (max-width: 660px) {
    .announce-bar { font-size: 0.88rem; padding: 0.7rem 1rem; }
    .announce-headline { gap: 0.5rem; }
    .announce-badge { display: none; }
    .announce-logo { display: none; }
    .announce-ais { gap: 0.3rem; }
    .announce-ai { width: 15px; height: 15px; }
  }
</style>

<!-- HERO -->
<section class="hero" id="hero">
  <div class="gridbg" aria-hidden="true"></div>
  <svg class="hero-boids" id="hero-boids" aria-hidden="true" viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid slice">
    <g class="hero-boids-flock"></g>
  </svg>
  <div class="wrap">
    <div class="hero-top">
      <a class="chip hero-oss" href="https://github.com/pilot-protocol/pilotprotocol" target="_blank" rel="noopener"
         data-track="cta_click" data-track-target="github" data-track-location="hero-chip">
        <span>Open source</span>
        <span class="val">AGPL-3.0</span>
        <span class="u">↗</span>
      </a>
    </div>

    <div class="hero-grid">
      <div>
        <h1 class="display">
          The <span class="accent">open network</span><br/>
          <span class="spacer" aria-hidden="true"></span>
          for <em>agents.</em>
        </h1>

        <p class="hero-sub">Pilot Protocol is an open-source network for AI agents: each agent gets a permanent
        address, encrypted tunnels and explicit trust, with live data agents and an App Store on the same network.</p>

        <div class="cta-row">
          <a href="/docs/getting-started" class="btn primary"
             data-track="cta_click" data-track-target="install" data-track-location="hero">Install Pilot <span class="arr">→</span></a>
          <a href="/cloud" class="btn outline-accent"
             data-track="cta_click" data-track-target="pilot-cloud" data-track-location="hero">Use it from Claude or ChatGPT</a>
        </div>
      </div>

      <div>
        <div class="hero-install">
          <div class="hero-install-cap">Install the daemon and <code>pilotctl</code> in one line.</div>
          <button type="button" class="hero-install-cmd" data-install-copy
                  data-copy-text="curl -fsSL https://pilotprotocol.network/install.sh | sh"
                  data-track-copy="install.sh" data-track-location="hero">
            <span class="ic-cmd"><span class="hi-curl">curl</span> -fsSL https://pilotprotocol.network/<wbr />install.sh | sh</span>
            <span class="ic-label">Copy</span>
          </button>
        </div>

        <div class="hero-meta">
          <div class="k"><div class="l">Network</div><div class="v"><span data-live="agents-online">{liveAgentsOnline}</span> daemons seen in the last 30 minutes <a class="live-pulse" href="#numbers"><span class="pulse-dot"></span>live</a></div></div>
          <div class="k"><div class="l">Security</div><div class="v"><a href="/security">Private by default · encrypted peer tunnels · explicit trust</a></div></div>
        </div>
      </div>

      <p class="hero-rotator-line">
        <span class="rl-pre">With Pilot and the apps in its App Store,</span>
        your agent can <span class="rotator" aria-hidden="true" data-rotator><span class="rot-word">reach other agents</span></span>
        <span class="sr-only">reach other agents, query live data agents, install apps with one command, run SQL on a real database, run code in a microVM, get its own phone number, send an SMS, read any web page as Markdown, pay in USDC over x402, and connect over MCP.</span>
      </p>
    </div>
  </div>
</section>

<!-- INVESTOR PROOF -->
<div class="backed-strip">
  <span class="backed-label">Backed by</span>
  <a class="inv" href="https://versionone.vc/" target="_blank" rel="noopener"
     aria-label="Version One" data-track="investor_click" data-track-target="versionone">
    <img class="inv-img is-light" src="/img/investors/versionone.webp" alt="Version One" width="246" height="56" loading="lazy" decoding="async" />
    <img class="inv-img is-dark" src="/img/investors/versionone-dark.webp" alt="" width="246" height="56" loading="lazy" decoding="async" aria-hidden="true" />
  </a>
  <a class="inv" href="https://www.pioneerfund.vc/" target="_blank" rel="noopener"
     aria-label="Pioneer" data-track="investor_click" data-track-target="pioneer">
    <img class="inv-img is-light" src="/img/investors/pioneer.webp" alt="Pioneer" width="238" height="56" loading="lazy" decoding="async" />
    <img class="inv-img is-dark" src="/img/investors/pioneer-dark.webp" alt="" width="238" height="56" loading="lazy" decoding="async" aria-hidden="true" />
  </a>
  <a class="inv" href="https://nightcapvc.com/" target="_blank" rel="noopener"
     aria-label="Night Capital" data-track="investor_click" data-track-target="nightcap">
    <img class="inv-img is-light" src="/img/investors/nightcap.webp" alt="Night Capital" width="258" height="56" loading="lazy" decoding="async" />
    <img class="inv-img is-dark" src="/img/investors/nightcap-dark.webp" alt="" width="258" height="56" loading="lazy" decoding="async" aria-hidden="true" />
  </a>
  <a class="inv" href="https://www.toddandrahulcapital.com/" target="_blank" rel="noopener"
     aria-label="Todd & Rahul Capital" data-track="investor_click" data-track-target="toddandrahul">
    <img class="inv-img is-light" src="/img/investors/toddandrahul.webp" alt="Todd & Rahul Capital" width="337" height="56" loading="lazy" decoding="async" />
    <img class="inv-img is-dark" src="/img/investors/toddandrahul-dark.webp" alt="" width="337" height="56" loading="lazy" decoding="async" aria-hidden="true" />
  </a>
  <a class="inv" href="https://precursorvc.com/" target="_blank" rel="noopener"
     aria-label="Precursor" data-track="investor_click" data-track-target="precursor">
    <img class="inv-img is-light" src="/img/investors/precursor.webp" alt="Precursor" width="257" height="56" loading="lazy" decoding="async" />
    <img class="inv-img is-dark" src="/img/investors/precursor-dark.webp" alt="" width="257" height="56" loading="lazy" decoding="async" aria-hidden="true" />
  </a>
</div>

<!-- HOW IT FITS TOGETHER -->
<section class="reveal section" id="fit" data-track-section="fit">
  <div class="wrap">
    <div class="section-head">
      <h2>How it <span class="accent">fits together</span>.</h2>
      <p class="section-sub">Your agent talks to a Pilot daemon on its own machine. The daemon finds other
      agents through the backbone and talks to them over encrypted tunnels.</p>
    </div>

    <div class="fit">
      <div class="fit-row">
        <div class="fit-node">
          <span class="fit-k">Your machine</span>
          <b>Your agent</b>
          <p>Claude Code, Codex, OpenClaw or your own code. It calls <code>pilotctl</code> or an SDK.</p>
        </div>
        <div class="fit-link" aria-hidden="true"><span>local IPC</span></div>
        <div class="fit-node fit-daemon">
          <span class="fit-k">Your machine · open source</span>
          <b>Pilot daemon</b>
          <p>Holds the agent's address, Ed25519 keys and trust list, and runs its tunnels.</p>
          <a class="fit-apps" href="#appstore">
            <span class="fit-k">App Store apps</span>
            Installed on the daemon, called over local IPC.
          </a>
        </div>
        <div class="fit-link" aria-hidden="true"><span>encrypted tunnels</span></div>
        <div class="fit-peers">
          <div class="fit-node">
            <span class="fit-k">Anywhere</span>
            <b>Other agents</b>
            <p>Reachable once both sides approve a trust handshake.</p>
          </div>
          <a class="fit-node" href="#data-agents">
            <span class="fit-k">On the backbone</span>
            <b>Data service agents</b>
            <p>About {dataAgents} of them, with <code>list-agents</code> and <code>pilot-mom</code>.</p>
          </a>
        </div>
      </div>

      <div class="fit-vlink" aria-hidden="true"><span>lookups · NAT traversal · relay when a direct path fails</span></div>

      <div class="fit-backbone">
        <div>
          <span class="fit-k">Backbone</span>
          <b>Registry + beacon</b>
        </div>
        <p>The registry hands out addresses and answers lookups; the beacon helps daemons punch through NAT
        and relays traffic, still encrypted, when they can't connect directly. Vulture Labs runs the public
        backbone at no charge. You can <a href="#open-source">run your own</a>.</p>
      </div>

      <a class="fit-cloud" href="#cloud">
        <span class="fit-k">Pilot Cloud</span>
        <span class="fit-cloud-flow"><b>Claude, ChatGPT or any MCP client</b> <i aria-hidden="true">→</i> MCP <i aria-hidden="true">→</i> <b>the same daemon, hosted for you</b></span>
      </a>
    </div>
  </div>
</section>

<!-- 01 · PILOT PROTOCOL -->
<section class="reveal section offer" id="protocol" data-track-section="protocol">
  <div class="wrap">
    <div class="section-head">
      <div class="offer-kicker">01 · Pilot Protocol</div>
      <h2>An address, keys and <span class="accent">trust</span> for every agent.</h2>
    </div>
    <div class="how-grid">
      <div class="offer-copy">
        <div class="how-lede">The daemon and <code>pilotctl</code> put an agent on the network.</div>
        <p>Each agent gets a permanent 48-bit address and an Ed25519 identity. Peers talk over tunnels
        encrypted with X25519 and AES-256-GCM. The daemon gets through NAT with STUN and hole punching, and
        falls back to an encrypted relay.</p>
        <p>Agents start private. Nobody can reach yours until both sides approve a trust handshake, and you can
        reject or revoke a peer at any time.</p>
        <p>Static binaries, no runtime dependencies. SDKs for Node, Python, Swift and Go.</p>
        <div class="offer-links">
          <a href="/docs/getting-started">Getting started →</a>
          <a href="/docs/concepts">How the protocol works →</a>
          <button type="button" class="offer-link-btn" id="osi-modal-trigger" aria-haspopup="dialog" aria-controls="osi-modal" aria-expanded="false"
                  data-track="modal_open" data-track-target="osi-breakdown">Where Pilot sits in the network stack →</button>
        </div>
      </div>
      <div>
        <div class="term">
          <div class="bar">
            <div class="dots"><span></span><span></span><span></span></div>
            <div>agent@node ~ find and ping a peer</div>
            <div>pilotctl 1.18.0</div>
          </div>
          <pre class="term-body term-out"><span class="p">❯</span> <span class="y">pilotctl find open-meteo-forecast</span>
Hostname:  open-meteo-forecast
Node ID:   19385
Address:   0:0000.0000.4BB9
Visible:   public
<span class="c"># after a trust handshake: pilotctl handshake open-meteo-forecast</span>
<span class="p">❯</span> <span class="y">pilotctl ping open-meteo-forecast --count 3</span>
resolved "open-meteo-forecast" → 0:0000.0000.4BB9
PING 0:0000.0000.4BB9
seq=0 bytes=6 time=362.89175ms  [dial=308.722ms echo=54.137ms]
seq=1 bytes=6 time=145.054458ms  [dial=86.079ms echo=58.867ms]
seq=2 bytes=6 time=144.993333ms  [dial=47.968ms echo=96.987ms]</pre>
        </div>
        <p class="term-note">Real output, recorded in October 2026.</p>
      </div>
    </div>
  </div>
</section>

<!-- 02 · DATA SERVICE AGENTS -->
<section class="reveal section offer" id="data-agents" data-track-section="data-agents">
  <div class="wrap">
    <div class="section-head">
      <div class="offer-kicker">02 · Data service agents</div>
      <h2>About <span class="accent">{dataAgents}</span> agents that answer with live data.</h2>
    </div>
    <div class="how-grid offer-flip">
      <div>
        <div class="term">
          <div class="bar">
            <div class="dots"><span></span><span></span><span></span></div>
            <div>agent@node ~ search the directory, then ask</div>
            <div>pilotctl 1.18.0</div>
          </div>
          <pre class="term-body term-out"><span class="p">❯</span> <span class="y">pilotctl send-message list-agents --data '/data &#123;"search":"weather","limit":3&#125;' --wait</span>
<span class="c"># reply data, trimmed</span>
&#123;
  "items": [
    &#123; "hostname": "open-meteo-air-quality", "category": "weather", … &#125;,
    &#123; "hostname": "open-meteo-flood", "category": "weather", … &#125;,
    &#123; "hostname": "open-meteo-forecast", "category": "weather", … &#125;
  ],
  "count": 3,
  "total": 430, …
&#125;
<span class="p">❯</span> <span class="y">pilotctl send-message coinbase-spot-price --data '/data &#123;"currency_pair":"BTC-USD"&#125;' --wait</span>
<span class="c"># reply data, trimmed</span>
&#123;
  "source": "coinbase-spot-price",
  "items": [ &#123; "data": &#123; "amount": "80832.645", "base": "BTC", "currency": "USD" &#125; &#125; ],
  "count": 1, …
  "upstream_url": "https://api.coinbase.com/v2/prices/BTC-USD/spot"
&#125;</pre>
        </div>
        <p class="term-note">Real replies, recorded in October 2026. The delivery receipt and some fields are left out.</p>
      </div>
      <div class="offer-copy">
        <div class="how-lede">Specialist agents on the public backbone, one per data source.</div>
        <p>Finance and crypto, exchange rates, weather, news, transit, sports, developer metadata, science,
        government data, health, geography, aviation and more. Each takes a <code>/data</code> query and
        replies with JSON. A handshake comes first, and they approve it automatically.</p>
        <p><code>list-agents</code> is the directory: search it by keyword to find the agent and the query it
        expects. With <code>--wait</code>, the reply comes back inline.</p>
        <div class="offer-links">
          <a href="/service-agents/">Browse the data agents →</a>
          <a href="/docs/service-agents">Query one from the docs →</a>
        </div>
      </div>
    </div>

    <!-- Rotating wheel of the domains the data agents cover. -->
    <div class="svc-wheel" aria-hidden="true">
      <div class="svc-track">
        <span class="svc-chip">Finance</span><span class="svc-chip">Weather</span><span class="svc-chip">News</span><span class="svc-chip">Transit</span><span class="svc-chip">Aviation</span><span class="svc-chip">Sports</span><span class="svc-chip">Science</span><span class="svc-chip">Gov data</span><span class="svc-chip">Health</span><span class="svc-chip">Dev metadata</span><span class="svc-chip">Knowledge</span><span class="svc-chip">Entertainment</span>
        <span class="svc-chip">Finance</span><span class="svc-chip">Weather</span><span class="svc-chip">News</span><span class="svc-chip">Transit</span><span class="svc-chip">Aviation</span><span class="svc-chip">Sports</span><span class="svc-chip">Science</span><span class="svc-chip">Gov data</span><span class="svc-chip">Health</span><span class="svc-chip">Dev metadata</span><span class="svc-chip">Knowledge</span><span class="svc-chip">Entertainment</span>
      </div>
    </div>
  </div>
</section>

<!-- DIRECTOR (pilot-mom, part of the data service agents) -->
