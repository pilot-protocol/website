     screens is transformed at rest, so the app UI renders pixel-sharp. */
  .cloud-stage {
    grid-area: stage;
    align-self: center;
    position: relative;
    isolation: isolate;
    --cloud-rim: rgb(255 255 255 / 0.07);
    --cloud-btn-a: #4a4a4f;
    --cloud-btn-b: #2c2c30;
    --cloud-sh1: rgb(0 0 0 / 0.6);
    --cloud-sh2: rgb(0 0 0 / 0.5);
    --cloud-sh3: rgb(0 0 0 / 0.55);
