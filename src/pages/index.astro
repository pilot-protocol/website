  }
  .appstore-callout:hover .ac-tile { border-color: #33332c; }
  .appstore-callout .ac-tile img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
  }
  /* Telepat's mark is dark monochrome: invert it to read on the dark theme,
     revert on light (mirrors .zoo-logo-mono on the app-store page). */
  .appstore-callout .ac-tile-mono { filter: invert(1); }
  [data-theme="light"] .appstore-callout .ac-tile-mono { filter: none; }
  .appstore-callout .ac-more {
    width: 54px;
    height: 54px;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--accent-dim);
    border-radius: 6px;
    background: var(--accent-dim);
    font-family: var(--mono);
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--accent-text);
  }
  /* Below ~860px the rail crowds the heading; drop the last tiles first, then
     hide the rail entirely on mobile (the card stacks to a column there). */
  @media (max-width: 1240px) {
    .appstore-callout .ac-rail .ac-tile:nth-child(n+7) { display: none; }
  }
  @media (max-width: 1040px) {
    .appstore-callout .ac-rail .ac-tile:nth-child(n+5) { display: none; }
  }
  @media (max-width: 640px) {
    .ac-main { gap: 18px; padding: 22px 20px; }
    .ac-devstrip { padding: 16px 20px; }
    .ac-top { gap: 16px; }
    /* Show the app icons on mobile as a tidy static row (floats off, no scatter). */
    .appstore-callout .ac-rail { display: flex; flex-wrap: wrap; min-height: auto; gap: 8px; }
    .appstore-callout .ac-rail .ac-tile {
      width: 46px; height: 46px; animation: none; transform: none;
    }
    .appstore-callout .ac-rail .ac-tile:nth-child(-n+5) { display: flex; }
    .appstore-callout .ac-rail .ac-tile:nth-child(n+6) { display: none; }
    .appstore-callout .ac-more { width: 46px; height: 46px; }
  }
  @media (max-width: 360px) {
    .appstore-callout .ac-rail .ac-tile:nth-child(-n+4) { display: flex; }
    .appstore-callout .ac-rail .ac-tile:nth-child(n+5) { display: none; }
  }

  /* Two paths: Pilot Lite vs Pilot (skill injection). */
  /* Eyebrows removed page-wide, so collapse every section head to one column
     (otherwise the h2 falls into the narrow 160px gutter and wraps vertically)
     and centre the titles. */
  .section-head { grid-template-columns: 1fr; justify-items: center; text-align: center; }
  .section-head .section-sub { grid-column: 1; margin-left: auto; margin-right: auto; }
  .paths {
    margin: 40px 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: stretch;
  }
  .path-card {
    --c: var(--ink-dim);
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 34px 36px;
    border: 1px solid color-mix(in srgb, var(--c) 34%, var(--line));
    border-radius: 16px;
    background: var(--bg-2);
    overflow: hidden;
  }
  .path-card::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--c);
    opacity: 0.8;
  }
  .path-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 90% at 0% 0%,
      color-mix(in srgb, var(--c) 12%, transparent), transparent 55%);
    pointer-events: none;
  }
  .path-card > * { position: relative; z-index: 1; }
  .path-full {
    --c: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--accent) 14%, transparent),
      0 8px 40px color-mix(in srgb, var(--accent) 10%, transparent);
  }
  .path-rec {
    margin-left: 10px;
    padding: 3px 9px;
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #04120a;
    background: var(--accent);
    vertical-align: middle;
  }
  .path-head { display: flex; flex-direction: column; gap: 6px; margin-bottom: 18px; }
  .path-tag { display: inline-flex; align-items: center; }
  .path-name {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--sans);
    font-weight: 500;
    font-size: clamp(24px, 3vw, 32px);
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .path-logo { width: 30px; height: 30px; object-fit: contain; }
  .path-tag {
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c);
  }
  .path-full .path-tag { color: var(--accent-text); }
  .path-lite .path-tag { color: var(--ink-dim); }
  .path-lead { font-size: 16px; line-height: 1.55; color: var(--ink-dim); margin: 0 0 20px; }
  .path-list { list-style: none; margin: 0 0 24px; padding: 0; display: flex; flex-direction: column; gap: 11px; }
  /* The single plugged-in card is full-width, so lay its checklist in two columns. */
  .path-full .path-list { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 32px; }
  @media (max-width: 640px) { .path-full .path-list { grid-template-columns: 1fr; } }
  .path-list li {
    position: relative;
    padding-left: 26px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink);
  }
  .path-list li::before {
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--mono);
    font-size: 14px;
    color: var(--c);
    content: "›";
  }
  .path-full .path-list li::before { content: "✓"; color: var(--accent); }
  .path-list code, .path-cmd code { font-family: var(--mono); font-size: 0.85em; }
  .path-cmd {
    margin-top: auto;
    padding: 12px 14px;
    border: 1px solid var(--line);
    background: var(--bg);
    font-family: var(--mono);
    font-size: 13px;
    color: var(--ink);
    overflow-x: auto;
    white-space: nowrap;
  }
  .path-cmd .pc-p { color: var(--accent-text); margin-right: 8px; }
  .paths-note {
    margin: 28px 0 0;
    max-width: 78ch;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-dim);
  }
  .paths-note b { color: var(--ink); font-weight: 500; }
  .paths-note a { color: var(--accent-text); text-decoration: none; }
  .paths-note a:hover { text-decoration: underline; }
  @media (max-width: 760px) {
    .paths { grid-template-columns: 1fr; gap: 16px; }
    .path-card { padding: 24px; }
  }

  /* Tighten the homepage hero so the rotating capability line sits higher —
     visible on first paint. Scoped to #hero so other pages' .display is untouched. */
  #hero.hero { padding-top: 46px; padding-bottom: 64px; }
  #hero .hero-top { margin-bottom: 38px; }
  /* Phones: shrink the "Network throughput" chip so it doesn't dominate. */
  @media (max-width: 600px) {
    #hero .hero-top { margin-bottom: 26px; }
    #hero .chip { gap: 7px; padding: 6px 10px; font-size: 10.5px; letter-spacing: 0.08em; }
    #hero .chip .val { font-size: 13px; }
    #hero .chip .dot { width: 6px; height: 6px; }
  }
  #hero .display { font-size: clamp(44px, 7.6vw, 118px); line-height: 0.9; }
  #hero .display .spacer { height: 0.05em; }
  #hero .hero-grid { gap: 56px; align-items: start; }
  #hero .hero-rotator-line { margin-top: 30px; }

  /* Hero install pill — replaces the sub-paragraph with the one-line installer. */
  .hero-install { margin-top: 18px; max-width: 620px; }
  .hero-install-cap {
    font-size: clamp(19px, 2.2vw, 23px);
    line-height: 1.4;
    color: var(--ink);
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: 14px;
  }
  .hero-install-cmd {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    text-align: left;
    cursor: pointer;
    font-family: var(--mono);
    font-size: clamp(11px, 1vw, 13px);
    color: var(--ink);
    background: color-mix(in srgb, var(--bg-2) 70%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 38%, var(--line));
    border-radius: 12px;
    padding: 16px 18px;
    box-shadow: inset 0 1px 0 color-mix(in srgb, #fff 6%, transparent);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .hero-install-cmd:hover {
    border-color: color-mix(in srgb, var(--accent) 70%, transparent);
    box-shadow: 0 6px 22px color-mix(in srgb, var(--accent) 16%, transparent);
  }
  .hero-install-cmd .ic-cmd {
    flex: 1; min-width: 0; overflow-x: auto; white-space: nowrap;
    /* Hide the scrollbar chrome — still scrollable on very narrow screens. */
    scrollbar-width: none;              /* Firefox */
    -ms-overflow-style: none;           /* old Edge */
  }
  .hero-install-cmd .ic-cmd::-webkit-scrollbar { display: none; }  /* Chrome/Safari */
  .hero-install-cmd .hi-dollar { color: var(--ink-dim); }
  .hero-install-cmd .hi-curl { color: var(--accent-text); font-weight: 600; }
  .hero-install-cmd .ic-label {
    flex: none;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-ink);
    background: var(--accent);
    padding: 5px 13px;
    border-radius: 999px;
    font-weight: 600;
  }
  .hero-install-cmd.is-copied .ic-label { background: var(--ink); color: var(--bg); }

  /* Hero rotating capability line ("Pilot lets your agent …") */
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  .hero-rotator-line {
    --rl-lh: 1.35em;
    margin-top: 32px;
    font-family: var(--sans);
    font-size: clamp(28px, 4.4vw, 52px);
    font-weight: 400;
    line-height: var(--rl-lh);
    letter-spacing: -0.015em;
    color: var(--ink-dim);
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    grid-column: 1 / -1;
  }
  /* Mobile: grid stacks the content block and the rotating line. Tighten the
     gap between them and the hero's bottom padding so the line isn't stranded. */
  @media (max-width: 960px) {
    .hero-grid { display: flex; flex-direction: column; }
    #hero .hero-grid { gap: 20px; }
    /* Order: headline (1) → rotating line (2) → install + network metadata (3). */
    #hero .hero-grid > :nth-child(1) { order: 1; }
    #hero .hero-grid > :nth-child(3) { order: 2; }
    #hero .hero-grid > :nth-child(2) { order: 3; }
    #hero .hero-rotator-line { margin-top: 0; }
    #hero.hero { padding-bottom: 40px; }
  }
  @media (max-width: 560px) {
    #hero .hero-grid { gap: 14px; }
    #hero .hero-rotator-line { margin-top: 0; }
    #hero.hero { padding-bottom: 28px; }
    /* Install pill: full width, tighter, so it never overflows the phone. The
       min-width:0 on the flex ancestors lets the long command scroll INSIDE the
       pill instead of forcing the whole pill wider than the screen. */
    #hero .hero-grid > * { min-width: 0; max-width: 100%; }
    .hero-install { max-width: 100%; min-width: 0; }
    .hero-install-cap { font-size: 19px; margin-bottom: 12px; }
    .hero-install-cmd { font-size: 11.5px; gap: 10px; padding: 12px 13px; min-width: 0; overflow: hidden; }
    .hero-install-cmd .ic-label { padding: 5px 11px; font-size: 11px; }
    /* A big one-liner can't fit a phone with a 21-char prefix — so go two
       centered lines: the sentence on top, the big green word beneath. */
    .hero-rotator-line {
      font-size: clamp(21px, 6.6vw, 30px);
      white-space: normal;
      line-height: 1.25;
    }
    .rotator { display: block; margin: 0.18em auto 0; }
  }
  /* Box hugs the current word (auto width) — no dead space — and clips the
     vertical slide. Width eases between words so it never jumps. */
  .rotator {
    display: inline-block;
    height: var(--rl-lh);
    line-height: var(--rl-lh);
    overflow: hidden;
    vertical-align: bottom;
    transition: width 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .rot-word {
    display: inline-block;
    line-height: var(--rl-lh);
    white-space: nowrap;
    color: var(--accent-text);
    font-weight: 500;
    transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.2s ease,
                filter 0.2s ease;
  }
  /* Motion blur — smears the word vertically as it slides out/in. */
  .rot-word.is-out { transform: translateY(-100%); opacity: 0; filter: blur(4px); }
  .rot-word.is-in  { transform: translateY(100%);  opacity: 0; filter: blur(4px); transition: none; }
</style>

<script is:inline>
// Hero boids - decorative flock of triangle-shaped boids drifting behind the
// headline. Reynolds separation/alignment/cohesion in a 1200x600 viewBox with
// a soft edge cushion. Reduced-motion renders a static frame.
(function(){
  var svg = document.getElementById('hero-boids');
  if (!svg) return;
  var flockG = svg.querySelector('.hero-boids-flock');
  var W = 1200, H = 600;
  var TRI_POINTS = '-5,-3.2 -5,3.2 8.5,0';

  var seed = 7;
  function rand(){ seed = (seed*9301 + 49297) % 233280; return seed/233280; }

  var N = 50;
  var boids = [];
  for (var i = 0; i < N; i++) {
    var ang0 = rand() * Math.PI * 2;
    var sp0 = 0.8 + rand() * 0.6;
    boids.push({
      x: rand() * W,
      y: rand() * H,
      vx: Math.cos(ang0) * sp0,
      vy: Math.sin(ang0) * sp0,
      scale: 0.7 + rand() * 0.8
    });
  }

  var tris = boids.map(function(b){
    var t = document.createElementNS('http://www.w3.org/2000/svg','polygon');
    t.setAttribute('points', TRI_POINTS);
    flockG.appendChild(t);
    return t;
  });

  function paint(){
    for (var i = 0; i < boids.length; i++) {
      var b = boids[i];
      var ang = Math.atan2(b.vy, b.vx) * 180 / Math.PI;
      tris[i].setAttribute('transform', 'translate('+b.x.toFixed(1)+' '+b.y.toFixed(1)+') rotate('+ang.toFixed(1)+') scale('+b.scale.toFixed(2)+')');
    }
  }
  paint();

  if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  var SEP_R = 28, ALIGN_R = 70, COH_R = 110;
  var SEP_W = 0.10, ALIGN_W = 0.05, COH_W = 0.00025;
  var EDGE_MARGIN = 80, EDGE_W = 0.0028;
  var MAX_SPEED = 1.5, MIN_SPEED = 0.55;

  function tick(){
    for (var i = 0; i < boids.length; i++) {
      var b = boids[i];
      var sx = 0, sy = 0;
      var ax = 0, ay = 0, an = 0;
      var cx = 0, cy = 0, cn = 0;
      for (var j = 0; j < boids.length; j++) {
        if (i === j) continue;
        var o = boids[j];
        var dx = o.x - b.x, dy = o.y - b.y;
        var d2 = dx * dx + dy * dy;
        if (d2 < 0.01) continue;
        if (d2 < SEP_R * SEP_R) { var d = Math.sqrt(d2); sx -= dx / d; sy -= dy / d; }
        if (d2 < ALIGN_R * ALIGN_R) { ax += o.vx; ay += o.vy; an++; }
        if (d2 < COH_R * COH_R)     { cx += o.x;  cy += o.y;  cn++; }
      }
      var fx = sx * SEP_W, fy = sy * SEP_W;
      if (an > 0) { fx += (ax / an - b.vx) * ALIGN_W; fy += (ay / an - b.vy) * ALIGN_W; }
      if (cn > 0) { fx += (cx / cn - b.x)  * COH_W;   fy += (cy / cn - b.y)  * COH_W;   }
      if (b.x < EDGE_MARGIN)          fx += (EDGE_MARGIN - b.x) * EDGE_W;
      else if (b.x > W - EDGE_MARGIN) fx -= (b.x - (W - EDGE_MARGIN)) * EDGE_W;
      if (b.y < EDGE_MARGIN)          fy += (EDGE_MARGIN - b.y) * EDGE_W;
      else if (b.y > H - EDGE_MARGIN) fy -= (b.y - (H - EDGE_MARGIN)) * EDGE_W;

      b.vx += fx; b.vy += fy;
      var sp = Math.sqrt(b.vx * b.vx + b.vy * b.vy);
      if (sp > MAX_SPEED)         { b.vx = b.vx / sp * MAX_SPEED; b.vy = b.vy / sp * MAX_SPEED; }
      else if (sp < MIN_SPEED && sp > 0) { b.vx = b.vx / sp * MIN_SPEED; b.vy = b.vy / sp * MIN_SPEED; }
      b.x += b.vx; b.y += b.vy;
    }
    paint();
    if (running) requestAnimationFrame(tick);
  }
  // Only animate while the hero is actually on screen. A 50-boid O(N^2) sim
  // running every frame after you've scrolled past the hero steals main-thread
  // time and stutters scrolling — pause it when the hero leaves the viewport.
  var running = false;
  function start(){ if (!running) { running = true; requestAnimationFrame(tick); } }
  function stop(){ running = false; }
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if (e.isIntersecting) { start(); } else { stop(); } });
    }, { threshold: 0 }).observe(svg);
  } else {
    start();
  }
})();

// Live stats refresh - fetches live stats on page load and every 60s so numbers
// stay current between site deploys. Build-time values are the fallback.
(function(){

  function fmtCompact(n){
    if (n >= 1_000_000_000) return '~' + (n / 1_000_000_000).toFixed(1).replace(/\.0$/, '') + 'B';
    if (n >= 1_000_000)     return '~' + (n / 1_000_000).toFixed(1).replace(/\.0$/, '') + 'M';
    if (n >= 10_000)        return '~' + Math.round(n / 1000) + ',000';
    if (n >= 1_000)         return '~' + (n / 1000).toFixed(1).replace(/\.0$/, '') + 'K';
    return String(n);
  }
  function setAll(sel, value){
    document.querySelectorAll(sel).forEach(function(el){ el.textContent = value; });
  }
  // /api/public-stats payload (2026-06-07 r2): server_time, uptime_seconds,
  // active_nodes (currently-online), total_nodes (cumulative ever-registered
  // = next_node-1), total_requests, requests_per_sec, components{}.
  function refresh(){
    fetch('https://polo.pilotprotocol.network/api/public-stats', { cache: 'no-store' })
      .then(function(r){ return r.ok ? r.json() : null; })
      .then(function(s){
        if (!s) return;
        // Currently-online agents (active_nodes) — hero "N agents online".
        if (typeof s.active_nodes === 'number') {
          setAll('[data-live="agents-online"]', fmtCompact(s.active_nodes));
        }
        // Total agents ever on the network (total_nodes) — the "All time" stat.
        var totalN = typeof s.total_nodes === 'number' ? s.total_nodes
                   : typeof s.active_nodes === 'number' ? s.active_nodes : null;
        if (totalN != null) {
          setAll('[data-live="agents-total"]', fmtCompact(totalN));
          setAll('[data-live="agents-long"]', fmtCompact(totalN));
          setAll('[data-live="agents-exact"]', totalN.toLocaleString('en-US'));
        }
        if (typeof s.total_requests === 'number') {
          setAll('[data-live="requests-total"]', fmtCompact(s.total_requests));
        }
        if (typeof s.requests_per_sec === 'number') {
          setAll('[data-live="rps"]', Math.round(s.requests_per_sec).toLocaleString('en-US'));
          // Keep the "Requests per hour" stat live too (rps × 3600), so it can't
          // drift from the hero throughput chip.
          setAll('[data-live="requests-per-hour"]', fmtCompact(Math.round(s.requests_per_sec * 3600)));
        }
      })
      .catch(function(){});
  }
  refresh();
  setInterval(refresh, 60000);
})();
</script>

<!-- Scroll-reveal: sections fade/rise into view as they enter the viewport -->
<script is:inline>
(function () {
  var els = document.querySelectorAll('.reveal');
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Graceful fallback: no observer support or reduced motion → show everything.
  if (reduce || !('IntersectionObserver' in window)) {
    els.forEach(function (el) { el.classList.add('visible'); });
    var allGroups = document.querySelectorAll('.stagger-group');
    for (var g = 0; g < allGroups.length; g++) { allGroups[g].classList.add('in'); }
    var allTerms = document.querySelectorAll('.term-type');
    for (var tt = 0; tt < allTerms.length; tt++) { allTerms[tt].classList.add('printing'); }
    return;
  }
  // Toggle (not one-shot): reveal on enter, hide on leave, so scrolling back
  // up replays the animation in reverse — the page reacts to movement both ways.
  var obs = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      e.target.classList.toggle('visible', e.isIntersecting);
      // Stagger any child groups (vs columns, steps, cards) in sync with the
      // section's reveal — and un-stagger on leave for scroll-up replay.
      var groups = e.target.querySelectorAll('.stagger-group');
      for (var i = 0; i < groups.length; i++) {
        groups[i].classList.toggle('in', e.isIntersecting);
      }
      var terms = e.target.querySelectorAll('.term-type');
      for (var t = 0; t < terms.length; t++) {
        terms[t].classList.toggle('printing', e.isIntersecting);
      }
    });
  }, { rootMargin: '0px 0px -12% 0px', threshold: 0.12 });
  els.forEach(function (el) { obs.observe(el); });

  // Install card — direct copy buttons (curl one-liner + "tell your agent" prompt).
  function normalizeCopyText(value) {
    return value.split('\n').map(function (line) {
      return line.replace(/^(\s*)\$\s(?=\S)/, '$1');
    }).join('\n').trim();
  }

  document.querySelectorAll('[data-install-copy]').forEach(function (installBtn) {
    installBtn.addEventListener('click', function () {
      var cmd = installBtn.querySelector('.ic-cmd');
      var label = installBtn.querySelector('.ic-label');
      if (!cmd || !navigator.clipboard) return;
      var copyText = normalizeCopyText(installBtn.getAttribute('data-copy-text') || cmd.textContent);
      navigator.clipboard.writeText(copyText).then(function () {
        var prev = label.textContent;
        label.textContent = 'Copied';
        installBtn.setAttribute('aria-label', 'Copied');
        installBtn.classList.add('is-copied');
        setTimeout(function () {
          label.textContent = prev;
          installBtn.setAttribute('aria-label', installBtn.classList.contains('install-tell-btn') ? 'Copy prompt' : 'Copy install command');
          installBtn.classList.remove('is-copied');
        }, 1600);
      }).catch(function () {
        label.textContent = 'Copy failed';
        installBtn.setAttribute('aria-label', 'Copy failed');
        setTimeout(function () {
          label.textContent = 'Copy';
          installBtn.setAttribute('aria-label', installBtn.classList.contains('install-tell-btn') ? 'Copy prompt' : 'Copy install command');
        }, 1600);
      });
    });
  });

  // Network-layer stack: deal the cards out from under one another — and slide
  // them back under when the section leaves the viewport.
  var stack = document.querySelector('.stack');
  if (stack && !reduce && ('IntersectionObserver' in window)) {
    var stackObs = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        e.target.classList.toggle('layers-in', e.isIntersecting);
      });
    }, { rootMargin: '0px 0px -18% 0px', threshold: 0.2 });
    stackObs.observe(stack);
  } else if (stack) {
    stack.classList.add('layers-in');
  }

  // Network-stats count-up: spin each figure from 0 to its live value when the
  // section scrolls into view (re-runs on each entry, matching the page's
  // scroll-reactive feel). Preserves the original formatting (~, commas,
  // decimals, B suffix, and the "+" unit span).
  var statBigs = document.querySelectorAll('#numbers .stat .big');
  if (statBigs.length && !reduce && ('IntersectionObserver' in window)) {
    statBigs.forEach(function (el) {
      var unit = el.querySelector('.unit');
      if (unit) {
        // Number lives in the leading text node; keep the unit span intact.
        el._node = el.firstChild;
        el._target = parseFloat((el._node.nodeValue || '').replace(/[^\d.]/g, ''));
        el._prefix = ''; el._suffix = ''; el._decimals = 0; el._group = false;
      } else {
        var m = el.textContent.trim().match(/^([^\d-]*)([\d.,]+)(.*)$/);
        if (m) {
          el._node = null;
          el._prefix = m[1]; el._suffix = m[3];
          el._group = m[2].indexOf(',') > -1;
          var dot = m[2].indexOf('.');
          el._decimals = dot > -1 ? (m[2].length - dot - 1) : 0;
          el._target = parseFloat(m[2].replace(/,/g, ''));
        }
      }
    });

    function fmtNum(el, val) {
      var s = el._decimals > 0 ? val.toFixed(el._decimals) : String(Math.round(val));
      if (el._group) {
        var parts = s.split('.');
        parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        s = parts.join('.');
      }
      return s;
    }
    function render(el, val) {
      var txt = fmtNum(el, val);
      if (el._node) el._node.nodeValue = txt;
      else el.textContent = el._prefix + txt + el._suffix;
    }
    function spin(el) {
      if (el._target == null || isNaN(el._target)) return;
      var dur = 850, start = null;
      function step(ts) {
        if (!start) start = ts;
        var p = Math.min((ts - start) / dur, 1);
        var e = 1 - Math.pow(1 - p, 3); // easeOutCubic
        render(el, el._target * e);
        if (p < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }

    statBigs.forEach(function (el) { render(el, 0); }); // start at 0 pre-reveal
    var numObs = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { statBigs.forEach(spin); }
        else { statBigs.forEach(function (el) { render(el, 0); }); }
      });
    }, { threshold: 0.4 });
    var numbersSec = document.getElementById('numbers');
    if (numbersSec) numObs.observe(numbersSec);
  }

  /* Auto-rotate the active state across the three value pillars. */
  var pillars = Array.prototype.slice.call(document.querySelectorAll('#agent-value .pillar'));
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (pillars.length && !reduce) {
    var idx = 0, timer = null, paused = false;
    function cycle() {
      if (paused) return;
      idx = (idx + 1) % pillars.length;
      pillars.forEach(function (p, i) { p.classList.toggle('is-active', i === idx); });
    }
    function start() { timer = setInterval(cycle, 2600); }
    var group = document.querySelector('#agent-value .pillars');
    if (group) {
      group.addEventListener('mouseenter', function () { paused = true; });
      group.addEventListener('mouseleave', function () { paused = false; });
    }
    start();
  }
})();
</script>

<script is:inline>
  (function () {
    var box = document.querySelector('[data-rotator]');
    if (!box) return;
    var word = box.querySelector('.rot-word');
    var phrases = [
      'discover other agents',
      'install apps built for it',
      'get accurate live data',
      'spin up VMs in the cloud',
      'get its own phone number',
      'run SQL on a real database',
      'sandbox and run code',
      'send an SMS',
      'pay other agents directly',
      'reach any peer, anywhere',
      'tap 430+ live specialists',
      'connect over MCP',
      'run tools on demand'
    ];
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Size the box to the current word so it hugs it (no dead space).
    function fit() { box.style.width = word.offsetWidth + 'px'; }
    // Wait for fonts, then lock the initial width.
    if (document.fonts && document.fonts.ready) { document.fonts.ready.then(fit); }
    fit();
    window.addEventListener('resize', fit);
    if (reduce) return;

    var i = 0;
    setInterval(function () {
      i = (i + 1) % phrases.length;
      var next = phrases[i];
      // slide/fade current word up and out
      word.classList.add('is-out');
      setTimeout(function () {
        // swap text, drop it in from below with no transition
        word.textContent = next;
        word.classList.remove('is-out');
        word.classList.add('is-in');
        fit(); // ease width to the new word
        // next frame: release to animate up into place
        requestAnimationFrame(function () {
          requestAnimationFrame(function () { word.classList.remove('is-in'); });
        });
      }, 200);
    }, 1500);
  })();

  // App Store callout — featured-app carousel. Shuffles L→R through every
  // live app, dwelling a touch longer than the hero word rotator.
  (function () {
    var vp = document.querySelector('[data-acf-carousel]');
    if (!vp) return;
    var cards = [].slice.call(vp.querySelectorAll('[data-acf-card]'));
    if (cards.length < 2) return;
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var cur = 0;
    setInterval(function () {
      var next = (cur + 1) % cards.length;
      var prev = cur;
      cards[prev].classList.add('is-exit');
      cards[prev].classList.remove('is-active');
      cards[prev].setAttribute('tabindex', '-1');
      cards[prev].setAttribute('aria-hidden', 'true');
      cards[next].classList.add('is-active');
      cards[next].setAttribute('tabindex', '0');
      cards[next].setAttribute('aria-hidden', 'false');
      setTimeout(function () { cards[prev].classList.remove('is-exit'); }, 620);
      cur = next;
    }, 2400);

    // Make the WHOLE featured panel (label, padding, gaps — not just the active
    // card) navigate to the app currently on screen.
    var featured = vp.closest('.ac-featured') || vp.parentNode;
    if (featured) {
      featured.style.cursor = 'pointer';
      featured.addEventListener('click', function (e) {
        if (e.target.closest('a')) return; // a real card link was clicked — let it through
        var active = cards[cur];
        if (active && active.href) window.location.href = active.href;
      });
    }
  })();

  // MCP section — realistic typewriter. Types the command char-by-char, pauses
  // as if running, then prints the output lines. A blinking block cursor trails
  // the text. Fires once when the terminal scrolls into view.
  (function () {
    var term = document.querySelector('[data-mcp-term]');
    if (!term) return;
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var LINES = [
      [{ t: '$ ', c: 'c' }, { t: 'npx', c: 'y' }, { t: ' -y pilotprotocol-mcp setup' }],
      [{ t: '# pulls the Go daemon, starts it, and writes the', c: 'c' }],
      [{ t: '# server entry into every MCP harness config', c: 'c' }],
      [],
      [{ t: '✓', c: 'g' }, { t: ' pilot · ' }, { t: 'Claude Code · Cursor · Cline · Codex CLI', c: 'p' }],
      [{ t: '  tools → specialist directory · typed queries · A2A messaging' }]
    ];

    // One full type-out of the script; when done, wait, then replay (loop).
    var timers = [];
    function wait(fn, ms) { timers.push(setTimeout(fn, ms)); }
    function typeSequence() {
      timers.forEach(clearTimeout); timers = [];
      term.innerHTML = '';
      var cursor = document.createElement('span');
      cursor.className = 'tw-cursor';
      var li = 0;
      function nextLine() {
        if (li >= LINES.length) { wait(typeSequence, 3000); return; } // hold, then replay
        var lineDiv = document.createElement('div');
        term.appendChild(lineDiv);
        var segs = LINES[li];
        if (segs.length === 0) {
          lineDiv.innerHTML = '&nbsp;';
          lineDiv.appendChild(cursor);
          li++; wait(nextLine, 150);
          return;
        }
        lineDiv.appendChild(cursor);
        var isCmd = (li === 0);
        var si = 0;
        function nextSeg() {
          if (si >= segs.length) {
            li++;
            wait(nextLine, isCmd ? 520 : 120);
            return;
          }
          var seg = segs[si];
          var span = document.createElement('span');
          if (seg.c) span.className = seg.c;
          lineDiv.insertBefore(span, cursor);
          var ci = 0;
          function nextChar() {
            if (ci >= seg.t.length) { si++; nextSeg(); return; }
            span.textContent += seg.t.charAt(ci); ci++;
            var d = isCmd ? (34 + Math.random() * 48) : (7 + Math.random() * 13);
            wait(nextChar, d);
          }
          nextChar();
        }
        nextSeg();
      }
      nextLine();
    }

    var started = false;
    function start() { if (started) return; started = true; typeSequence(); }
    if ('IntersectionObserver' in window) {
      var obs = new IntersectionObserver(function (es) {
        es.forEach(function (e) { if (e.isIntersecting) start(); });
      }, { threshold: 0.45 });
      obs.observe(term);
    } else {
      start();
    }
  })();

  // MOM terminal — animated planning demo. The agent types a request, MOM
  // "compiles tools", streams a colour-coded plan mixing service agents and
  // apps, then shows the booked result. Loops while the terminal is in view.
  (function () {
    var term = document.querySelector('[data-mom-term]');
    if (!term) return;
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var GREEN = '#3fbf5f', BLUE = '#5b9dff', VIOLET = '#b48cff';
    var QUERY = 'book a table for 4 at Carbone NYC, Fri 8pm';
    // Mirrors a real pilot-mom (pilot-mom) plan: a `calls` list of ready-to-run
    // pilotctl commands, then a `handoff` list your own runtime performs locally.
    var STEPS = [
      { section: 'calls',   name: 'google-maps-places-new', tag: 'call',    color: GREEN,  hl: true, n: '1',
        code: 'pilotctl send-message google-maps-places-new --data \'/data {"textQuery":"Carbone NYC"}\' --wait' },
      { section: 'handoff', name: 'io.pilot.agentphone',    tag: 'handoff', color: BLUE,   hl: true, img: '/appicons/io.pilot.agentphone.png',
        code: 'pilotctl appstore install io.pilot.agentphone · place_call → book 4, Fri 8pm' },
      { section: 'handoff', name: 'io.pilot.wallet',        tag: 'handoff', color: VIOLET, img: '/appicons/io.pilot.wallet.png',
        code: 'pilotctl appstore call io.pilot.wallet wallet.pay · deposit over x402' }
    ];
    var SPIN = ['⠋','⠙','⠹','⠸','⠼','⠴','⠦','⠧','⠇','⠏'];

    var timers = [], spinTimer = null;
    function wait(fn, ms) { timers.push(setTimeout(fn, ms)); }
    function clearAll() {
      timers.forEach(clearTimeout); timers = [];
      if (spinTimer) { clearInterval(spinTimer); spinTimer = null; }
    }
    // Astro scopes the <style> with a data-astro-cid-* attribute. JS-built
    // elements don't inherit it, so scoped .mom-* rules wouldn't apply — stamp
    // the same attribute onto every generated element and its descendants.
    var CID = null;
    for (var ai = 0; ai < term.attributes.length; ai++) {
      if (term.attributes[ai].name.indexOf('data-astro-cid') === 0) { CID = term.attributes[ai].name; break; }
    }
    function stampCid(el) {
      if (!CID) return;
      el.setAttribute(CID, '');
      var kids = el.querySelectorAll('*');
      for (var k = 0; k < kids.length; k++) kids[k].setAttribute(CID, '');
    }
    function row(cls, html) {
      var d = document.createElement('div');
      d.className = 'mom-row' + (cls ? ' ' + cls : '');
      if (html != null) d.innerHTML = html;
      stampCid(d);
      term.appendChild(d);
      requestAnimationFrame(function () {
        requestAnimationFrame(function () { d.classList.add('in'); });
      });
      return d;
    }

    function run() {
      clearAll();
      term.innerHTML = '';

      // Phase 1 — the agent types the real command; the plain-English task types
      // in char by char inside the --data quotes.
      var cmd = row('', '<span class="mom-prompt">❯</span> <span class="mom-cmd">pilotctl</span> <span class="mom-flag">send-message pilot-mom --data</span> \'<span class="mom-query"></span>');
      var quote = cmd.querySelector('.mom-query');
      var cursor = document.createElement('span');
      cursor.className = 'tw-cursor';
      cmd.appendChild(cursor);
      var i = 0;
      (function typeChar() {
        if (i < QUERY.length) {
          quote.textContent += QUERY.charAt(i++);
          wait(typeChar, 22 + Math.random() * 40);
        } else {
          cursor.remove();
          cmd.insertAdjacentHTML('beforeend', '\' <span class="mom-wait">--wait</span>');
          stampCid(cmd);
          wait(think, 480);
        }
      })();

      // Phase 2 — MOM compiles tools (animated spinner), then reveals the header.
      function think() {
        row('mom-spacer');
        var t = row('mom-think', '<span class="mom-spin">⠋</span> <span class="mom-cmd">MOM</span> · compiling plan…');
        var spin = t.querySelector('.mom-spin'), s = 0;
        spinTimer = setInterval(function () {
          spin.textContent = SPIN[s = (s + 1) % SPIN.length];
        }, 75);
        wait(function () {
          clearInterval(spinTimer); spinTimer = null;
          t.classList.add('is-plan');
          t.innerHTML = '<span class="mom-ok">✓</span> plan · class: <span class="mom-ach">achievable</span>';
          stampCid(t);
          wait(function () { emit(0); }, 360);
        }, 1500);
      }

      // Phase 3 — stream the plan: a `calls` group then a `handoff` group, each
      // step showing the literal pilotctl command the director returned.
      function esc(s) {
        return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }
      function emit(k) {
        if (k >= STEPS.length) { wait(done, 520); return; }
        var st = STEPS[k];
        if (k === 0 || st.section !== STEPS[k - 1].section) {
          row('mom-section', st.section);
        }
        var badge = st.img
          ? '<img class="mom-ico" src="' + st.img + '" alt="" width="20" height="20" />'
          : '<span class="mom-n">' + st.n + '</span>';
        var r = row('mom-step' + (st.hl ? ' is-hl' : ''),
          badge +
          '<div class="mom-main">' +
            '<div class="mom-head">' +
              '<span class="mom-name" style="color:' + st.color + '">' + st.name + '</span>' +
              '<span class="mom-pill">' + st.tag + '</span>' +
            '</div>' +
            '<div class="mom-desc mom-code">' + esc(st.code) + '</div>' +
          '</div>');
        r.style.setProperty('--sc', st.color);
        wait(function () { emit(k + 1); }, 720);
      }

      // Phase 4 — the booked result. Plays once and stays on this final state.
      function done() {
        row('mom-done', 'table booked · Fri 8:00pm');
      }
    }

    var started = false;
    function start() { if (started) return; started = true; run(); }
    if ('IntersectionObserver' in window) {
      var mObs = new IntersectionObserver(function (es) {
        es.forEach(function (e) { if (e.isIntersecting) start(); });
      }, { threshold: 0.3 });
      mObs.observe(term);
    } else {
      start();
    }
  })();
</script>


</body>
</html>
