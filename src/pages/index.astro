      0 calc(var(--pw) * 0.12) min(64px, calc(var(--pw) * 0.24)) calc(var(--pw) * -0.06) var(--cloud-sh1),
      0 calc(var(--pw) * 0.04) calc(var(--pw) * 0.08) calc(var(--pw) * -0.04) var(--cloud-sh2);
  }
  /* The front phone also casts a short shadow sideways onto the back one. */
  .cloud-phone:first-child .cloud-phone-frame {
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.05),
      0 0 0 1px var(--cloud-rim),
      calc(var(--pw) * 0.04) calc(var(--pw) * 0.03) calc(var(--pw) * 0.07) calc(var(--pw) * -0.01) var(--cloud-sh3),
      0 calc(var(--pw) * 0.12) min(64px, calc(var(--pw) * 0.24)) calc(var(--pw) * -0.06) var(--cloud-sh1),
      0 calc(var(--pw) * 0.04) calc(var(--pw) * 0.08) calc(var(--pw) * -0.04) var(--cloud-sh2);
  }
  .cloud-phone-screen {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1206 / 2622;
    border-radius: calc(var(--r) - var(--band) - var(--bezel));
    background: #f4f5f7;
  }
  /* Dynamic Island, with a hint of the camera lens at its right end. */
  .cloud-phone-island {
    position: absolute;
    top: calc(var(--bezel) + var(--pw) * 0.026);
    left: 50%;
    width: calc(var(--pw) * 0.292);
    height: calc(var(--pw) * 0.086);
    transform: translateX(-50%);
    border-radius: 999px;
    background:
      radial-gradient(circle at calc(100% - var(--pw) * 0.043) 50%,
        #22283a 0, #0d1018 calc(var(--pw) * 0.012), transparent calc(var(--pw) * 0.014)),
      #000;
  }
  /* Side buttons: action + volume on the left, side button and the flush
     Camera Control on the right. */
  .cloud-phone::before,
  .cloud-phone::after,
  .cloud-phone-frame::before,
  .cloud-phone-frame::after {
    content: "";
    position: absolute;
    z-index: -1;
    width: calc(var(--btn) + var(--band));
    background: linear-gradient(90deg, var(--cloud-btn-a), var(--cloud-btn-b));
  }
  .cloud-phone::before {
    left: calc(var(--btn) * -1);
    top: 17%;
    height: 3.6%;
    border-radius: var(--btn) 0 0 var(--btn);
  }
  .cloud-phone::after {
    left: calc(var(--btn) * -1);
    top: 24%;
    height: 6.2%;
    border-radius: var(--btn) 0 0 var(--btn);
    box-shadow: 0 calc(var(--ph) * 0.082) 0 var(--cloud-btn-b);
  }
  .cloud-phone-frame::after {
    right: calc((var(--btn) + var(--band)) * -1);
    top: 26%;
    height: 9.5%;
    border-radius: 0 var(--btn) var(--btn) 0;
  }
  .cloud-phone-frame::before {
    right: calc((var(--btn) * 0.6 + var(--band)) * -1);
    width: calc(var(--btn) * 0.6 + var(--band));
    top: 56%;
    height: 6.5%;
    border-radius: 0 var(--btn) var(--btn) 0;
    background: linear-gradient(90deg, var(--cloud-btn-b), #1b1b1e);
  }
  /* Light theme: darker rim so the titanium edge reads on cream, olive-tinted
     shadows, and a paler, airier lime halo instead of a saturated blob. */
  :global([data-theme="light"]) .cloud-stage {
    --cloud-rim: rgb(0 0 0 / 0.3);
    --cloud-btn-a: #6a6a70;
    --cloud-btn-b: #3c3c41;
    --cloud-sh1: rgb(28 36 8 / 0.32);
    --cloud-sh2: rgb(28 36 8 / 0.28);
    --cloud-sh3: rgb(28 36 8 / 0.3);
  }
  :global([data-theme="light"]) .cloud-stage::before {
    background: radial-gradient(ellipse 50% 46% at 50% 52%,
      color-mix(in srgb, var(--accent) 24%, transparent) 0%,
      color-mix(in srgb, var(--accent) 8%, transparent) 55%,
      transparent 100%);
  }
  /* "Mobile app coming soon" tag under the pair. */
  .cloud-soon {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 14px 0 0;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .cloud-soon-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .cloud-phone { transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.9s ease; }
    .cloud-phone + .cloud-phone { transition-delay: 0.15s; }
    #cloud:not(.visible) .cloud-phone { transform: translateY(28px); opacity: 0; }
  }

  /* ---- MCP strip along the bottom of the card ---------------------------
     Captions share one row and controls the next (subgrid), so "Works with"
     lines up with "Add this URL…" even though the copy box is taller. */
  .cloud-strip {
    display: grid;
    grid-template-columns: minmax(0, 500px) minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: 48px;
    row-gap: 8px;
    align-items: center;
    padding: 14px var(--cloud-pad-x) 16px;
    border-top: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    background: color-mix(in srgb, var(--accent) 6%, color-mix(in srgb, var(--bg) 70%, transparent));
  }
  .cloud-strip-url,
  .cloud-strip-works {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 10px;
    align-items: center;
    min-width: 0;
  }
  .cloud-cap {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-dim);
  }
  /* .install-copy is styled for the always-dark terminal; this card follows the theme. */
  .cloud-strip .install-copy {
    color: var(--ink);
    background: var(--bg);
    border-color: color-mix(in srgb, var(--accent) 38%, transparent);
    font-size: clamp(13px, 1.1vw, 15px);
    padding: 11px 12px 11px 16px;
  }
  .cloud-strip .install-copy:hover { border-color: color-mix(in srgb, var(--accent) 60%, transparent); }
  .cloud-strip .install-copy .ic-cmd .y { color: var(--ink-dim); }
  .cloud-strip .install-copy .ic-label { color: var(--accent-text); }
  :global([data-theme="light"]) .cloud-strip .install-copy .ic-label {
    border-color: color-mix(in srgb, var(--accent-text) 45%, transparent);
  }
  .cloud-strip .install-copy.is-copied .ic-label { color: var(--accent-ink); border-color: var(--accent); }
  /* .cloud-strip prefix: the shared .mcp-harnesses rules come later in this file. */
  .cloud-strip .cloud-harnesses { margin-top: 0; gap: 8px; }
  .cloud-harnesses .mcp-hn {
    font-size: 13px;
    gap: 7px;
    padding: 7px 12px 7px 9px;
    background: var(--bg);
  }
  .cloud-harnesses .mcp-hn-i { width: 18px; height: 18px; }
  /* Full-colour logos (OpenClaw, Hermes) are images rather than tinted masks. */
  .cloud-hn-img { flex: none; width: 18px; height: 18px; object-fit: contain; }
  .cloud-hn-img.is-portrait { border-radius: 4px; }
  /* The shared .mcp-hn:hover wash loses to the flat --bg fill above, so
     restate it over --bg. */
  .cloud-harnesses .mcp-hn:hover {
    background: color-mix(in srgb, var(--logo-color, var(--accent)) 8%, var(--bg));
  }
  /* The chip layout follows the width of its own column, not the viewport:
     one row while all six fit (about 650px); else two rows of three
     equal-width chips (about 430px); else two rows of three natural-width
     chips in left-aligned columns (about 355px); else three rows of two;
     and below that free wrapping. Never five chips plus an orphan. */
  .cloud-hn-fit { container: cloud-hn / inline-size; min-width: 0; }
  @container cloud-hn (max-width: 659.98px) {
    .cloud-strip .cloud-harnesses {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      width: max-content;
      max-width: 100%;
    }
    .cloud-harnesses .mcp-hn { justify-content: center; }
  }
  @container cloud-hn (max-width: 439.98px) {
    .cloud-strip .cloud-harnesses { grid-template-columns: repeat(3, max-content); justify-items: start; }
  }
  @container cloud-hn (max-width: 359.98px) {
    .cloud-strip .cloud-harnesses {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      justify-items: stretch;
      width: auto;
    }
  }
  @container cloud-hn (max-width: 271.98px) {
    .cloud-strip .cloud-harnesses { display: flex; }
  }

  @media (max-width: 1280px) {
    .cloud-main { column-gap: 40px; }
    .cloud-strip { column-gap: 40px; }
  }
  /* Below ~1100px the strip stacks (URL box, then the chips) and the phones
     shrink; the copy | phones columns hold until 760px. The halo stops at the
     card's edges here so it can never push past the viewport. */
  @media (max-width: 1100px) {
    .cloud-card { --cloud-pad-x: 32px; }
    .cloud-main { grid-template-columns: minmax(0, 1fr) auto; column-gap: 32px; padding-block: 28px; }
    .cloud-pair { --pw: 144px; }
    .cloud-stage::before { inset: -4% 0 -6%; }
    .cloud-strip { display: flex; flex-direction: column; align-items: stretch; gap: 12px; }
    .cloud-strip-url, .cloud-strip-works { display: flex; flex-direction: column; align-items: stretch; gap: 8px; }
    .cloud-strip-url { max-width: 560px; }
  }
  /* Phone widths: head → small phone pair (104/91px) → CTAs. The bullets drop
     out (the sub line carries the message); the named chips wrap to two rows
     until 560px, where they go icon-only on one row. */
  @media (max-width: 760px) {
    .cloud-card { --cloud-pad-x: 24px; }
    .cloud-main {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "head" "stage" "body";
      row-gap: 18px;
      padding-block: 24px 20px;
    }
    .cloud-head, .cloud-body { align-self: auto; }
    .cloud-points { display: none; }
    .cloud-ctas { margin-top: 0; }
    .cloud-pair { --pw: 104px; }
  }
  /* Phone: tighter card padding, side-by-side CTAs and icon-only chips; the
     phones keep their 104/91px size from the 760px step. */
  @media (max-width: 560px) {
    .cloud-card { --cloud-pad-x: 22px; }
    .cloud-ctas { gap: 8px; flex-wrap: nowrap; }
    .cloud-ctas .btn { flex: 1 1 0; min-width: 0; justify-content: center; gap: 6px; padding: 12px 8px; font-size: 11px; letter-spacing: 0.04em; white-space: nowrap; }
    .cloud-cta-extra { display: none; }
    .cloud-strip { padding-block: 14px 16px; }
    /* Icon-only chips on one row; the names stay for screen readers. */
    #cloud .cloud-strip .cloud-harnesses { display: flex; flex-wrap: nowrap; width: auto; gap: 8px; }
    #cloud .cloud-harnesses .mcp-hn { padding: 7px; gap: 0; }
    .cloud-hn-name {
      position: absolute; width: 1px; height: 1px; overflow: hidden;
      clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap;
    }
    /* Two clean lines ("https://cloud." / "pilotprotocol.network/mcp") beside
       the Copy pill, instead of a mid-word wrap. */
    .cloud-strip .install-copy { font-size: 12px; gap: 10px; padding: 12px 12px 12px 14px; }
    #cloud .install-copy .ic-cmd { overflow-wrap: normal; }
    .cloud-strip .install-copy .ic-tail { display: inline-block; }
  }
  @media (max-width: 440px) {
    #cloud .cloud-strip .cloud-harnesses { gap: 6px; }
    .cloud-strip .install-copy { font-size: 11.5px; }
    .cloud-strip .install-copy .ic-label { font-size: 11px; padding: 4px 9px; }
  }
  /* Too narrow for the URL tail beside the pill: drop the pill beneath it.
     The two CTAs no longer fit side by side either, so stack them. */
  @media (max-width: 359px) {
    .cloud-strip .install-copy { flex-wrap: wrap; row-gap: 10px; }
    .cloud-strip .install-copy .ic-cmd { flex-basis: 100%; }
    .cloud-ctas { flex-wrap: wrap; }
    .cloud-ctas .btn { flex-basis: 100%; }
  }
  @media (max-width: 319px) {
    #cloud .cloud-strip .cloud-harnesses { gap: 4px; }
    #cloud .cloud-harnesses .mcp-hn { padding: 4px; }
  }
  @media (hover: none) and (pointer: coarse) {
    .cloud-card {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      background: color-mix(in srgb, var(--bg-2) 94%, var(--bg));
    }
  }

  .appstore-callout {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    margin-bottom: 20px;
    border-radius: 0;
    border: 1px solid color-mix(in srgb, var(--accent) 38%, transparent);
    /* Frosted glass: translucent fill + backdrop blur so the page shows through. */
    background: color-mix(in srgb, var(--bg-2) 55%, transparent);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    backdrop-filter: blur(18px) saturate(1.4);
    /* Soft outer lift + inner top-edge sheen for the glass highlight. */
    box-shadow:
      0 8px 32px color-mix(in srgb, #000 22%, transparent),
      inset 0 1px 0 color-mix(in srgb, #fff 14%, transparent),
      inset 0 0 0 1px color-mix(in srgb, #fff 4%, transparent);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, background 0.2s, box-shadow 0.2s, transform 0.2s;
  }
  .appstore-callout > * { position: relative; z-index: 1; }

  /* ---- Mobile scroll performance ----------------------------------------
     backdrop-filter re-blurs whatever is behind these cards on every scroll
     frame, which stutters on touch GPUs. On touch devices swap the frosted
     glass for a near-solid fill and stop the expensive rotating conic blur.
     Desktop (fine pointer) keeps the live glass effect. */
  @media (hover: none) and (pointer: coarse) {
    .appstore-callout {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      background: color-mix(in srgb, var(--bg-2) 94%, var(--bg));
    }
    /* The App Store callout's rotating conic-gradient "spotlight" (blur 40px)
       repaints continuously — pause it on touch devices. */
    .ac-featured::before { animation: none; }
  }
  /* MCP section — harness logo row + typewriter cursor. */
  .mcp-harnesses {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }
  .mcp-hn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 9px 14px 9px 11px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 15px;
    letter-spacing: 0.02em;
    color: var(--ink);
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  /* On hover, wash the chip in the logo's own brand colour. */
  .mcp-hn:hover {
    border-color: color-mix(in srgb, var(--logo-color, var(--accent)) 55%, var(--line));
    background: color-mix(in srgb, var(--logo-color, var(--accent)) 8%, transparent);
  }
  /* Real brand logos as masks, each tinted with its own brand colour. */
  .mcp-hn-i {
    width: 24px; height: 24px; flex: none;
    background: var(--logo-color, currentColor);
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
  }
  /* Director: scale the left-hand copy up so it reads proportional to the TUI,
     and centre it vertically against the taller terminal. */
  #director .how-grid { align-items: center; }
  #director .how-lede { font-size: clamp(26px, 2.8vw, 38px); margin-bottom: 22px; }
  #director .how-grid > div:first-child p { font-size: 20px; line-height: 1.55; }
  #director .how-grid > div:first-child p a { font-size: 19px; }
  .tw-cursor {
    display: inline-block;
    width: 0.62em;
    height: 1.05em;
    margin-left: 1px;
    transform: translateY(0.16em);
    background: var(--accent);
    animation: tw-blink 1.05s steps(1) infinite;
  }
  @keyframes tw-blink { 0%, 50% { opacity: 1; } 50.01%, 100% { opacity: 0; } }

  .mom-name-hl { letter-spacing: 0.02em; }
  .mom-nb { white-space: nowrap; }

  /* ===== Standardised vertical rhythm across all homepage sections ========
     .section#id beats the plain #id overrides scattered above, so every
     section gets the same top/bottom breathing room. Hero is excluded. */
  .section#fit, .section#protocol, .section#data-agents, .section#director,
  .section#appstore, .section#numbers, .section#open-source, .section#paths {
    padding-top: 60px;
    padding-bottom: 60px;
  }
  @media (max-width: 900px) {
    .section#fit, .section#protocol, .section#data-agents, .section#director,
    .section#appstore, .section#numbers, .section#open-source, .section#paths {
      padding-top: 44px;
      padding-bottom: 44px;
    }
  }
  /* pilot-mom continues the data service agents section above it. */
  .section#director { padding-top: 20px; }
  /* ===== Network stats — three registry figures, then two catalogue counts,
     each with its definition underneath ===================================== */
  #numbers .stats {
    gap: 0;
    border-radius: 0;
    overflow: hidden;
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }
  #numbers .stat {
    grid-column: span 2;
    min-height: 0;
    justify-content: flex-start;
    gap: 10px;
    padding: 34px 32px 30px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  #numbers .stat:nth-child(n+4) { grid-column: span 3; border-bottom: 0; }
  #numbers .stat:nth-child(3), #numbers .stat:nth-child(5) { border-right: 0; }
  #numbers .stat .note { margin: 2px 0 0; max-width: 40ch; font-size: 14px; line-height: 1.5; }
  #numbers .stat .note code { font-size: 0.92em; }
  @media (max-width: 760px) {
    #numbers .stats { grid-template-columns: minmax(0, 1fr); }
    #numbers .stat, #numbers .stat:nth-child(n+4) { grid-column: auto; border-right: 0; border-bottom: 1px solid var(--line); padding: 28px 22px 24px; }
    #numbers .stat:last-child { border-bottom: 0; }
  }
  /* Small green header row (dot + label) sits above the big number. */
  #numbers .stat-top {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  #numbers .stat-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
    animation: mom-pulse 1.6s ease-in-out infinite;
  }
  #numbers .stat-top.is-static { color: var(--ink-dim); }
  #numbers .stat .big {
    font-size: clamp(44px, 4.6vw, 72px);
    line-height: 0.92;
    margin-top: 4px;
  }
  /* Tint the number with a subtle vertical accent gradient for depth. */
  #numbers .stat .big {
    background: linear-gradient(180deg, var(--ink) 0%, color-mix(in srgb, var(--ink) 78%, var(--accent)) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  #numbers .stat .lbl {
    font-family: var(--sans);
    font-size: 17px;
    font-weight: 500;
    color: var(--ink);
    letter-spacing: -0.005em;
    text-transform: none;
  }

  /* ===== MOM terminal — animated planning demo ============================ */
  /* Green outline + glow around the whole shell. */
  /* .mom-shell inherits the shared green rounded .term styling (system.css). */
  @keyframes mom-pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }

  .term-body.mom-term {
    min-height: 13.5em;
    font-size: clamp(12.5px, 1.1vw, 15px);
    line-height: 1.55;
    padding: 22px 20px;
  }
  /* Emitted rows fade + slide + un-blur in. JS adds .in on the next frame. */
  .mom-term .mom-row {
    opacity: 0;
    transform: translateY(9px) scale(0.99);
    filter: blur(3px);
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.22, 0.61, 0.36, 1), filter 0.4s ease;
  }
  .mom-term .mom-row.in { opacity: 1; transform: none; filter: none; }
  .mom-term .mom-spacer { height: 0.5em; }

  /* Query line. */
  .mom-term .mom-prompt { color: var(--accent); font-weight: 700; }
  .mom-term .mom-cmd { color: #f2b45a; font-weight: 700; }
  .mom-term .mom-query { color: #f4f2ec; }
  /* Rest of the real CLI: subcommand/agent dim-white, --wait flag muted. */
  .mom-term .mom-flag { color: #cfcdc4; }
  .mom-term .mom-wait { color: #7d7d76; }

  /* Thinking + plan header. Give the plan header room before the steps. */
  .mom-term .mom-think { color: #cfcdc4; }
  .mom-term .mom-think.is-plan { margin-bottom: 10px; }
  .mom-term .mom-ok { color: var(--accent); font-weight: 700; }
  .mom-term .mom-ach { color: var(--accent); font-weight: 600; }
  .mom-term .mom-spin { display: inline-block; width: 1.1em; color: var(--accent); }

  /* A plan step: badge/logo on the left (flex); to its right a column with the
     name+pill row on top and the description beneath. Flex + a wrapper make the
     spacing structural, so it can never render glued together. */
  .mom-term .mom-step {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 6px 0;
  }
  .mom-term .mom-main { flex: 1; min-width: 0; }
  .mom-term .mom-head {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  /* Explicit margin as a fallback in case flex `gap` doesn't apply, so the
     name and pill are never glued together. */
  .mom-term .mom-head > * + * { margin-left: 10px; }
  /* Steps are spaced by padding; no divider line needed between them. */
  .mom-term .mom-step + .mom-step {
    padding-top: 8px;
  }
  .mom-term .mom-n {
    display: inline-flex; align-items: center; justify-content: center;
    width: 1.9em; height: 1.9em;
    border-radius: 50%;
    color: #0b0b0a; font-weight: 800; font-size: 0.82em;
    flex: none;
    background: var(--sc, var(--accent));
    box-shadow: 0 0 14px color-mix(in srgb, var(--sc, var(--accent)) 55%, transparent);
  }
  .mom-term .mom-ico {
    width: 1.9em; height: 1.9em;
    border-radius: 7px;
    object-fit: cover; flex: none;
    box-shadow: 0 0 14px color-mix(in srgb, var(--sc, var(--accent)) 45%, transparent);
  }
  .mom-term .mom-name {
    color: var(--sc, #f4f2ec);
    font-weight: 600;
  }
  /* Highlighted tool names get a tinted pill in the step's own colour. */
  .mom-term .mom-step.is-hl .mom-name {
    padding: 2px 10px;
    border-radius: 6px;
    background: color-mix(in srgb, var(--sc, var(--accent)) 20%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--sc, var(--accent)) 55%, transparent);
  }
  .mom-term .mom-pill {
    font-size: 0.66em;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    padding: 3px 11px;
    border-radius: 999px;
    font-weight: 700;
    flex: none;
    white-space: nowrap;
    color: var(--sc, var(--accent));
    background: color-mix(in srgb, var(--sc, var(--accent)) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--sc, var(--accent)) 55%, transparent);
  }
  .mom-term .mom-desc {
    margin-top: 4px;
    color: #9a9a92;
    font-size: 0.92em;
    line-height: 1.4;
  }
  /* Plan-key labels ("calls" / "handoff") that head each group of steps. */
  .mom-term .mom-section {
    color: #7d7d76;
    font-size: 0.78em;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    margin: 10px 0 2px;
  }
  /* Step descriptions that are literal pilotctl commands. */
  .mom-term .mom-code {
    font-family: var(--mono);
    font-size: 0.85em;
    color: #8f8f88;
    word-break: break-word;
  }
  /* Success banner — the task is done, so make it clearly stand out. */
  .mom-term .mom-done {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 1.1em;
    padding: 12px 16px;
    border-radius: 10px;
    color: var(--accent);
    font-weight: 700;
    font-size: 1.02em;
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 55%, transparent);
    box-shadow: 0 0 26px color-mix(in srgb, var(--accent) 24%, transparent);
  }
  /* Circular check chip at the start of the banner. */
  .mom-term .mom-done::before {
    content: "✓";
    display: inline-flex; align-items: center; justify-content: center;
    width: 1.5em; height: 1.5em;
    flex: none;
    border-radius: 50%;
    background: var(--accent);
    color: #0b0b0a;
    font-size: 0.85em;
    font-weight: 800;
  }
  /* Main row (heading/rail on the left, featured on the right). */
  .ac-main { display: flex; flex-direction: row; align-items: center; gap: 26px; padding: 28px 32px; }
  /* Featured app on the left, "Discover the App Store" text on the right. */
  .ac-main .ac-featured { order: 0; }
  .ac-main .ac-top { order: 1; }
  /* Green developer CTA strip pinned to the bottom edge. */
  .ac-devstrip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 15px 44px;
    background: var(--accent);
    color: #0b0b0a;
    text-decoration: none;
    transition: filter 0.15s ease;
  }
  .ac-devstrip:hover { filter: brightness(1.05); }
  .ads-copy { font-size: 18px; letter-spacing: -0.01em; }
  .ads-copy b { font-weight: 600; }
  .ads-btn {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #0b0b0a;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 500;
    padding: 10px 18px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .ac-devstrip:hover .ads-btn .arr { transform: translateX(3px); }
  .ads-btn .arr { transition: transform 0.15s ease; }
  /* Left column: eyebrow → heading → sub → floating icon rail, stacked and
     left-aligned. Takes the room the featured panel doesn't. */
  .ac-top {
    flex: 1 1 auto;
    min-width: 0;
    /* Stretch to the full height of the callout and centre content, so the whole
       left side is clickable — not just the text box. */
    align-self: stretch;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 18px;
    text-decoration: none;
    color: inherit;
  }
  .appstore-callout .ac-top .ac-body { flex: none; }
  /* Rail spans the full left column and spreads its tiles so it fills the row
     instead of leaving a dead gap before the featured divider. */
  .appstore-callout .ac-top .ac-rail {
    width: 100%;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    min-height: auto;
    margin-top: 4px;
  }
  /* Line the icons up in a straight row — no floating/drift. */
  .appstore-callout .ac-top .ac-rail .ac-tile { animation: none; transform: none; }
  /* Featured-app carousel — a compact right-hand panel, divided by a left rule. */
  .ac-featured {
    position: relative;
    isolation: isolate;
    flex: 0 0 clamp(360px, 37%, 470px);
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 18px;
    border-right: 1px solid color-mix(in srgb, var(--ink) 40%, transparent);
    padding-right: 34px;
    /* Extend fully to the callout's edges (cancel .ac-main's 28px vertical +
       32px horizontal padding) so the fill leaves no gap. */
    margin-top: -28px;
    margin-bottom: -28px;
    padding-top: 28px;
    padding-bottom: 28px;
    padding-left: 32px;
    margin-left: -32px;
    border-radius: 0;
    overflow: hidden;
    /* Flat base tint fills the ENTIRE panel so there are never dark corners;
       a radial hotspot adds depth on top of it. */
    background:
      radial-gradient(130% 100% at 22% 8%,
        color-mix(in srgb, var(--accent) 5%, transparent) 0%,
        transparent 70%),
      color-mix(in srgb, var(--accent) 3%, transparent);
  }
  /* Slow rotating conic sheen behind the card — the "spotlight". A very large
     element so even after blur its bright lobes always cover the whole panel. */
  .ac-featured::before {
    content: "";
    position: absolute;
    z-index: -1;
    left: -100%; top: -100%;
    width: 300%; height: 300%;
    background: conic-gradient(from 0deg,
      color-mix(in srgb, var(--accent) 8%, transparent) 0deg,
      color-mix(in srgb, var(--accent) 3%, transparent) 90deg,
      color-mix(in srgb, var(--accent) 8%, transparent) 180deg,
      color-mix(in srgb, var(--accent) 3%, transparent) 270deg,
      color-mix(in srgb, var(--accent) 8%, transparent) 360deg);
    filter: blur(40px);
    opacity: 0.5;
    animation: acf-spot 9s linear infinite;
  }
  @keyframes acf-spot { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) {
    .ac-featured::before { animation: none; }
  }
  /* Keep all card content above the spotlight. */
  .ac-featured > * { position: relative; z-index: 1; }
  /* "Featured" now a filled green pill badge. */
  .acf-label {
    flex: none;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: #0b0b0a;
    background: var(--accent);
    padding: 5px 12px;
    border-radius: 999px;
    box-shadow: 0 0 18px color-mix(in srgb, var(--accent) 45%, transparent);
  }
  /* Inline SVG star — scales and centres cleanly, unlike the text glyph. */
  .acf-star {
    flex: none;
    width: 13px;
    height: 13px;
    display: block;
    fill: currentColor;
  }
  .acf-viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
    height: 152px;
  }
  .acf-card {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 12px;
    text-decoration: none;
    color: inherit;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform: translateX(-40px);
    transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.55s ease, visibility 0s linear 0.55s;
  }
  .acf-card.is-active { opacity: 1; visibility: visible; transform: translateX(0); pointer-events: auto; transition-delay: 0s; }
  .acf-card:hover .acf-name { color: var(--accent-text); }
  .acf-card.is-exit { opacity: 0; transform: translateX(40px); }
  /* App-icon rendering (ported from appstore.css so the callout can reuse
     the AppIcon component without importing the whole App Store stylesheet).
     :global() because .app-icon is rendered by the AppIcon component, which
     Astro scopes to a different cid than this page. */
  .ac-featured :global(.app-icon) {
    --c: var(--accent); position: relative; flex: none; display: grid; place-items: center;
    border-radius: 13px; overflow: hidden; isolation: isolate; background: var(--c);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.12), inset 0 -10px 22px rgba(0,0,0,0.22);
  }
  .ac-featured :global(.app-icon::after) {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(160deg, rgba(255,255,255,0.22), transparent 46%); pointer-events: none;
  }
  .ac-featured :global(.app-icon .logo) {
    display: block; width: 52%; height: 52%; background: #fff;
    -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
    -webkit-mask-position: center; mask-position: center;
    -webkit-mask-size: contain; mask-size: contain;
  }
  .ac-featured :global(.app-icon[data-ink="true"] .logo) { background: #0b0b0a; }
  .ac-featured :global(.app-icon[data-app="io.pilot.mysql"] .logo) { width: 78%; height: 78%; }
  .ac-featured :global(.app-icon.is-image) { background: var(--c); }
  .ac-featured :global(.app-icon.is-image::after) { background: linear-gradient(160deg, rgba(255,255,255,0.10), transparent 46%); }
  .ac-featured :global(.app-icon .logo-img) { display: block; width: 100%; height: 100%; }
  .ac-featured :global(.app-icon.is-image.pad .logo-img) { width: 72%; height: 72%; }
  .ac-featured :global(.app-icon.sz-88) { width: 88px; height: 88px; border-radius: 19px; }
  .acf-head { display: flex; align-items: center; gap: 18px; min-width: 0; }
  .acf-name {
    font-family: var(--sans);
    font-size: 27px;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .acf-desc {
    font-size: 16px;
    line-height: 1.45;
    color: var(--accent-text);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    .acf-card { transition: opacity 0.3s ease; transform: none; }
    .acf-card.is-exit { transform: none; }
  }
  /* Narrow: stack cleanly — featured drops below with a top divider. Fully
     resets the desktop edge-extension (negative margins, rounded corner,
     side divider, spotlight) so nothing misaligns or overflows on mobile. */
  @media (max-width: 760px) {
    .ac-main { flex-direction: column; align-items: stretch; gap: 20px; padding: 24px 22px; }
    /* Stacked: text first, featured below. */
    .ac-main .ac-top { order: 0; }
    .ac-main .ac-featured { order: 1; }
    .ac-featured {
      flex: none;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
      /* wipe every desktop edge trick */
      margin: 0;
      padding: 20px 0 0;
      border: none;
      border-top: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
      border-radius: 0;
      background: none;
      overflow: visible;
    }
    .ac-featured::before { display: none; }   /* no spotlight on mobile */
    .acf-viewport { height: auto; min-height: 108px; }
    /* Smaller icon + text so the featured card fits neatly on phones. */
    .ac-featured :global(.app-icon.sz-88) { width: 56px; height: 56px; border-radius: 13px; }
    .acf-head { gap: 13px; }
    .acf-name { font-size: 20px; }
    .acf-desc { font-size: 13.5px; -webkit-line-clamp: 2; }
    .ac-devstrip { flex-direction: column; align-items: flex-start; gap: 12px; padding: 18px 22px; }
  }
  .appstore-callout:hover {
    border-color: color-mix(in srgb, var(--accent) 65%, transparent);
    background: color-mix(in srgb, var(--bg-2) 68%, transparent);
    transform: translateY(-2px);
    box-shadow:
      0 14px 40px color-mix(in srgb, #000 28%, transparent),
      0 0 0 1px color-mix(in srgb, var(--accent) 22%, transparent),
      inset 0 1px 0 color-mix(in srgb, #fff 20%, transparent);
  }
  .appstore-callout .ac-eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-text);
    white-space: nowrap;
  }
  .appstore-callout .ac-body { display: flex; flex-direction: column; gap: 4px; flex: 1; }
  .appstore-callout .ac-body { gap: 6px; }
  .appstore-callout .ac-lead {
    font-family: var(--sans);
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 600;
    line-height: 1.15;
    color: var(--ink);
    letter-spacing: -0.02em;
  }
  .appstore-callout:hover .ac-lead { color: var(--accent-text); }
  .appstore-callout .ac-sub { font-size: 15px; color: var(--ink-dim); line-height: 1.5; }
  /* App-logo rail: a row of bordered tiles, one per app, ending in a "+N more"
     counter that signals the catalogue runs deeper than what's shown. */
  .appstore-callout .ac-rail { display: flex; align-items: center; gap: 10px; min-height: 104px; }
  .appstore-callout .ac-tile {
    width: 54px;
    height: 54px;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 9px;
    border: 1px solid var(--line-2);
    border-radius: 8px;
    background: var(--bg);
    transition: border-color 0.15s;
    --bx: 0px; --by: 0px;
    animation: ac-float 6s ease-in-out infinite;
    will-change: transform;
  }
  /* Each tile gets its own scattered baseline (--bx/--by) plus its own rhythm,
     so they drift around the zone freely instead of sitting on the row line. */
  .appstore-callout .ac-tile:nth-child(1) { --bx: 2px;  --by: -26px; animation-duration: 12s;   animation-delay: -0.4s; }
  .appstore-callout .ac-tile:nth-child(2) { --bx: -4px; --by: 18px;  animation-duration: 14.5s; animation-delay: -3.1s; }
  .appstore-callout .ac-tile:nth-child(3) { --bx: 3px;  --by: -12px; animation-duration: 11s;   animation-delay: -1.8s; }
  .appstore-callout .ac-tile:nth-child(4) { --bx: -2px; --by: 26px;  animation-duration: 15.5s; animation-delay: -5.2s; }
  .appstore-callout .ac-tile:nth-child(5) { --bx: 4px;  --by: -20px; animation-duration: 13s;   animation-delay: -6.4s; }
  .appstore-callout .ac-tile:nth-child(6) { --bx: -3px; --by: 8px;   animation-duration: 12.5s; animation-delay: -2.3s; }
  .appstore-callout .ac-tile:nth-child(7) { --bx: 2px;  --by: -28px; animation-duration: 14s;   animation-delay: -5.9s; }
  .appstore-callout .ac-tile:nth-child(8) { --bx: -4px; --by: 14px;  animation-duration: 11.5s; animation-delay: -1.0s; }
  .appstore-callout .ac-tile:nth-child(9) { --bx: 3px;  --by: -6px;  animation-duration: 15s;   animation-delay: -7.2s; }
  @keyframes ac-float {
    0%   { transform: translate(calc(var(--bx)),        calc(var(--by)));         }
    25%  { transform: translate(calc(var(--bx) + 4px),  calc(var(--by) - 5px)) rotate(-1.5deg); }
    50%  { transform: translate(calc(var(--bx) - 3px),  calc(var(--by) + 4px)) rotate(1deg);    }
    75%  { transform: translate(calc(var(--bx) + 3px),  calc(var(--by) + 5px)) rotate(-1deg);   }
    100% { transform: translate(calc(var(--bx)),        calc(var(--by)));         }
  }
  @media (prefers-reduced-motion: reduce) {
