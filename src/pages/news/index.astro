---
import BaseHead from '../../components/BaseHead.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { companyNews } from '../../data/blogPosts';
import '../../styles/system.css';

const title = 'Company News — Pilot Protocol';
const description = 'Announcements, company updates, and official news from Pilot Protocol.';
const canonicalUrl = 'https://pilotprotocol.network/news/';
const posts = [...companyNews].sort((a, b) => (b.iso_date || '').localeCompare(a.iso_date || ''));
---
<!DOCTYPE html>
<html lang="en">
<head>
  <BaseHead title={title} description={description} canonicalUrl={canonicalUrl} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: canonicalUrl,
  })}></script>
</head>
<body>
  <Nav active="news" />
  <main>
    <section class="news-hero">
      <div class="gridbg" aria-hidden="true"></div>
      <div class="wrap news-hero-inner">
        <div>
          <span class="news-eyebrow">Pilot Protocol / Newsroom</span>
          <h1>Company<br/><em>news.</em></h1>
        </div>
        <div class="news-intro">
          <p>Official announcements and company updates from the team building Pilot Protocol.</p>
          <div class="news-contacts">
            <a href="mailto:press@pilotprotocol.network">Press inquiries <span aria-hidden="true">↗</span></a>
            <a href="/press">Media resources <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>

    <section class="news-list" aria-labelledby="latest-news">
      <div class="wrap">
        <div class="news-section-head">
          <span class="news-eyebrow">Latest</span>
          <h2 id="latest-news">Announcements</h2>
        </div>
        <div class="news-grid">
          {posts.map((post, index) => (
            <a class:list={['news-card', index === 0 && 'is-featured']} href={`/news/${post.slug}`}>
              <div class="news-image">
                <img src={`/blog/${post.banner}`} alt="" loading={index === 0 ? 'eager' : 'lazy'} />
              </div>
              <div class="news-copy">
                <div class="news-meta">
                  <time datetime={post.iso_date}>{post.date}{post.year ? `, ${post.year}` : ', 2026'}</time>
                  <span>Company news</span>
                </div>
                <h3>{post.title}</h3>
                <p>{post.description}</p>
                <span class="news-read">Read announcement <i aria-hidden="true">→</i></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="news-resources">
      <div class="wrap resources-grid">
        <div>
          <span class="news-eyebrow">For media and evaluators</span>
          <h2>Facts, evidence,<br/><em>and assets.</em></h2>
        </div>
        <div class="resource-links">
          <a href="/press"><span>Brand and press kit</span><b>Logos, company facts, and media contacts</b><i aria-hidden="true">↗</i></a>
          <a href="/enterprise-readiness-report.pdf"><span>Enterprise readiness report</span><b>Architecture, controls, and deployment boundaries</b><i aria-hidden="true">↗</i></a>
          <a href="/pilot-native-use-cases.pdf"><span>Pilot-native use cases</span><b>Deployment patterns enabled by the network layer</b><i aria-hidden="true">↗</i></a>
          <a href="/roadmap"><span>Product roadmap</span><b>Current priorities and longer-term direction</b><i aria-hidden="true">→</i></a>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <style>
    .news-hero { position: relative; overflow: hidden; padding: 104px 0 82px; border-bottom: 1px solid var(--line); }
    .news-hero-inner, .resources-grid { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(280px, .75fr); gap: 64px; align-items: end; }
    .news-eyebrow { display: block; margin-bottom: 30px; font: 560 10px/1 var(--mono); letter-spacing: .15em; text-transform: uppercase; color: var(--ink-dim); }
    .news-hero h1, .news-resources h2 { margin: 0; font-weight: 500; line-height: .9; letter-spacing: -.055em; color: var(--ink); }
    .news-hero h1 { font-size: clamp(68px, 11vw, 164px); }
    .news-hero h1 em, .news-resources h2 em { font-family: var(--serif); font-weight: 400; font-style: italic; color: var(--accent-text); }
    .news-intro { padding-bottom: 8px; }
    .news-intro > p { max-width: 35ch; margin: 0 0 30px; font-size: clamp(18px, 2vw, 24px); line-height: 1.35; letter-spacing: -.02em; color: var(--ink-dim); }
    .news-contacts { display: flex; gap: 20px; flex-wrap: wrap; }
    .news-contacts a { font: 560 11px/1 var(--mono); letter-spacing: .06em; text-transform: uppercase; }
    .news-contacts span { color: var(--accent-text); }
    .news-list { padding: 100px 0 112px; }
    .news-section-head { display: grid; grid-template-columns: 180px 1fr; align-items: end; margin-bottom: 30px; }
    .news-section-head .news-eyebrow { margin: 0 0 8px; }
    .news-section-head h2 { margin: 0; font-size: clamp(34px, 4vw, 58px); font-weight: 520; letter-spacing: -.04em; }
    .news-grid { display: grid; gap: 18px; }
    .news-card { display: grid; grid-template-columns: minmax(300px, .9fr) minmax(0, 1.1fr); min-height: 440px; overflow: hidden; border: 1px solid var(--line); border-radius: 18px; background: var(--bg-2); transition: transform .18s ease, border-color .18s ease; }
    .news-card:hover { transform: translateY(-3px); border-color: var(--line-2); color: inherit; }
    .news-image { min-height: 340px; overflow: hidden; background: var(--term-bg); }
    .news-image img { width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease; }
    .news-card:hover img { transform: scale(1.015); }
    .news-copy { display: flex; flex-direction: column; padding: clamp(30px, 5vw, 64px); }
    .news-meta { display: flex; gap: 12px; flex-wrap: wrap; font: 520 9px/1.3 var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--ink-dim); }
    .news-meta span { color: var(--accent-text); }
    .news-copy h3 { max-width: 18ch; margin: auto 0 18px; font-size: clamp(30px, 4vw, 54px); font-weight: 520; line-height: 1.01; letter-spacing: -.045em; }
    .news-copy p { max-width: 56ch; margin: 0 0 34px; color: var(--ink-dim); font-size: 15px; line-height: 1.55; }
    .news-read { display: flex; justify-content: space-between; gap: 16px; padding-top: 17px; border-top: 1px solid var(--line); font-size: 13px; font-weight: 580; }
    .news-read i { color: var(--accent-text); font-style: normal; }
    .news-resources { padding: 102px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--bg-2); }
    .news-resources h2 { max-width: 11ch; font-size: clamp(48px, 6vw, 84px); }
    .resource-links { display: grid; border-top: 1px solid var(--line); }
    .resource-links a { position: relative; display: grid; gap: 7px; padding: 22px 36px 22px 0; border-bottom: 1px solid var(--line); }
    .resource-links a:hover { color: inherit; }
    .resource-links span { font-size: 17px; font-weight: 590; }
    .resource-links b { color: var(--ink-dim); font-size: 13px; font-weight: 400; line-height: 1.45; }
    .resource-links i { position: absolute; right: 2px; top: 26px; color: var(--accent-text); font-style: normal; }
    @media (max-width: 820px) {
      .news-hero { padding: 68px 0 58px; }
      .news-hero-inner, .resources-grid { grid-template-columns: 1fr; gap: 42px; align-items: start; }
      .news-section-head { grid-template-columns: 1fr; gap: 12px; }
      .news-card { grid-template-columns: 1fr; min-height: 0; }
      .news-image { min-height: 260px; aspect-ratio: 16 / 9; }
      .news-copy { min-height: 380px; }
      .news-list { padding: 72px 0 82px; }
      .news-resources { padding: 72px 0; }
    }
    @media (max-width: 480px) {
      .news-hero h1 { font-size: clamp(58px, 20vw, 80px); }
      .news-copy { min-height: 340px; padding: 26px 22px; }
      .news-copy h3 { margin-top: 52px; font-size: 30px; }
      .news-image { min-height: 210px; }
    }
    @media (prefers-reduced-motion: reduce) { .news-card, .news-image img { transition: none; } .news-card:hover, .news-card:hover img { transform: none; } }
  </style>
</body>
</html>
