---
import BaseHead from '../../components/BaseHead.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { learnGuides } from '../../data/learnGuides';
import '../../styles/system.css';

const title = 'Pilot Protocol Learning Center: Guides and Concepts';
const description = 'Original technical guides to agent networking, transport, cryptographic identity, trust, and deployment boundaries from the Pilot Protocol team.';
const canonicalUrl = 'https://pilotprotocol.network/learn/';
const tracks = ['Foundations', 'Transport', 'Security'] as const;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <BaseHead title={title} description={description} canonicalUrl={canonicalUrl} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: canonicalUrl,
    author: { '@id': 'https://pilotprotocol.network/#organization' },
    hasPart: learnGuides.map((guide) => ({
      '@type': 'TechArticle',
      headline: guide.title,
      url: `${canonicalUrl}${guide.slug}`,
    })),
  })}></script>
</head>
<body>
  <Nav active="blog" />
  <main>
    <section class="learn-hero">
      <div class="gridbg" aria-hidden="true"></div>
      <div class="wrap learn-hero-grid">
        <div>
          <span class="learn-eyebrow">Learning center</span>
          <h1>Understand the<br/><em>network layer.</em></h1>
        </div>
        <div class="learn-intro">
          <p>Short paths through the decisions that matter when agents need to find and reach one another across machines, clouds, and organizations.</p>
          <p>These guides keep four questions separate: <b>Can the peers connect?</b> <b>Who is connecting?</b> <b>What may the application do?</b> <b>What evidence remains?</b></p>
        </div>
      </div>
    </section>

    <section class="learn-map" aria-labelledby="choose-path">
      <div class="wrap">
        <div class="learn-section-head">
          <span class="learn-eyebrow">Choose a path</span>
          <h2 id="choose-path">Start with the question<br/><em>in front of you.</em></h2>
        </div>
        <div class="path-grid">
          <a href="/learn/what-is-pilot-protocol"><span>01 · Foundations</span><h3>What does Pilot provide?</h3><p>Map addresses, tunnels, discovery, trust, apps, and application authority to the right layers.</p><i>Start here →</i></a>
          <a href="/learn/nats-vs-grpc-agent-messaging"><span>02 · Transport</span><h3>Which messaging stack fits?</h3><p>Compare request/response, brokers, persistent paths, and overlays without treating them as interchangeable.</p><i>Compare options →</i></a>
          <a href="/learn/how-are-network-agent-tokens-different"><span>03 · Security</span><h3>Which credential proves what?</h3><p>Separate daemon identity and tunnel admission from API authorization, roles, data access, and approval.</p><i>Review identity →</i></a>
        </div>
      </div>
    </section>

    <section class="learn-library" aria-labelledby="guide-library">
      <div class="wrap">
        <div class="learn-section-head library-head">
          <span class="learn-eyebrow">Guide library</span>
          <h2 id="guide-library">Eight focused<br/><em>technical guides.</em></h2>
        </div>
        {tracks.map((track) => (
          <section class="track" aria-labelledby={`track-${track.toLowerCase()}`}>
            <div class="track-label"><span>{String(tracks.indexOf(track) + 1).padStart(2, '0')}</span><h3 id={`track-${track.toLowerCase()}`}>{track}</h3></div>
            <div class="guide-list">
              {learnGuides.filter((guide) => guide.track === track).map((guide) => (
                <a href={`/learn/${guide.slug}`}>
                  <div><h4>{guide.title}</h4><p>{guide.description}</p></div>
                  <span><time>{guide.date}</time><i aria-hidden="true">↗</i></span>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>

    <section class="learn-boundary">
      <div class="wrap boundary-grid">
        <div><span class="learn-eyebrow">Evaluation rule</span><h2>Connectivity is only<br/><em>one decision.</em></h2></div>
        <div>
          <p>An authenticated tunnel proves which daemon is on the other end and protects traffic in transit. It does not, by itself, approve a purchase, release protected data, or let an agent bind an organization.</p>
          <p>Use the <a href="/trust">Trust Center</a> for implemented security boundaries, <a href="/governance">Governance</a> for the shared-responsibility model, and <a href="/docs/">Documentation</a> for version-specific commands.</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <style>
    .learn-eyebrow { display: block; margin-bottom: 24px; color: var(--ink-dim); font: 560 10px/1 var(--mono); letter-spacing: .15em; text-transform: uppercase; }
    .learn-hero { position: relative; overflow: hidden; padding: 104px 0 88px; border-bottom: 1px solid var(--line); }
    .learn-hero-grid, .boundary-grid { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(300px, .9fr); gap: 72px; align-items: end; }
    .learn-hero h1, .learn-section-head h2, .learn-boundary h2 { margin: 0; font-weight: 500; line-height: .92; letter-spacing: -.052em; }
    .learn-hero h1 { font-size: clamp(62px, 9vw, 138px); }
    h1 em, h2 em { color: var(--accent-text); font-family: var(--serif); font-style: italic; font-weight: 400; }
    .learn-intro { display: grid; gap: 22px; }
    .learn-intro p { margin: 0; color: var(--ink-dim); font-size: clamp(17px, 1.7vw, 22px); line-height: 1.5; }
    .learn-intro b { color: var(--ink); font-weight: 550; }
    .learn-map, .learn-library, .learn-boundary { padding: 104px 0; }
    .learn-library { border-block: 1px solid var(--line); background: var(--bg-2); }
    .learn-section-head { margin-bottom: 52px; }
    .learn-section-head h2, .learn-boundary h2 { font-size: clamp(46px, 6vw, 82px); }
    .path-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
    .path-grid > a { display: flex; flex-direction: column; min-height: 330px; padding: 30px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); color: inherit; }
    .path-grid span, .track-label > span { color: var(--accent-text); font: 520 9px/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; }
    .path-grid h3 { margin: 76px 0 14px; font-size: 25px; letter-spacing: -.025em; }
    .path-grid p { margin: 0; color: var(--ink-dim); font-size: 14px; line-height: 1.55; }
    .path-grid i { margin-top: auto; padding-top: 28px; color: var(--accent-text); font: 520 10px/1 var(--mono); font-style: normal; letter-spacing: .08em; text-transform: uppercase; }
    .track { display: grid; grid-template-columns: 220px 1fr; border-top: 1px solid var(--line-2); }
    .track:last-child { border-bottom: 1px solid var(--line-2); }
    .track-label { display: flex; gap: 18px; padding: 30px 24px 30px 0; border-right: 1px solid var(--line-2); }
    .track-label h3 { margin: 0; font-size: 19px; }
    .guide-list > a { display: grid; grid-template-columns: 1fr auto; gap: 32px; padding: 28px 0 28px 30px; border-bottom: 1px solid var(--line); color: inherit; }
    .guide-list > a:last-child { border-bottom: 0; }
    .guide-list h4 { margin: 0 0 8px; font-size: 22px; letter-spacing: -.02em; }
    .guide-list p { max-width: 72ch; margin: 0; color: var(--ink-dim); font-size: 14px; line-height: 1.55; }
    .guide-list > a > span { display: flex; gap: 20px; align-items: center; color: var(--ink-dim); font: 500 9px/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; }
    .guide-list i { color: var(--accent-text); font-size: 16px; font-style: normal; }
    .boundary-grid { align-items: start; }
    .boundary-grid > div:last-child { display: grid; gap: 22px; padding-top: 8px; }
    .boundary-grid p { margin: 0; color: var(--ink-dim); font-size: 17px; line-height: 1.65; }
    @media (max-width: 900px) {
      .learn-hero-grid, .boundary-grid { grid-template-columns: 1fr; gap: 42px; }
      .path-grid { grid-template-columns: 1fr; }
      .path-grid > a { min-height: 260px; }
      .path-grid h3 { margin-top: 48px; }
      .track { grid-template-columns: 150px 1fr; }
    }
    @media (max-width: 620px) {
      .learn-hero { padding: 70px 0 58px; }
      .learn-hero h1 { font-size: clamp(50px, 15vw, 76px); }
      .learn-map, .learn-library, .learn-boundary { padding: 72px 0; }
      .track { grid-template-columns: 1fr; }
      .track-label { border-right: 0; border-bottom: 1px solid var(--line); }
      .guide-list > a { grid-template-columns: 1fr; gap: 18px; padding-left: 0; }
      .guide-list > a > span { justify-content: space-between; }
    }
  </style>
</body>
</html>
