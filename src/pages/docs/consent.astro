  title="Consent & Privacy Controls — Pilot Protocol"
  description="Four features ship on by default in Pilot Protocol: telemetry, broadcasts, reviews, and skill injection. Risk profiles, benefits, and opt-out commands for each."
  activePage="consent"
  canonicalPath="/docs/consent"
  prev={{ label: "App Store", href: "/docs/app-store" }}
  next={{ label: "Trust & Handshakes", href: "/docs/trust" }}
>
  <style>
    .risk-low { color: var(--green, #22c55e); font-size: 0.85em; font-family: var(--mono); }
    .risk-medium { color: var(--amber, #f59e0b); font-size: 0.85em; font-family: var(--mono); }
    .risk-badge { display: inline-block; padding: 3px 10px; border-radius: 4px; font-size: 0.8em; font-family: var(--mono); margin-bottom: 1rem; }
    .risk-low-badge { background: rgba(34,197,94,0.12); color: #22c55e; border: 1px solid rgba(34,197,94,0.3); }
    .risk-medium-badge { background: rgba(245,158,11,0.12); color: #f59e0b; border: 1px solid rgba(245,158,11,0.3); }
    .risk-none-badge { background: rgba(148,163,184,0.12); color: var(--ink-dim, #94a3b8); border: 1px solid rgba(148,163,184,0.3); }
    .section-divider { border: none; border-top: 1px solid var(--line, rgba(255,255,255,0.08)); margin: 2.5rem 0; }
  </style>
