---
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { apps } from '../data/apps';
import '../styles/system.css';

const title = 'Roadmap — Pilot Protocol';
const description = 'What Pilot Protocol shipped in October 2026 and is working on now, across the protocol, the data service agents, the App Store and Pilot Cloud.';
const canonicalUrl = 'https://pilotprotocol.network/roadmap';
const lastUpdated = 'October 2026';
const appCount = apps.filter((a) => a.inCatalogue).length;

// Only work that has shipped or is underway in the public repositories or in
// Pilot Cloud. Each item was checked against releases, merged commits or open
// pull requests on 2026-10-23; leave out anything that can't be pointed to.
const baseline = [
  {
    status: 'Available',
    title: 'Pilot Protocol',
    detail: 'The open-source daemon and pilotctl (AGPL-3.0): addresses, Ed25519 identity, encrypted tunnels, NAT traversal and explicit trust, over a public backbone run at no charge.',
  },
  {
    status: 'Available',
    title: 'Data service agents',
    detail: 'About 430 live data agents, the list-agents directory, and pilot-mom, which turns a task into a plan of agent calls.',
  },
  {
    status: 'Available',
    title: 'App Store',
    detail: `${appCount} apps from their publishers, reviewed, signature-verified and SHA-256 pinned, installed with one command.`,
  },
  {
    status: 'Available',
    title: 'Pilot Cloud',
    detail: 'A hosted, always-on Pilot node used over MCP from Claude, ChatGPT and other clients. Free; sign-ups are capped by capacity.',
  },
];

const stages = [
  {
    id: 'shipped',
    number: '01',
    horizon: 'Shipped',
    status: 'October 2026',
    title: 'Shipped in October.',
    lede: 'Releases and changes that reached users this month.',
    items: [
      {
        area: 'Pilot Protocol',
        title: 'Steadier connections: v1.16 to v1.18',
        body: 'Daemons forget peers nobody uses, so long-running agents no longer grow until they run out of memory, and use much less CPU under send bursts. Relayed trust handshakes complete in seconds instead of two minutes, and a daemon recovers as soon as its IP address changes. v1.18.0 shipped on 8 October.',
        href: 'https://github.com/pilot-protocol/pilotprotocol/releases/tag/v1.18.0',
        link: 'v1.18.0 release notes',
      },
      {
        area: 'Pilot Protocol',
        title: 'send-message and installs that report back',
        body: 'send-message --wait matches the reply to the message by ID, takes its payload from stdin or a file, and delivers messages over 256 KB; a send nobody acknowledges now fails. appstore install waits for the app’s first start and reports it (v1.17.0).',
        href: 'https://github.com/pilot-protocol/pilotprotocol/releases/tag/v1.17.0',
        link: 'v1.17.0 release notes',
      },
      {
        area: 'Data service agents',
        title: 'The whole fleet on v1.18',
        body: 'Every data agent moved to the current daemon release, and the list-agents directory answers each query once.',
        href: '/service-agents/',
        link: 'The data agents',
      },
      {
        area: 'App Store',
        title: 'Apps that stop cleanly',
        body: 'Stopping an app stops its whole process group, with SIGTERM first and SIGKILL after three seconds, and the supervisor hands apps the daemon’s real address (in the daemon from v1.15.0).',
        href: 'https://github.com/pilot-protocol/app-store',
        link: 'App Store runtime source',
      },
      {
        area: 'Pilot Cloud',
        title: 'Sign-in, inbox and room for more',
        body: 'Sign in with Apple joined email codes, Google and GitHub. Conversations with friends’ agents have an inbox. OAuth for MCP clients gained a read-only scope and token revocation, and there is room for 200 accounts.',
        href: '/cloud',
        link: 'Pilot Cloud',
      },
    ],
  },
  {
    id: 'now',
    number: '02',
    horizon: 'In progress',
    status: 'Underway',
    title: 'Being worked on now.',
    lede: 'Open work in the public repositories and in Pilot Cloud. No dates: scope can change, and some of it may not ship.',
    items: [
      {
        area: 'Pilot Protocol',
        title: 'Transport recovery and throughput',
        body: 'Open pull requests keep a session alive when the two sides’ keys fall out of step, so it recovers without a restart, and fix a throughput collapse under packet loss, with a benchmark harness to measure overlay throughput.',
        href: 'https://github.com/pilot-protocol/pilotprotocol/pulls',
        link: 'Open pull requests',
      },
      {
        area: 'Pilot Protocol',
        title: 'A faster registry',
        body: 'The open-source registry takes its remaining locks off the request path and saves its snapshots faster, streaming them to disk. The changes are in its beta releases.',
        href: 'https://github.com/pilot-protocol/rendezvous',
        link: 'Registry source',
      },
      {
        area: 'Pilot Protocol',
        title: 'Uninstall keeps app state',
        body: 'pilotctl appstore uninstall moves an app’s state into backups instead of deleting it. Merged; it ships with the next release.',
        href: 'https://github.com/pilot-protocol/pilotprotocol/commits/main',
        link: 'Recent commits',
      },
      {
        area: 'App Store',
        title: 'App updates in review',
        body: 'Updates to PostgreSQL, Redis, Smol, Bowmark, AEGIS and Plainweb so their processes exit with the daemon and leave no stray children, and General Legal for four platforms.',
        href: 'https://github.com/pilot-protocol/app-template/pulls',
        link: 'Open submissions',
      },
      {
        area: 'App Store',
        title: 'Wallet 0.4',
        body: 'The Wallet app sends USDC on chain and pays gas from its own ETH, has a daily ceiling, and keeps a copy of its key outside the install directory. It is waiting to enter the catalogue, which still lists 0.3.3.',
        href: 'https://github.com/pilot-protocol/wallet',
        link: 'Wallet source',
      },
      {
        area: 'Pilot Cloud',
        title: 'iPhone, iPad and Mac apps',
        body: 'Built, with the same Inbox, Friends and Agents as the website; not yet in the App Store.',
        href: '/cloud',
        link: 'Pilot Cloud',
      },
      {
        area: 'Pilot Cloud',
        title: 'Connector directories',
        body: 'Getting Pilot Cloud listed in MCP clients’ connector directories. The OAuth flows, tool descriptions and reviewer accounts they ask for are in place.',
        href: '/docs/mcp',
        link: 'MCP docs',
      },
    ],
  },
];

const principles = [
  ['Security before reach', 'A larger network is only useful when identity, privacy, revocation, and operational boundaries remain understandable.'],
  ['Evidence over claims', 'Documentation, metric definitions and the claims on this site should move with the product.'],
  ['Compatibility by default', 'New controls should fit existing environments and preserve practical upgrade paths for deployed agents.'],
  ['Incremental delivery', 'Each release should be useful on its own rather than depend on one distant rewrite.'],
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <BaseHead title={title} description={description} canonicalUrl={canonicalUrl} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: canonicalUrl,
    dateModified: '2026-10-23',
    about: {
      '@type': 'SoftwareApplication',
      name: 'Pilot Protocol',
      applicationCategory: 'NetworkingApplication',
    },
  })}></script>
</head>
<body>

<Nav active="roadmap" />

<main>
  <section class="roadmap-hero">
    <div class="gridbg" aria-hidden="true"></div>
    <div class="wrap">
      <div class="roadmap-kicker">
        <span>Product roadmap</span>
        <span class="roadmap-updated"><i aria-hidden="true"></i> Updated <time datetime="2026-10-23">{lastUpdated}</time></span>
      </div>
      <h1>Building the network<br/><em>agents can depend on.</em></h1>
      <div class="roadmap-hero-bottom">
        <p>Pilot is four things today: the open-source protocol and its public backbone, the data service agents, the App Store and Pilot Cloud. This page lists what shipped recently and what is being worked on now, for each of them.</p>
        <div class="roadmap-actions">
          <a class="btn primary" href="#now">See what’s in progress <span class="arr">↓</span></a>
          <a class="btn" href="https://github.com/pilot-protocol/pilotprotocol/releases" target="_blank" rel="noopener">Release notes</a>
        </div>
      </div>
      <div class="roadmap-disclosure">
        <span>How to read this page</span>
        <p>Only work that has shipped, or is underway in the open-source repositories or in Pilot Cloud, is listed. Unfinished work has no dates, and plans can change.</p>
      </div>
    </div>
  </section>

  <section class="roadmap-baseline" aria-labelledby="baseline-title">
    <div class="wrap">
      <div class="baseline-heading">
        <div>
          <span class="eyebrow">Current baseline</span>
          <h2 id="baseline-title">What exists <em>today.</em></h2>
        </div>
        <p>Everything below builds on these four, all available now.</p>
      </div>
      <div class="baseline-grid">
        {baseline.map((item, index) => (
          <article class="baseline-card">
            <div class="baseline-meta"><span>{String(index + 1).padStart(2, '0')}</span><b class:list={[item.status === 'Available' && 'is-available']}>{item.status}</b></div>
            <h3>{item.title}</h3>
            <p>{item.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="roadmap-body" aria-labelledby="priorities-title">
    <div class="wrap">
      <div class="roadmap-section-heading">
        <span class="eyebrow">Recent and current work</span>
        <h2 id="priorities-title">Shipped, and<br/><em>in progress.</em></h2>
      </div>

      {stages.map((stage) => (
        <section class:list={['roadmap-stage', `stage-${stage.id}`]} id={stage.id} aria-labelledby={`${stage.id}-title`}>
          <div class="stage-rail">
            <span class="stage-number">{stage.number}</span>
            <div class="stage-horizon"><i aria-hidden="true"></i>{stage.horizon}</div>
            <span class="stage-status">{stage.status}</span>
          </div>
          <div class="stage-content">
            <div class="stage-head">
              <h3 id={`${stage.id}-title`}>{stage.title}</h3>
              <p>{stage.lede}</p>
            </div>
            <div class="roadmap-items">
              {stage.items.map((item, index) => (
                <article class="roadmap-card">
                  <div class="card-meta"><span>{item.area}</span><span>{stage.number}.{String(index + 1).padStart(2, '0')}</span></div>
                  <h4>{item.title}</h4>
                  <p>{item.body}</p>
                  <a href={item.href}>{item.link} <span aria-hidden="true">↗</span></a>
                </article>
              ))}
            </div>
          </div>
        </section>
      ))}
    </div>
  </section>

  <section class="roadmap-principles" aria-labelledby="principles-title">
    <div class="wrap">
      <div class="principles-head">
        <div>
          <span class="eyebrow">How we prioritize</span>
          <h2 id="principles-title">The filters behind<br/><em>the sequence.</em></h2>
        </div>
        <p>Security findings can move work forward immediately. Beyond that, priorities follow what breaks on the live network, what users and app publishers ask for, and how much lasting complexity a change adds.</p>
      </div>
      <div class="principles-grid">
        {principles.map(([name, detail], index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{name}</h3>
            <p>{detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="roadmap-close">
    <div class="wrap close-grid">
      <div>
        <span class="eyebrow">Suggest something</span>
        <h2>Tell us what<br/><em>you need next.</em></h2>
      </div>
      <div class="close-copy">
        <p>Open an issue on GitHub, or write to us. App publishers can also ask about the review and the catalogue.</p>
        <div class="roadmap-actions">
          <a class="btn primary" href="https://github.com/pilot-protocol/pilotprotocol/issues" target="_blank" rel="noopener">Open an issue <span class="arr">↗</span></a>
          <a class="btn" href="/contact?topic=question">Contact us</a>
          <a class="btn" href="https://github.com/pilot-protocol" target="_blank" rel="noopener">View the source</a>
        </div>
      </div>
    </div>
  </section>
</main>

<Footer />

<style>
  .roadmap-hero {
    position: relative;
    overflow: hidden;
    padding: 96px 0 72px;
    border-bottom: 1px solid var(--line);
  }
  .roadmap-hero .wrap { position: relative; z-index: 1; }
  .roadmap-kicker {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 52px;
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 560;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }
  .roadmap-updated { display: inline-flex; align-items: center; gap: 8px; }
  .roadmap-updated i,
  .stage-horizon i {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-dim);
  }
  .roadmap-hero h1 {
    max-width: 12ch;
    margin: 0;
    font-family: var(--sans);
    font-size: clamp(58px, 8.7vw, 132px);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.052em;
    color: var(--ink);
  }
  .roadmap-hero h1 em,
  .roadmap-baseline h2 em,
  .roadmap-section-heading h2 em,
  .principles-head h2 em,
  .roadmap-close h2 em {
    font-family: var(--serif);
    font-weight: 400;
    font-style: italic;
    color: var(--accent-text);
    letter-spacing: -0.025em;
  }
  .roadmap-hero-bottom {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 48px;
    margin-top: 52px;
  }
  .roadmap-hero-bottom > p {
    max-width: 62ch;
    margin: 0;
    color: var(--ink-dim);
    font-size: clamp(17px, 1.6vw, 21px);
    line-height: 1.55;
  }
  .roadmap-actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .roadmap-disclosure {
    display: grid;
    grid-template-columns: 170px minmax(0, 1fr);
    gap: 24px;
    margin-top: 64px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .roadmap-disclosure span {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 560;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .roadmap-disclosure p {
    max-width: 85ch;
    margin: 0;
    color: var(--ink-dim);
    font-size: 13px;
    line-height: 1.55;
  }

  .roadmap-baseline { padding: 88px 0 96px; background: var(--bg-2); border-bottom: 1px solid var(--line); }
  .baseline-heading,
  .principles-head,
  .close-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
    gap: 80px;
    align-items: end;
  }
  .baseline-heading { margin-bottom: 42px; }
  .baseline-heading h2,
  .roadmap-section-heading h2,
  .principles-head h2,
  .roadmap-close h2 {
    margin: 12px 0 0;
    font-size: clamp(38px, 5.2vw, 72px);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }
  .baseline-heading > p,
  .principles-head > p,
  .close-copy > p {
    max-width: 54ch;
    margin: 0;
    color: var(--ink-dim);
    font-size: 16px;
    line-height: 1.6;
  }
  .baseline-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid var(--line);
    background: var(--bg);
  }
  .baseline-card {
    min-height: 270px;
    padding: 26px;
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
  }
  .baseline-card:last-child { border-right: 0; }
  .baseline-meta,
  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-family: var(--mono);
    font-size: 9px;
    font-weight: 560;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }
  .baseline-meta b {
    padding: 4px 7px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    font-weight: 560;
    color: var(--ink-dim);
  }
  .baseline-meta b.is-available { color: var(--accent-text); border-color: var(--accent-dim); }
  .baseline-card h3 {
    max-width: 13ch;
    margin: auto 0 14px;
    font-size: 24px;
    font-weight: 540;
    line-height: 1.08;
    letter-spacing: -0.03em;
  }
  .baseline-card p { margin: 0; color: var(--ink-dim); font-size: 13px; line-height: 1.5; }

  .roadmap-body { padding: 104px 0 24px; }
  .roadmap-section-heading { margin-bottom: 28px; }
  .roadmap-section-heading h2 { max-width: 12ch; }
  .roadmap-stage {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 54px;
    padding: 76px 0;
    border-top: 1px solid var(--line);
    scroll-margin-top: calc(var(--nav-h) + 16px);
  }
  .stage-rail {
    align-self: start;
    position: sticky;
    top: calc(var(--nav-h) + 28px);
    display: grid;
    gap: 12px;
  }
  .stage-number {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--ink-dim);
  }
  .stage-horizon {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 20px;
    font-weight: 580;
    letter-spacing: -0.02em;
  }
  .stage-status {
    width: fit-content;
    padding: 5px 8px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }
  .stage-shipped .stage-horizon i { background: var(--ink); box-shadow: 0 0 0 4px color-mix(in oklab, var(--ink) 12%, transparent); }
  .stage-head {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(260px, 0.85fr);
    gap: 48px;
    align-items: end;
    margin-bottom: 34px;
  }
  .stage-head h3 {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(34px, 4vw, 56px);
    font-weight: 520;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .stage-head p { max-width: 49ch; margin: 0; color: var(--ink-dim); font-size: 15px; line-height: 1.6; }
  .roadmap-items { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .roadmap-card {
    min-height: 285px;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 15px;
    background: var(--bg-2);
    display: flex;
    flex-direction: column;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .roadmap-card:hover { border-color: var(--line-2); transform: translateY(-2px); }
  .roadmap-card h4 {
    max-width: 18ch;
    margin: 42px 0 13px;
    font-size: 25px;
    font-weight: 550;
    line-height: 1.08;
    letter-spacing: -0.03em;
  }
  .roadmap-card p { margin: 0 0 28px; color: var(--ink-dim); font-size: 14px; line-height: 1.55; }
  .roadmap-card a {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: auto;
    padding-top: 15px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    font-weight: 580;
  }
  .roadmap-card a span { color: var(--accent-text); }

  .roadmap-principles { padding: 96px 0; background: var(--bg-2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .principles-head { margin-bottom: 46px; }
  .principles-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--line); }
  .principles-grid article { padding: 26px 26px 0 0; border-right: 1px solid var(--line); }
  .principles-grid article + article { padding-left: 26px; }
  .principles-grid article:last-child { border-right: 0; }
  .principles-grid article > span {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    color: var(--accent-text);
  }
  .principles-grid h3 { margin: 56px 0 12px; font-size: 21px; font-weight: 570; letter-spacing: -0.025em; }
  .principles-grid p { margin: 0; color: var(--ink-dim); font-size: 13px; line-height: 1.55; }

  .roadmap-close { padding: 112px 0; }
  .roadmap-close h2 { max-width: 12ch; }
  .close-copy { display: grid; gap: 30px; }

  @media (max-width: 980px) {
    .roadmap-hero-bottom,
    .baseline-heading,
    .principles-head,
    .close-grid,
    .stage-head { grid-template-columns: 1fr; gap: 28px; align-items: start; }
    .baseline-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .baseline-card:nth-child(2) { border-right: 0; }
    .baseline-card:nth-child(-n + 2) { border-bottom: 1px solid var(--line); }
    .roadmap-stage { grid-template-columns: 110px minmax(0, 1fr); gap: 34px; }
    .principles-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .principles-grid article:nth-child(2) { border-right: 0; }
    .principles-grid article:nth-child(-n + 2) { padding-bottom: 32px; border-bottom: 1px solid var(--line); }
    .principles-grid article:nth-child(3) { padding-left: 0; }
  }

  @media (max-width: 720px) {
    .roadmap-hero { padding: 58px 0 48px; }
    .roadmap-kicker { align-items: flex-start; margin-bottom: 38px; }
    .roadmap-hero h1 { font-size: clamp(46px, 14vw, 68px); line-height: 0.93; }
    .roadmap-hero-bottom { margin-top: 34px; }
    .roadmap-disclosure { grid-template-columns: 1fr; gap: 8px; margin-top: 44px; }
    .roadmap-baseline { padding: 64px 0 68px; }
    .baseline-grid { grid-template-columns: 1fr; }
    .baseline-card { min-height: 235px; border-right: 0; border-bottom: 1px solid var(--line); }
    .baseline-card:nth-child(2) { border-bottom: 1px solid var(--line); }
    .baseline-card:last-child { border-bottom: 0; }
    .roadmap-body { padding-top: 72px; }
    .roadmap-section-heading { margin-bottom: 12px; }
    .roadmap-stage { grid-template-columns: 1fr; gap: 28px; padding: 56px 0; }
    .stage-rail { position: static; grid-template-columns: auto 1fr auto; align-items: center; gap: 14px; }
    .stage-number { display: none; }
    .roadmap-items { grid-template-columns: 1fr; }
    .roadmap-card { min-height: 270px; padding: 24px; }
    .roadmap-card h4 { margin-top: 34px; }
    .roadmap-principles { padding: 68px 0; }
    .principles-grid { grid-template-columns: 1fr; }
    .principles-grid article,
    .principles-grid article + article,
    .principles-grid article:nth-child(3) { padding: 24px 0 30px; border-right: 0; border-bottom: 1px solid var(--line); }
    .principles-grid article:last-child { border-bottom: 0; }
    .principles-grid h3 { margin-top: 34px; }
    .roadmap-close { padding: 76px 0; }
  }

