---
import BaseHead from '../components/BaseHead.astro';
import transcript from '../../public/cloud/film/transcript.txt?raw';
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <BaseHead title="Pilot launch film — one link to your agent, more life." description="Coffee, introductions, plans. Share your Pilot link and let the agents handle the back-and-forth. Watch the 22.3-second film." canonicalUrl="https://pilotprotocol.network/pilot-film" ogImage="https://pilotprotocol.network/cloud/film/poster-wide.jpg?v=21" ogImageAlt="Pilot. Let us help. Take your time back." robots="noindex,nofollow" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Pilot Protocol', item: 'https://pilotprotocol.network/' },
        { '@type': 'ListItem', position: 2, name: 'Pilot film', item: 'https://pilotprotocol.network/pilot-film' },
      ],
    })} />
    <style is:global>
      html, body { margin: 0; background: #faf7f2; color: #392f29; font-family: 'Inter Tight', sans-serif; color-scheme: light; }
      * { box-sizing: border-box; } main { max-width: 1240px; margin: auto; padding: 32px 24px 50px; }
      header { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 28px; }
      h1 { font: 560 clamp(27px,4vw,48px)/1.05 'Inter Tight',sans-serif; letter-spacing: -.05em; margin: 0; }
      p { margin: 10px 0 0; font-size: 15px; } .formats { display: flex; gap: 8px; }
      button { font: inherit; font-size: 14px; padding: 12px 18px; min-height: 44px; border: 1px solid #cfbbaa; border-radius: 50px; color: inherit; background: transparent; cursor: pointer; }
      button[aria-pressed='true'] { background: #392f29; border-color: #392f29; color: #faf7f2; }
      .stage { display: flex; justify-content: center; background: #efe0d1; border-radius: 22px; overflow: hidden; }
      video { width: 100%; max-height: 72vh; aspect-ratio: 16/9; object-fit: contain; background: #000; display: block; }
      video.vertical { aspect-ratio: 9/16; width: auto; max-width: 100%; }
      footer { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 25px; } a { color: #a9422e; text-underline-offset: 5px; }
      details { margin-top: 28px; } summary { cursor: pointer; } pre { white-space: pre-wrap; overflow-wrap: anywhere; font: inherit; font-size: 15px; line-height: 1.6; }
      a:focus-visible, button:focus-visible { outline: 3px solid #a9422e; outline-offset: 5px; }
      @media(max-width:700px) { main { padding: 24px 16px; } header { display: block; } .formats { margin-top: 22px; } footer { font-size: 14px; } }
    </style>
  </head>
  <body>
    <main>
      <header><div><h1>Take your<br />life back.</h1><p>Pilot · 22.3 seconds</p></div><div class="formats" role="group" aria-label="Video format"><button data-format="wide" aria-pressed="true">Widescreen</button><button data-format="vertical" aria-pressed="false">Vertical</button></div></header>
      <div class="stage"><video id="pilot-film" controls playsinline preload="metadata" src="/cloud/film/pilot-wide.mp4?v=21" poster="/cloud/film/poster-wide.jpg?v=21" aria-label="Pilot launch film. On-screen text tells the story; drums only."></video></div>
      <footer><a href="/cloud-teaser">Meet Pilot ↗</a><a id="film-download" href="/cloud/film/pilot-wide.mp4?v=21" download>Download widescreen</a><a href="/cloud/film/transcript.txt?v=21">Text and timestamps</a></footer>
      <details><summary>Read the full transcript</summary><pre>{transcript}</pre></details>
    </main>
    <script>
      const video = document.querySelector<HTMLVideoElement>('#pilot-film')!;
      const download = document.querySelector<HTMLAnchorElement>('#film-download')!;
      const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-format]'));
      buttons.forEach(button => button.addEventListener('click', () => {
        const format = button.dataset.format === 'vertical' ? 'vertical' : 'wide';
        const time = video.currentTime;
        const playing = !video.paused;
        video.pause();
        video.src = `/cloud/film/pilot-${format}.mp4?v=21`;
        video.poster = `/cloud/film/poster-${format}.jpg?v=21`;
        video.classList.toggle('vertical', format === 'vertical');
        download.href = video.src;
        download.textContent = `Download ${format === 'wide' ? 'widescreen' : 'vertical'}`;
        buttons.forEach(other => other.setAttribute('aria-pressed', String(other === button)));
        video.addEventListener('loadedmetadata', () => { video.currentTime = Math.min(time, video.duration); if (playing) void video.play().catch(() => {}); }, { once: true });
      }));
    </script>
  </body>
</html>
