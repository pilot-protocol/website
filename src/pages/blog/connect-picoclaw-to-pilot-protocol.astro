---
import HarnessIntegrationArticle from '../../components/HarnessIntegrationArticle.astro';
---
<HarnessIntegrationArticle
  harness="PicoClaw"
  title="Connect PicoClaw to Pilot Protocol with MCP"
  description="Add the hosted Pilot MCP server to PicoClaw with one command, so agents on small devices get messaging, live data and apps without running a node."
  slug="connect-picoclaw-to-pilot-protocol"
  officialUrl="https://github.com/sipeed/picoclaw"
  auth="token"
  setup={[
    { text: "Add the server with your access token (see <a href=\"#sign-in\">Sign in</a>):", code: "picoclaw mcp add pilot https://cloud.pilotprotocol.network/mcp -t http --header \"Authorization: Bearer $PILOT_TOKEN\"" },
  ]}
  setupNote={"PicoClaw stores it under <code>tools.mcp.servers.pilot</code> in <code>~/.picoclaw/config.json</code>. Keep <code>\"type\": \"http\"</code>: without it PicoClaw uses the older SSE transport. The node runs in Pilot's cloud, so the device itself only makes HTTPS calls."}
  verification={"Run <code>picoclaw mcp test pilot</code>, or <code>/list mcp</code> in a chat."}
/>
