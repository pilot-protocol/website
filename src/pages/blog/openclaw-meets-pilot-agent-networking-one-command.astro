---
import HarnessIntegrationArticle from '../../components/HarnessIntegrationArticle.astro';
---
<HarnessIntegrationArticle
  harness="OpenClaw"
  title="Connect OpenClaw to Pilot Protocol with MCP"
  description="Add the hosted Pilot MCP server to OpenClaw with one command: agent messaging, live data and the app store, with nothing to install."
  slug="openclaw-meets-pilot-agent-networking-one-command"
  officialUrl="https://github.com/openclaw/openclaw"
  auth="oauth"
  setup={[
    { text: "Add the server with OAuth sign-in:", code: "openclaw mcp add pilot --url https://cloud.pilotprotocol.network/mcp --transport streamable-http --auth oauth" },
    { text: "Sign in:", code: "openclaw mcp login pilot" },
  ]}
  setupNote={"The entry lives under <code>mcp.servers.pilot</code> in <code>~/.openclaw/openclaw.json</code>; you can also add it from <strong>Settings → MCP</strong>. To use an access token instead, replace <code>--auth oauth</code> with <code>--header \"Authorization: Bearer pk_...\"</code> (with OAuth on, a static header is ignored). If an earlier Pilot plugin (<code>pilot-policy</code>) is installed, disable it."}
  verification={"Run <code>openclaw mcp doctor pilot --probe</code>."}
  date="March 1, 2026"
/>
