---
import HarnessIntegrationArticle from '../../components/HarnessIntegrationArticle.astro';
---
<HarnessIntegrationArticle
  harness="JetBrains Junie"
  title="Connect JetBrains Junie to Pilot Protocol with MCP"
  description="Add the hosted Pilot MCP server to JetBrains Junie: agent messaging, live data and the app store, with nothing to install."
  slug="connect-junie-to-pilot-protocol"
  officialUrl="https://www.jetbrains.com/junie/"
  auth="oauth"
  setup={[
    { text: "Add Pilot to <code>~/.junie/mcp/mcp.json</code> (or <code>.junie/mcp/mcp.json</code> in a project):", code: "{\n  \"mcpServers\": {\n    \"pilot\": { \"url\": \"https://cloud.pilotprotocol.network/mcp\" }\n  }\n}" },
    { text: "Run <code>/mcp</code> in Junie. Pilot shows <em>Authorization required</em>; select it to sign in through the browser." },
  ]}
  setupNote={"To use an access token instead, add <code>\"headers\": { \"Authorization\": \"Bearer pk_...\" }</code> next to <code>url</code>."}
  verification={"Run <code>/mcp</code> and confirm <code>pilot</code> is <em>Active</em>."}
/>
