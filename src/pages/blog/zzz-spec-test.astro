---
import BlogLayout from '../../layouts/BlogLayout.astro';

const bodyContent = `<p>Body v2 edited.</p>`;

const faqItems = [
  {
    question: "FAQ generated?",
    answer: "Yes.",
  },
];
---
<BlogLayout
