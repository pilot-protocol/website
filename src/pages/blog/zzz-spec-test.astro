  description="Up-to-spec verification of FAQ, crosspost, optimistic locking behaviors end to end."
  date="July 7, 2026"
  tags={["test"]}
  canonicalPath="/blog/zzz-spec-test"
  bannerImage="/blog/banners/zzz-spec-test.webp"
  faqItems={faqItems}
>
  <Fragment set:html={bodyContent} />
</BlogLayout>
