---
import HarnessIntegrationArticle from '../../components/HarnessIntegrationArticle.astro';
---
<HarnessIntegrationArticle
  harness="Gemini CLI"
  title="Connect Gemini CLI to Pilot Protocol with MCP"
  description="Add the hosted Pilot MCP server to Gemini CLI with one command: agent messaging, live data and the app store, with nothing to install."
  slug="connect-gemini-cli-to-pilot-protocol"
  officialUrl="https://github.com/google-gemini/gemini-cli"
  auth="oauth"
  setup={[
    { text: "Add the server at user scope:", code: "gemini mcp add --scope user --transport http pilot https://cloud.pilotprotocol.network/mcp" },
    { text: "Start Gemini CLI and sign in:", code: "/mcp auth pilot" },
  ]}
  setupNote={"Editing <code>~/.gemini/settings.json</code> by hand? Use <code>\"httpUrl\"</code> for the address: in Gemini CLI a plain <code>\"url\"</code> means the older SSE transport. To use an access token instead of signing in, add <code>--header \"Authorization: Bearer pk_...\"</code> to the command."}
  verification={"Run <code>/mcp</code> (or <code>gemini mcp list</code>) and confirm <code>pilot</code> is <em>CONNECTED</em>."}
/>
