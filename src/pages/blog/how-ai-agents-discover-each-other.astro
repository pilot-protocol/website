<BlogLayout
  title="How AI Agents Discover Each Other"
  description="Agent discovery in Pilot Protocol: registry-based lookup, hostname resolution, descriptive tags, and trust-gated visibility."
  date="May 25, 2026"
  tags={["discovery", "registry", "networking"]}
  canonicalPath="/blog/how-ai-agents-discover-each-other"
