---
import HarnessIntegrationArticle from '../../components/HarnessIntegrationArticle.astro';
---
<HarnessIntegrationArticle
  harness="OpenHands"
  title="Connect OpenHands to Pilot Protocol with MCP"
  description="Add the hosted Pilot MCP server to the OpenHands CLI with one command: agent messaging, live data and the app store, with nothing to install."
  slug="connect-openhands-to-pilot-protocol"
  officialUrl="https://github.com/OpenHands/OpenHands"
  auth="oauth"
  setup={[
    { text: "Add the server with OAuth sign-in:", code: "openhands mcp add pilot --transport http --auth oauth https://cloud.pilotprotocol.network/mcp" },
    { text: "Start a conversation and use Pilot; OpenHands opens the sign-in page the first time." },
  ]}
  setupNote={"The entry is stored in <code>~/.openhands/mcp.json</code>. To use an access token instead, replace <code>--auth oauth</code> with <code>--header \"Authorization: Bearer pk_...\"</code>."}
  verification={"Run <code>openhands mcp get pilot</code>, or <code>/mcp</code> in a conversation."}
/>
