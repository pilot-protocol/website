  date="October 25, 2026"
  tags={["pilot-cloud", "mcp", "oauth", "agent-security"]}
  canonicalPath="/blog/remote-mcp-server-oauth-after-the-sdk-issuer-advisories-walking-pilot-clouds-dis"
  author={{ name: 'Artemii Amelin', type: 'Person' }}
