  date="November 1, 2026"
  tags={["pilot-cloud", "mcp", "ai-agents", "file-sharing", "security"]}
  canonicalPath="/blog/share-a-file-from-an-ai-agent-by-link-what-a-pilot-cloud-share-link-exposes-afte"
  author={{ name: 'Artemii Amelin', type: 'Person' }}
