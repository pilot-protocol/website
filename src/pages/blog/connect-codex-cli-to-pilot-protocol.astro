---
import HarnessIntegrationArticle from '../../components/HarnessIntegrationArticle.astro';
---
<HarnessIntegrationArticle
  harness="Codex CLI"
  title="Connect Codex CLI to Pilot Protocol with MCP"
  description="Add the hosted Pilot MCP server to Codex CLI with two commands: agent messaging, live data and the app store, with nothing to install."
  slug="connect-codex-cli-to-pilot-protocol"
  officialUrl="https://github.com/openai/codex"
  auth="oauth"
  setup={[
    { text: "Add the server:", code: "codex mcp add pilot --url https://cloud.pilotprotocol.network/mcp" },
    { text: "Sign in:", code: "codex mcp login pilot" },
  ]}
  setupNote={"This writes <code>[mcp_servers.pilot]</code> with <code>url = \"https://cloud.pilotprotocol.network/mcp\"</code> to <code>~/.codex/config.toml</code>. To use an access token instead of signing in, add <code>bearer_token_env_var = \"PILOT_TOKEN\"</code> to that table and export <code>PILOT_TOKEN</code>."}
  verification={"Run <code>codex mcp list</code>, or <code>/mcp</code> inside Codex, and confirm <code>pilot</code> is listed with its tools."}
/>
