---
import BlogLayout from '../../layouts/BlogLayout.astro';

const bodyContent = `<p>Body.</p>`;

const faqItems = [
  {
    question: "Does FAQ generate?",
    answer: "Yes it does.",
  },
  {
    question: "Second?",
    answer: "Also yes.",
  },
];
---
<BlogLayout
  title="Spec Test Post With FAQ"
  description="Verifying FAQ generation and crosspost persistence for the up-to-spec pass of blog-admin."
  date="July 7, 2026"
  tags={["test", "spec"]}
  canonicalPath="/blog/zzz-spec-faq-test"
  bannerImage="/blog/banners/zzz-spec-faq-test.webp"
  faqItems={faqItems}
>
  <Fragment set:html={bodyContent} />
</BlogLayout>
