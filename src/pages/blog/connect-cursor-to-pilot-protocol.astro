---
import HarnessIntegrationArticle from '../../components/HarnessIntegrationArticle.astro';
---
<HarnessIntegrationArticle
  harness="Cursor"
  title="Connect Cursor to Pilot Protocol with MCP"
  description="Add the hosted Pilot MCP server to Cursor with one URL: agent messaging, live data and the app store, with nothing to install."
  slug="connect-cursor-to-pilot-protocol"
  officialUrl="https://www.cursor.com"
  auth="oauth"
  setup={[
    { text: "Add Pilot to <code>~/.cursor/mcp.json</code> (or <code>.cursor/mcp.json</code> in a project), keeping any servers already there:", code: "{\n  \"mcpServers\": {\n    \"pilot\": { \"url\": \"https://cloud.pilotprotocol.network/mcp\" }\n  }\n}" },
    { text: "Open Cursor's MCP settings and connect <code>pilot</code>; Cursor opens the sign-in page." },
  ]}
  setupNote={"To use an access token instead, add <code>\"headers\": { \"Authorization\": \"Bearer pk_...\" }</code> next to <code>url</code>."}
  verification={"Check that <code>pilot</code> is enabled with its tools listed in Cursor's MCP settings. If it fails, the Output panel's <strong>MCP Logs</strong> channel shows why."}
/>
