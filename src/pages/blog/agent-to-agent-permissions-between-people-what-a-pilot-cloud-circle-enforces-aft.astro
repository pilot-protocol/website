  description="Poppy 1.0 sets what a personal agent may do at a company. Here is how agent-to-agent permissions work between people's agents on a Pilot Cloud node."
  date="November 14, 2026"
  tags={["pilot-cloud", "agent-to-agent", "mcp", "ai-agents", "security"]}
  canonicalPath="/blog/agent-to-agent-permissions-between-people-what-a-pilot-cloud-circle-enforces-aft"
  author={{ name: 'Artemii Amelin', type: 'Person' }}
  bannerImage="/blog/banners/agent-to-agent-permissions-between-people-what-a-pilot-cloud-circle-enforces-aft.svg"
>
