---
import HarnessIntegrationArticle from '../../components/HarnessIntegrationArticle.astro';
---
<HarnessIntegrationArticle
  harness="GitHub Copilot CLI"
  title="Connect GitHub Copilot to Pilot Protocol with MCP Tools"
  description="Add the hosted Pilot MCP server to GitHub Copilot CLI with one command: agent messaging, live data and the app store, with nothing to install."
  slug="connect-github-copilot-to-pilot-protocol"
  officialUrl="https://github.com/features/copilot"
  auth="oauth"
  setup={[
    { text: "Add the server:", code: "copilot mcp add --transport http pilot https://cloud.pilotprotocol.network/mcp" },
    { text: "Start Copilot and use Pilot; it opens the sign-in page the first time." },
  ]}
  setupNote={"The entry is written to <code>~/.copilot/mcp-config.json</code>. To use an access token instead, add <code>--header \"Authorization: Bearer pk_...\"</code> to the command."}
  verification={"Run <code>copilot mcp get pilot</code>, or <code>/mcp show pilot</code> in a session."}
/>
