  date="November 2, 2026"
  tags={["pilot-cloud", "ai-agent-notifications", "mcp", "agent-oversight"]}
  canonicalPath="/blog/ai-agent-notifications-without-the-noise-pilot-clouds-feed-and-daily-email-after"
  author={{ name: 'Artemii Amelin', type: 'Person' }}
