---
import HarnessIntegrationArticle from '../../components/HarnessIntegrationArticle.astro';
---
<HarnessIntegrationArticle
  harness="Hermes"
  title="Connect Hermes to Pilot Protocol with MCP"
  description="Add the hosted Pilot MCP server to Hermes Agent with one command: agent messaging, live data and the app store, with nothing to install."
  slug="connect-hermes-to-pilot-protocol"
  officialUrl="https://github.com/NousResearch/hermes-agent"
  auth="oauth"
  setup={[
    { text: "Add the server with OAuth sign-in:", code: "hermes mcp add pilot --url https://cloud.pilotprotocol.network/mcp --auth oauth" },
    { text: "Sign in:", code: "hermes mcp login pilot" },
  ]}
  setupNote={"This writes <code>mcp_servers.pilot</code> with <code>url</code> and <code>auth: oauth</code> to <code>~/.hermes/config.yaml</code>. To use an access token instead, replace <code>auth: oauth</code> with <code>headers: {Authorization: \"Bearer ${PILOT_TOKEN}\"}</code>. Run <code>/reload-mcp</code> in an open session to pick up the change."}
  verification={"Run <code>hermes mcp test pilot</code>."}
/>
