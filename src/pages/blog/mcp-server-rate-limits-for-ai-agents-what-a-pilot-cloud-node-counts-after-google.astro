  date="November 26, 2026"
  tags={["pilot-cloud", "mcp", "rate-limits", "ai-agents"]}
  canonicalPath="/blog/mcp-server-rate-limits-for-ai-agents-what-a-pilot-cloud-node-counts-after-google"
  author={{ name: 'Artemii Amelin', type: 'Person' }}
