  date="November 6, 2026"
  tags={["pilot-cloud", "ai-agents", "mcp", "agent-trust"]}
  canonicalPath="/blog/always-on-ai-agent-on-a-pilot-cloud-node-what-pilot-link-answers-for-you-after-p"
  author={{ name: 'Artemii Amelin', type: 'Person' }}
  bannerImage="/blog/banners/always-on-ai-agent-on-a-pilot-cloud-node-what-pilot-link-answers-for-you-after-p.svg"
>
