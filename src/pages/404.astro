---
import MarketingLayout from '../layouts/MarketingLayout.astro';
---
<MarketingLayout title="Page Not Found - Pilot Protocol" description="The page you're looking for doesn't exist or has been moved.">
  <section class="page-head nf-head">
    <div class="wrap nf-wrap">
      <div class="eyebrow">Error · 404</div>

      <div class="nf-mark" aria-hidden="true">
        <img src="/img/sad-doodle.png" alt="" class="nf-dog" width="1306" height="1071" />
      </div>

      <h1><em>Page not found.</em></h1>
      <p class="lede">
        The page you're looking for doesn't exist or has been moved.
        Try one of the entry points below - or head back to the <a href="/">home page</a>.
      </p>

      <div class="nf-cta">
        <a href="/" class="btn primary">Home <span class="arr">→</span></a>
        <a href="/docs/" class="btn">Docs</a>
        <a href="/blog/" class="btn">Blog</a>
        <a href="/plans" class="btn">Plans</a>
      </div>
    </div>
  </section>

  <style>
    .nf-head { padding-top: 64px; padding-bottom: 96px; }
    .nf-wrap {
      max-width: 680px;
      margin: 0 auto;
      text-align: center;
    }
    .nf-wrap .eyebrow { display: inline-block; }
    .nf-wrap .eyebrow::before { display: none; }

    .nf-mark {
      display: flex;
      justify-content: center;
      margin: 32px 0 48px;
    }
    .nf-dog {
      width: clamp(220px, 30vw, 360px);
      height: auto;
      display: block;
      margin: 0 auto;
      opacity: 0.9;
    }
    /* White strokes on transparent bg: invert for light theme. */
    :root[data-theme="light"] .nf-dog { filter: invert(1); }

    .nf-head h1 { margin-left: auto; margin-right: auto; max-width: none; }
    .nf-head .lede { margin-left: auto; margin-right: auto; }

    .nf-cta {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      justify-content: center;
      margin: 32px 0 0;
    }
  </style>
</MarketingLayout>
