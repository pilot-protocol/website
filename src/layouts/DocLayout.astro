---
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DocSidebar from '../components/DocSidebar.astro';
import DocsFooter from '../components/DocsFooter.astro';
import PageNav from '../components/PageNav.astro';
import '../styles/global.css';
import '../styles/system.css';
import '../styles/docs.css';

interface Props {
  title: string;
  description: string;
  activePage: string;
  canonicalPath?: string;
  ogImage?: string;
  prev?: { label: string; href: string };
  next?: { label: string; href: string };
  hidePageNav?: boolean;
}

const { title, description, activePage, canonicalPath, ogImage = 'https://pilotprotocol.network/og/docs.jpg', prev, next, hidePageNav } = Astro.props;
const canonicalUrl = canonicalPath ? `https://pilotprotocol.network${canonicalPath}` : undefined;

const breadcrumbItems = [
  { name: 'Home', href: '/' },
  { name: 'Documentation', href: '/docs/' },
];
if (activePage !== 'index') {
  breadcrumbItems.push({ name: title });
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <BaseHead title={title} description={description} canonicalUrl={canonicalUrl} ogImage={ogImage} />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": title,
    "description": description,
    "url": canonicalUrl,
    "isPartOf": { "@type": "WebSite", "name": "Pilot Protocol", "url": "https://pilotprotocol.network/" },
    "author": { "@id": "https://pilotprotocol.network/#organization" },
    "publisher": { "@id": "https://pilotprotocol.network/#organization" }
  })}></script>
</head>
<body>
  <Nav active="docs" breadcrumbs={false} />
  <button class="docs-menu-toggle" id="docs-menu-toggle" type="button" aria-controls="docs-sidebar" aria-expanded="false">
    <span aria-hidden="true">☰</span> Documentation
  </button>
  <DocSidebar activePage={activePage} />
  <button class="docs-sidebar-backdrop" id="docs-sidebar-backdrop" type="button" aria-label="Close documentation menu" hidden></button>
  <aside class="toc-sidebar" id="toc-sidebar"></aside>
  <main class="content">
    <div class="content-body">
      <Breadcrumbs compact items={breadcrumbItems} />
      {activePage !== 'index' && (
        <a class="back-overview" href="/docs/#flow">
          <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          Flow
        </a>
      )}
      <slot />
      {!hidePageNav && <PageNav prev={prev} next={next} />}
    </div>
  </main>
  <div class="doc-footer-wrap"><DocsFooter /></div>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-core.min.js" defer></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-python.min.js" defer></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-bash.min.js" defer></script>
  <script>
    (function() {
      const menuButton = document.getElementById('docs-menu-toggle');
      const menuClose = document.getElementById('docs-sidebar-close');
      const docsSidebar = document.getElementById('docs-sidebar');
      const menuBackdrop = document.getElementById('docs-sidebar-backdrop');
      const mobile = window.matchMedia('(max-width: 768px)');

      function setDocsMenu(open: boolean, returnFocus = false) {
        if (!menuButton || !docsSidebar || !menuBackdrop) return;
        const shouldOpen = mobile.matches && open;
        docsSidebar.classList.toggle('open', shouldOpen);
        menuButton.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');
        document.body.classList.toggle('docs-sidebar-open', shouldOpen);
        menuBackdrop.hidden = !shouldOpen;
        if (mobile.matches) {
          docsSidebar.toggleAttribute('inert', !shouldOpen);
          docsSidebar.setAttribute('aria-hidden', shouldOpen ? 'false' : 'true');
          if (shouldOpen) {
            docsSidebar.setAttribute('role', 'dialog');
            docsSidebar.setAttribute('aria-modal', 'true');
          } else {
            docsSidebar.removeAttribute('role');
            docsSidebar.removeAttribute('aria-modal');
          }
        } else {
          docsSidebar.removeAttribute('inert');
          docsSidebar.removeAttribute('aria-hidden');
          docsSidebar.removeAttribute('role');
          docsSidebar.removeAttribute('aria-modal');
        }
        if (shouldOpen) menuClose?.focus();
        else if (returnFocus) menuButton.focus();
      }

      menuButton?.addEventListener('click', () => setDocsMenu(menuButton.getAttribute('aria-expanded') !== 'true'));
      menuClose?.addEventListener('click', () => setDocsMenu(false, true));
      menuBackdrop?.addEventListener('click', () => setDocsMenu(false, true));
      docsSidebar?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setDocsMenu(false)));
      document.addEventListener('keydown', event => {
        const open = menuButton?.getAttribute('aria-expanded') === 'true';
        if (event.key === 'Escape' && open) setDocsMenu(false, true);
        if (event.key === 'Tab' && open && docsSidebar) {
          const items = Array.from(docsSidebar.querySelectorAll<HTMLElement>(
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
          )).filter(item => !item.hidden && item.getClientRects().length > 0);
          if (items.length === 0) {
            event.preventDefault();
            return;
          }
          const first = items[0];
          const last = items[items.length - 1];
          if (!docsSidebar.contains(document.activeElement)) {
            event.preventDefault();
            first.focus();
          } else if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        }
      });
      mobile.addEventListener('change', () => setDocsMenu(false));
      setDocsMenu(false);

      const sidebar = document.getElementById('toc-sidebar');
      if (!sidebar) return;
      const content = document.querySelector('.content');
      if (!content) return;
      const headings = Array.from(content.querySelectorAll('h2[id], h3[id]'));
      if (headings.length === 0) return;

      const title = document.createElement('div');
      title.className = 'toc-title';
      title.textContent = 'On this page';
      sidebar.appendChild(title);

      const links: HTMLAnchorElement[] = [];
      headings.forEach(h => {
        const a = document.createElement('a');
        a.href = '#' + h.id;
        a.textContent = h.textContent || '';
        if (h.tagName === 'H3') a.classList.add('toc-h3');
        sidebar.appendChild(a);
        links.push(a);
      });

      // Scroll spy
      const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            links.forEach(l => l.classList.remove('active'));
            const active = links.find(l => l.getAttribute('href') === '#' + entry.target.id);
            if (active) active.classList.add('active');
          }
        });
      }, { rootMargin: '-56px 0px -60% 0px', threshold: 0 });

      headings.forEach(h => observer.observe(h));
    })();
  </script>
</body>
</html>
