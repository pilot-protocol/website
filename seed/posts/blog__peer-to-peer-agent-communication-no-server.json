pan": 1, "backgroundColor": null, "children": [{"type": "paragraph", "children": [{"type": "text", "text": "TLS to server, server decrypts", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}], "direction": "ltr", "format": "", "indent": 0, "version": 1}, {"type": "tablecell", "headerState": 0, "colSpan": 1, "rowSpan": 1, "backgroundColor": null, "children": [{"type": "paragraph", "children": [{"type": "text", "text": "End-to-end, no decryption point", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}], "direction": "ltr", "format": "", "indent": 0, "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1}, {"type": "tablerow", "children": [{"type": "tablecell", "headerState": 0, "colSpan": 1, "rowSpan": 1, "backgroundColor": null, "children": [{"type": "paragraph", "children": [{"type": "text", "text": "Single point of failure", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}], "direction": "ltr", "format": "", "indent": 0, "version": 1}, {"type": "tablecell", "headerState": 0, "colSpan": 1, "rowSpan": 1, "backgroundColor": null, "children": [{"type": "paragraph", "children": [{"type": "text", "text": "Server down = all comms down", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}], "direction": "ltr", "format": "", "indent": 0, "version": 1}, {"type": "tablecell", "headerState": 0, "colSpan": 1, "rowSpan": 1, "backgroundColor": null, "children": [{"type": "paragraph", "children": [{"type": "text", "text": "No broker in the data path; new lookups and relayed paths depend on the registry and beacon", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}], "direction": "ltr", "format": "", "indent": 0, "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1}, {"type": "tablerow", "children": [{"type": "tablecell", "headerState": 0, "colSpan": 1, "rowSpan": 1, "backgroundColor": null, "children": [{"type": "paragraph", "children": [{"type": "text", "text": "Infrastructure", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}], "direction": "ltr", "format": "", "indent": 0, "version": 1}, {"type": "tablecell", "headerState": 0, "colSpan": 1, "rowSpan": 1, "backgroundColor": null, "children": [{"type": "paragraph", "children": [{"type": "text", "text": "Server to deploy, maintain, scale", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}], "direction": "ltr", "format": "", "indent": 0, "version": 1}, {"type": "tablecell", "headerState": 0, "colSpan": 1, "rowSpan": 1, "backgroundColor": null, "children": [{"type": "paragraph", "children": [{"type": "text", "text": "Daemon and CLI per agent, plus a shared registry and beacon (public or your own)", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}], "direction": "ltr", "format": "", "indent": 0, "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1}, {"type": "tablerow", "children": [{"type": "tablecell", "headerState": 0, "colSpan": 1, "rowSpan": 1, "backgroundColor": null, "children": [{"type": "paragraph", "children": [{"type": "text", "text": "NAT handling", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}], "direction": "ltr", "format": "", "indent": 0, "version": 1}, {"type": "tablecell", "headerState": 0, "colSpan": 1, "rowSpan": 1, "backgroundColor": null, "children": [{"type": "paragraph", "children": [{"type": "text", "text": "Server must have public IP", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}], "direction": "ltr", "format": "", "indent": 0, "version": 1}, {"type": "tablecell", "headerState": 0, "colSpan": 1, "rowSpan": 1, "backgroundColor": null, "children": [{"type": "paragraph", "children": [{"type": "text", "text": "Automatic traversal, no public IP needed", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}], "direction": "ltr", "format": "", "indent": 0, "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1}, {"type": "tablerow", "children": [{"type": "tablecell", "headerState": 0, "colSpan": 1, "rowSpan": 1, "backgroundColor": null, "children": [{"type": "paragraph", "children": [{"type": "text", "text": "Cost", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}], "direction": "ltr", "format": "", "indent": 0, "version": 1}, {"type": "tablecell", "headerState": 0, "colSpan": 1, "rowSpan": 1, "backgroundColor": null, "children": [{"type": "paragraph", "children": [{"type": "text", "text": "Dedicated broker hosting + egress", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}], "direction": "ltr", "format": "", "indent": 0, "version": 1}, {"type": "tablecell", "headerState": 0, "colSpan": 1, "rowSpan": 1, "backgroundColor": null, "children": [{"type": "paragraph", "children": [{"type": "text", "text": "No separate application broker to provision", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}], "direction": "ltr", "format": "", "indent": 0, "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1}, {"type": "tablerow", "children": [{"type": "tablecell", "headerState": 0, "colSpan": 1, "rowSpan": 1, "backgroundColor": null, "children": [{"type": "paragraph", "children": [{"type": "text", "text": "Setup time", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}], "direction": "ltr", "format": "", "indent": 0, "version": 1}, {"type": "tablecell", "headerState": 0, "colSpan": 1, "rowSpan": 1, "backgroundColor": null, "children": [{"type": "paragraph", "children": [{"type": "text", "text": "Broker config + credentials", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}], "direction": "ltr", "format": "", "indent": 0, "version": 1}, {"type": "tablecell", "headerState": 0, "colSpan": 1, "rowSpan": 1, "backgroundColor": null, "children": [{"type": "paragraph", "children": [{"type": "text", "text": "One-command client installation", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}], "direction": "ltr", "format": "", "indent": 0, "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1}, {"type": "heading", "children": [{"type": "text", "text": "When Direct P2P Makes Sense", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "tag": "h2"}, {"type": "paragraph", "children": [{"type": "text", "text": "Direct peer-to-peer is not always the answer. Here is when it shines:", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "list", "children": [{"type": "listitem", "children": [{"type": "text", "text": "Sensitive data:", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": "Medical records, financial models, proprietary research. No intermediary should see this data.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "value": 1}, {"type": "listitem", "children": [{"type": "text", "text": "Low latency:", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": "Real-time agent coordination where every millisecond counts. Trading, robotics, live monitoring.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "value": 2}, {"type": "listitem", "children": [{"type": "text", "text": "Cross-network:", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": "Agents on different clouds or behind different NATs can use the shared coordination layer without a common application broker.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "value": 3}, {"type": "listitem", "children": [{"type": "text", "text": "Lower operational overhead:", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": "You do not want to deploy and maintain a dedicated broker for every agent workflow.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "value": 4}, {"type": "listitem", "children": [{"type": "text", "text": "Autonomous agents:", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": "Agents that need to choose their own peers without platform-level access control.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "value": 5}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "listType": "bullet", "start": 1, "tag": "ul"}, {"type": "paragraph", "children": [{"type": "text", "text": "Hub-and-spoke still makes sense for broadcast patterns (one-to-many notifications), when you need message persistence (guaranteed delivery over days), or when all agents are in the same cloud VPC with millisecond latency requirements.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "heading", "children": [{"type": "text", "text": "Get Started", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "tag": "h2"}, {"type": "block", "version": 2, "format": "", "fields": {"id": "1dbfc3011fb7a59b02de2aba", "blockName": "", "blockType": "Code", "language": "bash", "code": "# Install\ncurl -fsSL https://pilotprotocol.network/install.sh | sh\n\n# Or with Python\npip install pilotprotocol"}}, {"type": "paragraph", "children": [{"type": "text", "text": "Install the client, start the daemon, and authorize the peers or networks that should connect.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "paragraph", "children": [{"type": "link", "children": [{"type": "text", "text": "Go direct - peer-to-peer for AI agents →", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 3, "fields": {"linkType": "custom", "url": "/for/p2p", "newTab": false}, "id": "2f761b08a7943c5b86ff6721"}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "paragraph", "children": [{"type": "text", "text": "About this article", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "paragraph", "children": [{"type": "text", "text": "Published by the Pilot Protocol team. Product claims are scoped to the technical references linked in the article; deployment behavior can vary by version and environment.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "paragraph", "children": [{"type": "link", "children": [{"type": "text", "text": "How we publish", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 3, "fields": {"linkType": "custom", "url": "/about#publishing", "newTab": false}, "id": "953a164a764d525b6f8dec83"}, {"type": "text", "text": " · ", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "link", "children": [{"type": "text", "text": "Suggest a correction", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 3, "fields": {"linkType": "custom", "url": "/contact?topic=correction", "newTab": false}, "id": "27adef2c051aef81548b76e2"}, {"type": "text", "text": " · ", "format": 0, "