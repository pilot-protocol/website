version": 1, "textFormat": 0, "textStyle": ""}], "direction": "ltr", "format": "", "indent": 0, "version": 1}, {"type": "tablecell", "headerState": 0, "colSpan": 1, "rowSpan": 1, "backgroundColor": null, "children": [{"type": "paragraph", "children": [{"type": "text", "text": "STUN + hole-punch + relay fallback", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}], "direction": "ltr", "format": "", "indent": 0, "version": 1}, {"type": "tablecell", "headerState": 0, "colSpan": 1, "rowSpan": 1, "backgroundColor": null, "children": [{"type": "paragraph", "children": [{"type": "text", "text": "Explicit per-peer mutual approval", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}], "direction": "ltr", "format": "", "indent": 0, "version": 1}, {"type": "tablecell", "headerState": 0, "colSpan": 1, "rowSpan": 1, "backgroundColor": null, "children": [{"type": "paragraph", "children": [{"type": "text", "text": "Network citizenship, tunnels, app store", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}], "direction": "ltr", "format": "", "indent": 0, "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1}, {"type": "horizontalrule", "version": 1}, {"type": "heading", "children": [{"type": "text", "text": "MCP — Model Context Protocol", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "tag": "h2"}, {"type": "paragraph", "children": [{"type": "text", "text": "MCP is an open protocol for connecting AI applications to tools and resources through a client-server interface. An MCP server can expose tools, resources, and prompts. Current standard transports include standard I/O and Streamable HTTP.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "paragraph", "children": [{"type": "text", "text": "MCP is excellent at what it targets: structured, schema-validated tool calls from a single model context. It is not a network protocol. It has no concept of agent addressing, NAT traversal, or agent-to-agent transport. Two MCP servers cannot discover or call each other natively.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "paragraph", "children": [{"type": "text", "text": "An MCP server can run over Pilot's encrypted tunnels, so MCP tools become reachable across NAT without any changes to your MCP logic (see ", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "link", "children": [{"type": "text", "text": "MCP + Pilot", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 3, "fields": {"linkType": "custom", "url": "/for/mcp", "newTab": false}, "id": "509153066b10d43b9b4b7408"}, {"type": "text", "text": "). For MCP clients that can't run the daemon, ", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "link", "children": [{"type": "text", "text": "Pilot Cloud", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 3, "fields": {"linkType": "custom", "url": "/docs/mcp", "newTab": false}, "id": "e0371f420a991cb2800ca988"}, {"type": "text", "text": " is a hosted, always-on Pilot node that clients such as Claude and ChatGPT use over MCP.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "heading", "children": [{"type": "text", "text": "A2A — Agent-to-Agent Protocol", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "tag": "h2"}, {"type": "paragraph", "children": [{"type": "text", "text": "A2A defines how agents communicate at the application layer. Agent Cards can describe capabilities, skills, supported interfaces, and security requirements. Clients then use a supported interface to exchange tasks and messages.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "paragraph", "children": [{"type": "text", "text": "A2A handles collaboration semantics such as task lifecycle and capability advertisement. Its interfaces still need a reachable route, which may be public ingress, a private network, a proxy, or an overlay. Pilot can supply a retained-identity address and encrypted route when the existing deployment does not already provide one.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "heading", "children": [{"type": "text", "text": "ACP — Agent Communication Protocol", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "tag": "h2"}, {"type": "paragraph", "children": [{"type": "text", "text": "ACP is a Linux Foundation / BeeAI open standard for REST-based agent interoperability. It supports multi-modal content types and both synchronous and asynchronous messaging patterns. ACP is designed to make agents from different frameworks interoperable over HTTP without imposing a specific runtime.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "paragraph", "children": [{"type": "text", "text": "ACP does not include an overlay network, address assignment, or NAT traversal. It assumes agents are reachable over standard HTTP infrastructure.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "heading", "children": [{"type": "text", "text": "ANP — Agent Network Protocol", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "tag": "h2"}, {"type": "paragraph", "children": [{"type": "text", "text": "ANP focuses on decentralized agent identity using DIDs (Decentralized Identifiers) as the anchor. It defines discovery and communication over HTTP transport, designed for scenarios where agents span organizations and cannot rely on a shared registry or trust authority.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "paragraph", "children": [{"type": "text", "text": "ANP is useful when cross-organizational identity and verifiable credentials are the primary concern. Like the other HTTP-based protocols, it assumes reachable endpoints and does not address NAT.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "heading", "children": [{"type": "text", "text": "Pilot Protocol — network citizenship for agents", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "tag": "h2"}, {"type": "paragraph", "children": [{"type": "text", "text": "Pilot Protocol operates at the network layer rather than the application layer. It gives every agent three things the HTTP-based protocols assume but do not provide: a permanent address, an encrypted tunnel, and a resolved trust relationship with each peer.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "paragraph", "children": [{"type": "text", "text": "Addressing.", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": " Each agent uses a 48-bit virtual address that can remain stable across restarts and IP changes when its cryptographic identity is retained.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "paragraph", "children": [{"type": "text", "text": "Transport.", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": " Connections use encrypted UDP tunnels with X25519 key exchange and AES-GCM encryption. Reliability is implemented in userspace over UDP, so the stack runs anywhere without kernel modules.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "paragraph", "children": [{"type": "text", "text": "NAT traversal.", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": " Pilot uses STUN for endpoint discovery, coordinated UDP hole-punching for direct-path attempts, and encrypted relay fallback when a direct connection is not available.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "paragraph", "children": [{"type": "text", "text": "Trust.", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": " Pilot uses an explicit per-peer mutual approval handshake. Joining the network does not grant access to any peer — each relationship must be approved by both sides. This is a deliberate difference from VPN models where membership implies connectivity.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "paragraph", "children": [{"type": "text", "text": "Discovery.", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": " Agents register with a rendezvous registry, and peers resolve addresses and hostnames through it. The trust decision stays with the two agents, not with a central broker.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "paragraph", "children": [{"type": "text", "text": "Pilot is written in Go and ships as static, CGO-free components, is open source under AGPL-3.0, and is available at ", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "link", "children": [{"type": "text", "text": "github.com/pilot-protocol", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 3, "fields": {"linkType": "custom", "url": "https://github.com/pilot-protocol", "newTab": true}, "id": "cd5b8f62bc82b9b360d21670"}, {"type": "text", "text": ". SDKs are available for Go, Python (", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": "pilotprotocol", "format": 16, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": " on PyPI), Node, and Swift. The public metric tracks cumulative registered addresses rather than unique active agents or customers.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "heading", "children": [{"type": "text", "text": "The Pilot app store: capabilities as IPC services", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "tag": "h3"}, {"type": "paragraph", "children": [{"type": "text", "text": "Pilot has an App Store of installable capability apps, made by their publishers. Each app runs locally as a typed IPC service — JSON in, JSON out — and is auto-spawned when installed. Apps in the store include AEGIS (prompt-injection firewall), cosift (grounded web search), sixtyfour (people & company intelligence), miren (PaaS deploys), otto (browser automation), plainweb (web page → Markdown), slipstream (Polymarket smart-money signals), smol (hardware-isolated microVMs), and wallet (on-overlay USDC payments).", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "paragraph", "children": [{"type": "text", "text": "The ", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": "discover → install → call", "format": 16, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": " loop takes three commands:", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "block", "version": 2, "format": "", "fields": {"id": "4a92b62950337d633ab68027", "blockName": "", "blockType": "Code", "language": "bash", "code": "# Discover available apps in the Pilot app store\npilotctl appstore catalogue\n\n# Install a capability app (example: plainweb, web page → Markdown)\npilotctl appstore install io.pilot.plainweb\n\n# Call the installed app via typed IPC (appstore call <id> <method> [json])\npilotctl appstore call io.pilot.plainweb plainweb.help '{}'"}}, {"type": "paragraph", "children": [{"type": "text", "text": "Each installed app becomes a local IPC endpoint your agent can call with a typed JSON request. No HTTP server, no port management, no dependency wrangling.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "horizontalrule", "version": 1}, {"type": "heading", "children": [{"type": "text", "text": "Which protocol should you use?", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "tag": "h2"}, {"type": "paragraph", "children": [{"type": "text", "text": "The protocols operate at different layers and are not mutually exclusive. A practical production stack often combines them:", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "list", "children": [{"type": "listitem", "children": [{"type": "text", "text": "Use MCP", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": "when your primary need is giving an LLM access to structured tools and resources. Pair with Pilot if those tools need to be reachable across NAT.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "value": 1}, {"type": "listitem", "children": [{"type": "text", "text": "Use A2A", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": "when agents need to delegate tasks to each other using a standardized capability advertisement format. Pair with Pilot for the transport layer when agents are not behind stable public endpoints.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "value": 2}, {"type": "listitem", "children": [{"type": "text", "text": "Use ACP", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": "when you need REST-based interop across agent frameworks with multi-modal content support.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "value": 3}, {"type": "listitem", "children": [{"type": "text", "text": "Use ANP", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": "when cross-organizational agent identity and DID-based verifiable credentials are the primary concern.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "value": 4}, {"type": "listitem", "children": [{"type": "text", "text": "Use Pilot Protocol", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": "when you need agents to maintain stable addresses, traverse NAT, and communicate over encrypted tunnels with explicit per-peer trust — regardless of which application-layer protocol sits on top. See", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "link", "children": [{"type": "text", "text": "how P2P agent discovery works", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 3, "fields": {"linkType": "custom", "url": "/blog/ai-agent-discovery-process-p2p-networks", "newTab": false}, "id": "b358918bc0866d5ac3b304db"}, {"type": "text", "text": "for a deeper look at the discovery and trust side.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "value": 5}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "listType": "bullet", "start": 1, "tag": "ul"}, {"type": "paragraph", "children": [{"type": "text", "text": "A practical cross-cloud deployment can run Pilot as the network layer with one or more application-layer protocols on top, while keeping application authorization and governance in the surrounding system.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "horizontalrule", "version": 1}, {"type": "heading", "children": [{"type": "text", "text": "Get started with Pilot Protocol", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "tag": "h2"}, {"type": "paragraph", "children": [{"type": "text", "text": "Install Pilot in one command and have your first agent connected in minutes:", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "block", "version": 2, "format": "", "fields": {"id": "cba0f4e5234ea38199e1c434", "blockName": "", "blockType": "Code", "language": "bash", "code": "curl -fsSL https://pilotprotocol.network/install.sh | sh"}}, {"type": "paragraph", "children": [{"type": "text", "text": "After installation, run ", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": "pilotctl appstore catalogue", "format": 16, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": " to see available capability apps, then ", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": "pilotctl appstore install <app>", "format": 16, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": " to add them to your agent. The ", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "link", "children": [{"type": "text", "text": "GitHub repository", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 3, "fields": {"linkType": "custom", "url": "https://github.com/pilot-protocol", "newTab": true}, "id": "f38207ef8c30668c5e0b899c"}, {"type": "text", "text": " has the full source, SDK documentation, and integration guides for MCP and A2A.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "paragraph", "children": [{"type": "text", "text": "About this article", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "paragraph", "children": [{"type": "text", "text": "Published by the Pilot Protocol team. Product claims are scoped to the technical references linked in the article; deployment behavior can vary by version and environment.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "paragraph", "children": [{"type": "link", "children": [{"type": "text", "text": "How we publish", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 3, "fields": {"linkType": "custom", "url": "/about#publishing", "newTab": false}, "id": "3813fb1bb7294622d28398b5"}, {"type": "text", "text": " · ", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "link", "children": [{"type": "text", "text": "Suggest a correction", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 3, "fields": {"linkType": "custom", "url": "/contact?topic=correction", "newTab": false}, "id": "208abaef4f22db514cf74a00"}, {"type": "text", "text": " · ", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "link", "children": [{"type": "text", "text": "Technical references", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 3, "fields": {"linkType": "custom", "url": "/docs/research", "newTab": false}, "id": "0fac9658bed6e881e4758bf8"}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}], "direction": "ltr", "format": "", "indent": 0, "version": 1}}}