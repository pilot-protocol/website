ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}], "direction": "ltr", "format": "", "indent": 0, "version": 1}, {"type": "tablecell", "headerState": 0, "colSpan": 1, "rowSpan": 1, "backgroundColor": null, "children": [{"type": "paragraph", "children": [{"type": "text", "text": "Registry and beacon coordination", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}], "direction": "ltr", "format": "", "indent": 0, "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1}, {"type": "tablerow", "children": [{"type": "tablecell", "headerState": 0, "colSpan": 1, "rowSpan": 1, "backgroundColor": null, "children": [{"type": "paragraph", "children": [{"type": "text", "text": "Client ecosystem", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}], "direction": "ltr", "format": "", "indent": 0, "version": 1}, {"type": "tablecell", "headerState": 0, "colSpan": 1, "rowSpan": 1, "backgroundColor": null, "children": [{"type": "paragraph", "children": [{"type": "text", "text": "Universal", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}], "direction": "ltr", "format": "", "indent": 0, "version": 1}, {"type": "tablecell", "headerState": 0, "colSpan": 1, "rowSpan": 1, "backgroundColor": null, "children": [{"type": "paragraph", "children": [{"type": "text", "text": "Mature, multi-language", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}], "direction": "ltr", "format": "", "indent": 0, "version": 1}, {"type": "tablecell", "headerState": 0, "colSpan": 1, "rowSpan": 1, "backgroundColor": null, "children": [{"type": "paragraph", "children": [{"type": "text", "text": "Mature, multi-language", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}], "direction": "ltr", "format": "", "indent": 0, "version": 1}, {"type": "tablecell", "headerState": 0, "colSpan": 1, "rowSpan": 1, "backgroundColor": null, "children": [{"type": "paragraph", "children": [{"type": "text", "text": "Daemon plus Go, Node.js, Python, and Swift integrations", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}], "direction": "ltr", "format": "", "indent": 0, "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1}, {"type": "paragraph", "children": [{"type": "text", "text": "The table is intentionally not a scorecard. Persistence is central to an event log but unnecessary for a live control channel. Likewise, traversal matters only when peers cannot already reach one another.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "heading", "children": [{"type": "text", "text": "Reachability Is a Topology Question", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "tag": "h2"}, {"type": "paragraph", "children": [{"type": "text", "text": "TCP and gRPC can operate across private or public networks as long as routing, firewall policy, and name resolution expose the intended service. A VPN, ingress proxy, private link, or service mesh can provide that reachability. None of those choices is inherently wrong; they simply become part of the operating model.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "paragraph", "children": [{"type": "text", "text": "NATS changes the topology. Clients make outbound connections to a reachable NATS deployment, and subjects decouple producers from individual consumer addresses. The server remains in the message path, which is useful when the broker's routing, queueing, or persistence behavior is the point.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "paragraph", "children": [{"type": "text", "text": "Pilot separates coordination from payload transport. The registry and beacon are still infrastructure: they support registration, discovery, traversal coordination, and relay fallback. Once a path is established, peers exchange encrypted payloads directly when network conditions allow. When they do not, relay fallback preserves reachability without exposing payload plaintext to the relay.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "paragraph", "children": [{"type": "text", "text": "For a closer look at the coordination and data paths, read ", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "link", "children": [{"type": "text", "text": "how Pilot Protocol works", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 3, "fields": {"linkType": "custom", "url": "/blog/how-pilot-protocol-works", "newTab": false}, "id": "9d1c0ecc74d29f26e9fa9643"}, {"type": "text", "text": ".", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "heading", "children": [{"type": "text", "text": "How to Compare Performance Honestly", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "tag": "h2"}, {"type": "paragraph", "children": [{"type": "text", "text": "There is no responsible universal latency or throughput ranking for these four tools. A useful benchmark must keep the workload and topology explicit:", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "list", "children": [{"type": "listitem", "children": [{"type": "text", "text": "Path:", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": "same host, same region, cross-region, direct peer path, or relay path.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "value": 1}, {"type": "listitem", "children": [{"type": "text", "text": "Connection lifecycle:", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": "cold setup, warm connection reuse, reconnect, and failover.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "value": 2}, {"type": "listitem", "children": [{"type": "text", "text": "Payload:", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": "size, frequency, concurrency, serialization, and compression.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "value": 3}, {"type": "listitem", "children": [{"type": "text", "text": "Delivery contract:", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": "fire-and-forget, request/reply, acknowledgement, persistence, or replay.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "value": 4}, {"type": "listitem", "children": [{"type": "text", "text": "Security:", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": "identical authentication and encryption requirements for every candidate.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "value": 5}, {"type": "listitem", "children": [{"type": "text", "text": "Runtime:", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": "client language, host size, kernel settings, and broker or relay configuration.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "value": 6}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "listType": "bullet", "start": 1, "tag": "ul"}, {"type": "paragraph", "children": [{"type": "text", "text": "For warm connections carrying typical agent messages, network round-trip time often dominates framing differences. Broker hops, relay paths, persistence, and cold handshakes can change that result. Benchmark the exact route and delivery guarantees you plan to operate, and publish the harness alongside any numbers you use to make a decision.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "heading", "children": [{"type": "text", "text": "Choose TCP for a Deliberately Small Abstraction", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "tag": "h2"}, {"type": "paragraph", "children": [{"type": "text", "text": "Raw TCP is appropriate when you control both endpoints, already have routing, and want to own the application protocol. It is a strong foundation for bulk transfer and purpose-built internal systems. Its simplicity is also its tradeoff: identity, framing, authentication, observability, and reconnection belong to your code or to another layer.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "block", "version": 2, "format": "", "fields": {"id": "9dd034370b700c04a8def4f7", "blockName": "", "blockType": "Code", "language": "bash", "code": "// TCP supplies the stream; your application supplies the contract.\nconn, err := net.Dial(\"tcp\", \"agent-b.internal:8080\")\n// Add framing, authentication, encryption, and retry policy."}}, {"type": "heading", "children": [{"type": "text", "text": "Choose gRPC for Typed Service Contracts", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "tag": "h2"}, {"type": "paragraph", "children": [{"type": "text", "text": "gRPC fits structured request/reply or streaming APIs where schema evolution and generated clients matter. It works especially well inside environments that already provide service discovery, routing, certificates, and observability. TLS is supported and commonly deployed, but the security policy is a deployment decision rather than a property of every gRPC connection.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "paragraph", "children": [{"type": "text", "text": "Use gRPC when the central question is, “What operations does this service expose?” Pair it with a reachability layer when clients and servers do not share a routable environment.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "heading", "children": [{"type": "text", "text": "Choose NATS for Brokered Messaging Semantics", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "tag": "h2"}, {"type": "paragraph", "children": [{"type": "text", "text": "NATS is a natural fit for subject-based publish/subscribe, queue groups, and request/reply through a shared messaging plane. JetStream is useful when consumers need persistence, replay, or stronger delivery controls. Operating a server or cluster is not incidental overhead; it is what makes those brokered capabilities possible.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "paragraph", "children": [{"type": "text", "text": "Use NATS when the central question is, “How should messages be routed, buffered, and consumed?” Read the ", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "link", "children": [{"type": "text", "text": "dedicated NATS and gRPC comparison", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 3, "fields": {"linkType": "custom", "url": "/learn/nats-vs-grpc-agent-messaging", "newTab": false}, "id": "ad70c02970787fd45933439e"}, {"type": "text", "text": " for a decision focused on those two application patterns.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "heading", "children": [{"type": "text", "text": "Choose Pilot for Agent Identity and Reachability", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "tag": "h2"}, {"type": "paragraph", "children": [{"type": "text", "text": "Pilot is designed for agents that move between networks or need to communicate without exposing a new public endpoint for every service. A retained cryptographic identity maps to a stable Pilot address, while the local daemon manages discovery, traversal, encrypted tunnels, and relay fallback.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "paragraph", "children": [{"type": "text", "text": "Pilot does not replace an RPC schema, durable log, business authorization model, or application-level governance. Those concerns remain explicit. Pilot supplies the network path and peer identity on which those controls can operate.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "paragraph", "children": [{"type": "text", "text": "The daemon can be used from Go, Node.js, Python, and Swift integrations, and the gateway can bridge existing TCP-speaking applications onto the overlay. See the ", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "link", "children": [{"type": "text", "text": "gateway documentation", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 3, "fields": {"linkType": "custom", "url": "/docs/gateway", "newTab": false}, "id": "f2c71b7eb3d2c146c1c4a777"}, {"type": "text", "text": " and ", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "link", "children": [{"type": "text", "text": "private agent network overview", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 3, "fields": {"linkType": "custom", "url": "/docs/networks", "newTab": false}, "id": "6f465c4416ded404209050f4"}, {"type": "text", "text": " for the two common adoption paths.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "heading", "children": [{"type": "text", "text": "The Most Useful Architectures Combine Layers", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "tag": "h2"}, {"type": "list", "children": [{"type": "listitem", "children": [{"type": "text", "text": "gRPC over an existing private network:", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": "use your current routing and let gRPC define the service contract.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "value": 1}, {"type": "listitem", "children": [{"type": "text", "text": "NATS for fleet events:", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": "use subjects, queue groups, and JetStream where centralized routing or replay is valuable.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "value": 2}, {"type": "listitem", "children": [{"type": "text", "text": "Pilot plus an existing TCP service:", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": "use the gateway or local integration to give an existing service an encrypted cross-network path.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "value": 3}, {"type": "listitem", "children": [{"type": "text", "text": "Pilot plus application authorization:", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": "use Pilot identity for the peer and keep role, spend, data, and action policies in the application or control plane.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "value": 4}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "listType": "bullet", "start": 1, "tag": "ul"}, {"type": "paragraph", "children": [{"type": "text", "text": "Decision rule:", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "text", "text": " choose the application protocol for message semantics, then choose the network layer for identity and reachability. A typed API, message broker, and agent overlay can be complementary rather than competing purchases.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "heading", "children": [{"type": "text", "text": "A Practical Selection Checklist", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "tag": "h2"}, {"type": "list", "children": [{"type": "listitem", "children": [{"type": "text", "text": "Do all intended endpoints already have a controlled, routable path?", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "value": 1}, {"type": "listitem", "children": [{"type": "text", "text": "Do you need typed RPC, brokered events, durable replay, or only a byte stream?", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "value": 2}, {"type": "listitem", "children": [{"type": "text", "text": "Must peers retain identity while IP addresses and networks change?", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "value": 3}, {"type": "listitem", "children": [{"type": "text", "text": "Where may payload plaintext appear, and who operates each intermediary?", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "value": 4}, {"type": "listitem", "children": [{"type": "text", "text": "Which controls belong at the network, application, and organizational layers?", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "value": 5}, {"type": "listitem", "children": [{"type": "text", "text": "What cold-path, warm-path, failure, and recovery cases will you benchmark?", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "value": 6}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "listType": "number", "start": 1, "tag": "ol"}, {"type": "paragraph", "children": [{"type": "text", "text": "Your answers usually identify a combination, not a single winner. That is the useful outcome: fewer hidden assumptions and a stack whose responsibilities are clear.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "heading", "children": [{"type": "text", "text": "Map Pilot to Your Existing Stack", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "tag": "h3"}, {"type": "paragraph", "children": [{"type": "text", "text": "Start with one service that is difficult to reach across environments. Keep its application protocol and test Pilot as the identity and connectivity layer.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "paragraph", "children": [{"type": "link", "children": [{"type": "text", "text": "Get started", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 3, "fields": {"linkType": "custom", "url": "/docs/getting-started", "newTab": false}, "id": "b2685602ff57462838923dce"}, {"type": "text", "text": "About this article", "format": 1, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "paragraph", "children": [{"type": "text", "text": "Published by the Pilot Protocol team. Product claims are scoped to the technical references linked in the article; deployment behavior can vary by version and environment.", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 1, "textFormat": 0, "textStyle": ""}, {"type": "paragraph", "children": [{"type": "link", "children": [{"type": "text", "text": "How we publish", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 3, "fields": {"linkType": "custom", "url": "/about#publishing", "newTab": false}, "id": "ec94c1fb5b0cff808e24a88c"}, {"type": "text", "text": " · ", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}, {"type": "link", "children": [{"type": "text", "text": "Suggest a correction", "format": 0, "detail": 0, "mode": "normal", "style": "", "version": 1}], "direction": "ltr", "format": "", "indent": 0, "version": 3, "fields": {"linkType": "custom", "url": "/contact?topic=correction", "newTab": false}, "id": "8d8b42b6dca6490905b2ac83"}, {"type": "t