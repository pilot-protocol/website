{
  "name": "pilot-protocol-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/sync-install.mjs && node scripts/generate-static-data.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "payload": "payload",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts && payload generate:types",
    "migrate": "payload migrate",
    "seed": "payload run scripts/seed.ts",
    "preview": "npm run prebuild && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:database": "CLOUDFLARE_ENV=remote NODE_ENV=production PAYLOAD_SECRET=ignore payload migrate",
    "deploy:app": "npm run prebuild && NEXT_DEPLOYMENT_ID=sky-$(date +%s) NEXT_PUBLIC_SITE_VARIANT=sky NEXT_PUBLIC_SERVER_URL=https://pilotprotocol.network opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy": "npm run deploy:database && npm run deploy:app",
    "deploy:green": "npm run prebuild && NEXT_DEPLOYMENT_ID=green-$(date +%s) opennextjs-cloudflare build && opennextjs-cloudflare deploy --env green",
    "seed:production": "CLOUDFLARE_ENV=remote NODE_ENV=production payload run scripts/seed.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@payloadcms/db-d1-sqlite": "^3.93.0",
    "@payloadcms/next": "^3.93.0",
    "@payloadcms/richtext-lexical": "^3.93.0",
    "@payloadcms/storage-r2": "^3.93.0",
    "@payloadcms/ui": "^3.93.0",
    "fumadocs-core": "^16.19.0",
    "fumadocs-mdx": "^15.6.0",
    "fumadocs-ui": "^16.19.0",
    "geist": "^1.9.2",
    "graphql": "^16.15.0",
    "motion": "^14.12.0",
    "next": "16.4.6",
    "payload": "^3.93.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "wrangler": "^4.160.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true,
    "fsevents@2.3.3": true
  },
  "type": "module",
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  }
}
